# git config --global user.name "dizzi1222"
# git config --global user.email "diegosamuel042@gmail.com"
[user]
	name = dizzi1222
	email = diegosamuel042@gmail.com

[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[pull]
	rebase = false

[credential "https://github.com"]
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[credential "https://gist.github.com"]

[core]
	editor = nvim
	filemode = true
	quotepath = false
	precomposeunicode = true
[i18n]
	commitencoding = utf-8
	logoutputencoding = utf-8

# Author: dhardi007 | Committer: dizzi1222
[alias]
    commitd = "!f() { GIT_AUTHOR_NAME=\"dhardi007\" GIT_AUTHOR_EMAIL=\"dhardi@cinnnatus.edu.do\" git commit \"$@\"; }; f"
