#!/bin/bash
# ══════════════════════════════════════════════════════════════════════════════
# BLUEPRINT UTILITY - Extracción de diseño web
# Estilo visual tipo omarchy - Neobrutalist con gum
# ══════════════════════════════════════════════════════════════════════════════

# Colores y formato
RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[96m'
GREEN='\033[92m'
YELLOW='\033[93m'
RED='\033[91m'
BLUE='\033[94m'
MAGENTA='\033[95m'

BLUEPRINTS_DIR="$HOME/blueprints"
RAW_DIR="$BLUEPRINTS_DIR/raw"
OUTPUT_DIR="$BLUEPRINTS_DIR/output"

mkdir -p "$RAW_DIR" "$OUTPUT_DIR"

check_deps() {
  for cmd in gum python3 curl; do
    if ! command -v "$cmd" &>/dev/null; then
      echo -e "${RED}${BOLD}❌ Error:${RESET} ${YELLOW}$cmd${RESET} no está instalado"
      return 1
    fi
  done
  python3 -c "import requests; from bs4 import BeautifulSoup" 2>/dev/null || pip install requests beautifulsoup4 --quiet
  python3 -c "from PIL import Image" 2>/dev/null || pip install Pillow --quiet
  return 0
}

# ─── Extraer por URL ────────────────────────────────────────────────────
extract_url() {
  clear
  echo -e "\n${CYAN}${BOLD}╔══════════════════════════════════════════════════════════╗${RESET}"
  echo -e "${CYAN}${BOLD}║        🌐 BLUEPRINT UTILITY - Extraer por URL            ║${RESET}"
  echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════════════════╝${RESET}\n"

  echo -e "${DIM}Extrae colores, estructura, tipografía y componentes de cualquier web${RESET}\n"

  if [ -t 0 ]; then
    APP_URL=$(gum input --prompt "🌐 URL: " --placeholder "https://airbnb.com, stripe.com, notion.so" --value "")
  else
    printf "🌐 URL: "
    read -r APP_URL
  fi
  [[ -z "$APP_URL" ]] && echo -e "${RED}URL requerida${RESET}" && return 1

  echo "$APP_URL" | grep -qE "^https?://" || APP_URL="https://$APP_URL"

  if [ -t 0 ]; then
    PROJECT_NAME=$(gum input --prompt "📁 Nombre proyecto: " --placeholder "airbnb-clone, landing-spotify" --value "")
  else
    printf "📁 Nombre proyecto: "
    read -r PROJECT_NAME
  fi
  [[ -z "$PROJECT_NAME" ]] && PROJECT_NAME=$(echo "$APP_URL" | sed 's/[^a-zA-Z0-9]/-/g' | cut -c4-28)

  PROJECT_DIR="$RAW_DIR/$PROJECT_NAME"
  mkdir -p "$PROJECT_DIR"

  echo -e "\n${YELLOW}🔄 Extrayendo información de:${RESET} ${BOLD}$APP_URL${RESET}"
  echo -e "${DIM}Guardando en: $PROJECT_DIR${RESET}\n"

  # ─── Extracción Python ──────────────────────────────────────────────
  python3 - "$APP_URL" "$PROJECT_DIR" "$PROJECT_NAME" <<'PYEOF'
import os
import sys
import json
import re
import colorsys
import requests
from bs4 import BeautifulSoup
from datetime import datetime
from urllib.parse import urljoin

url = sys.argv[1]
project_dir = sys.argv[2]
project_name = sys.argv[3]

headers = {
    'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
}

import urllib3
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

bp = {
    "meta": {"url": url, "extracted_at": datetime.now().isoformat(), "title": ""},
    "detection": {"category": "general", "mood": [], "tags": []},
    "colors": {"hex": [], "gradients": [], "css_vars": [], "glassmorphism": False},
    "structure": {"sections": [], "navigation": [], "hero": None},
    "components": {"buttons": [], "cards": [], "images": []},
    "typography": {"fonts": [], "weights": []},
    "effects": {"shadows": [], "animations": []}
}

print(f"📡 Conectando a {url}...")

try:
    try:
        r = requests.get(url, headers=headers, timeout=15, verify=True)
    except requests.exceptions.SSLError:
        r = requests.get(url, headers=headers, timeout=15, verify=False)
    r.raise_for_status()
    soup = BeautifulSoup(r.text, 'html.parser')
    text = r.text.lower()
    text_content = soup.get_text(separator=' ', strip=True).lower()

    bp["meta"]["title"] = soup.title.string.strip() if soup.title else "Sin título"

    # ─── Detectar categoría ──────────────────────────────────────────
    cats = {
        'airbnb': ['booking', 'reserve', 'stay', 'trip', 'rental'],
        'spotify': ['music', 'playlist', 'artist', 'podcast'],
        'netflix': ['streaming', 'series', 'movie'],
        'figma': ['design', 'prototype', 'collaborate'],
        'stripe': ['payment', 'checkout', 'billing'],
        'notion': ['workspace', 'notes', 'docs'],
        'apple': ['apple', 'iphone', 'macbook'],
        'saas': ['pricing', 'features', 'dashboard', 'enterprise'],
        'ecommerce': ['cart', 'checkout', 'product', 'shop'],
        'portfolio': ['portfolio', 'about', 'contact', 'projects'],
        'restaurant': ['menu', 'reservation', 'order'],
        'fitness': ['workout', 'gym', 'health'],
        'crypto': ['wallet', 'blockchain', 'defi', 'nft'],
        'travel': ['destination', 'travel', 'adventure'],
        'realestate': ['property', 'listing', 'buy', 'home']
    }

    for cat, keywords in cats.items():
        if any(kw in text_content[:5000] for kw in keywords):
            bp["detection"]["category"] = cat
            print(f"🏷️  Categoría: {cat}")
            break

    # ─── Detectar mood ───────────────────────────────────────────────
    moods = []
    if 'dark' in text[:3000] or 'dark-mode' in r.text: moods.append("dark")
    if 'minimal' in text[:3000] or 'minimalist' in text[:3000]: moods.append("minimal")
    if 'modern' in text[:3000]: moods.append("modern")
    if 'premium' in text[:3000] or 'luxury' in text[:3000]: moods.append("premium")
    if 'glass' in text[:3000] or 'backdrop-filter' in r.text:
        moods.append("glass")
        bp["colors"]["glassmorphism"] = True
    if 'gradient' in r.text: moods.append("gradient")
    if 'vibrant' in text[:3000]: moods.append("vibrant")

    bp["detection"]["mood"] = moods
    if moods:
        print(f"🎨 Mood: {', '.join(moods)}")

    # ─── Colores hex ────────────────────────────────────────────────
    hex_colors = re.findall(r'#(?:[0-9a-fA-F]{3}){1,2}(?:[0-9a-fA-F]{2})?', r.text)
    bp["colors"]["hex"] = list(set([c.lower() for c in hex_colors if len(c) in [4, 7, 9]]))[:40]
    print(f"🎨 {len(bp['colors']['hex'])} colores encontrados")

    # ─── Gradientes ─────────────────────────────────────────────────
    bp["colors"]["gradients"] = re.findall(r'(?:linear|radial|conic)-gradient\([^)]+\)', r.text)[:10]
    if bp["colors"]["gradients"]:
        print(f"🌈 {len(bp['colors']['gradients'])} gradientes")

    # ─── Variables CSS ──────────────────────────────────────────────
    vars_css = re.findall(r'--([\w-]+):\s*([^;]+);', r.text)
    bp["colors"]["css_vars"] = [{"name": v[0], "value": v[1].strip()[:50]} for v in vars_css[:15]]

    # ─── Tipografía ─────────────────────────────────────────────────
    fonts = re.findall(r'font-family:\s*([^;]+)', r.text)
    bp["typography"]["fonts"] = list(set([f.strip().strip("'\"") for f in fonts]))[:8]

    weights = re.findall(r'font-weight:\s*([^;]+)', r.text)
    bp["typography"]["weights"] = list(set([w.strip() for w in weights]))[:8]

    if bp["typography"]["fonts"]:
        print(f"🔤 Tipografía: {bp['typography']['fonts'][0][:30]}")

    # ─── Navegación ─────────────────────────────────────────────────
    for nav in soup.find_all('nav')[:2]:
        links = [a.get_text(strip=True)[:25] for a in nav.find_all('a')[:8] if a.get_text(strip=True)]
        if links:
            bp["structure"]["navigation"].append(links)

    # ─── Hero ───────────────────────────────────────────────────────
    hero_sel = ['section.hero', '.hero', '#hero', 'header.hero', '.banner']
    for sel in hero_sel:
        hero = soup.select_one(sel)
        if hero:
            hero_text = hero.get_text(separator=' ', strip=True)[:250]
            hero_style = hero.get('style', '')
            bp["structure"]["hero"] = {
                "text": hero_text,
                "has_bg": 'background' in hero_style or 'url(' in hero_style
            }
            print(f"🖼️  Hero detectado: {'con imagen' if bp['structure']['hero']['has_bg'] else 'sólido'}")
            break

    # ─── Secciones ──────────────────────────────────────────────────
    section_tags = soup.find_all(['section', 'div'],
        class_=re.compile(r'section|feature|container|wrapper|grid|content|hero|banner', re.I))[:15]

    for sec in section_tags:
        name = ' '.join(sec.get('class', [])[:2]) or sec.get('id', '') or 'section'
        bp["structure"]["sections"].append({
            "name": str(name)[:60],
            "elements": len(sec.find_all()),
            "has_grid": 'grid' in str(sec.get('class', [])).lower()
        })

    # ─── Botones ────────────────────────────────────────────────────
    buttons = soup.find_all(['button', 'a'],
        class_=re.compile(r'btn|button|cta|primary|action|signup|signin', re.I))[:15]

    for btn in buttons:
        text = btn.get_text(strip=True)[:40]
        href = btn.get('href', '')[:80] if btn.name == 'a' else None
        classes = btn.get('class', [])
        is_primary = any(c in str(classes) for c in ['primary', 'cta', 'btn-primary', 'signup', 'signin'])

        bp["components"]["buttons"].append({
            "text": text,
            "href": href,
            "primary": is_primary,
            "classes": classes[:4]
        })

    print(f"🔘 {len(bp['components']['buttons'])} botones/CTA")

    # ─── Cards ──────────────────────────────────────────────────────
    cards = soup.find_all(['div', 'article'],
        class_=re.compile(r'card|item|product|listing|feature|plan', re.I))[:12]

    for card in cards:
        text = card.get_text(separator=' ', strip=True)[:100]
        if text and len(text) > 10:
            bp["components"]["cards"].append(text)

    # ─── Imágenes ───────────────────────────────────────────────────
    for img in soup.find_all('img')[:20]:
        src = img.get('src') or img.get('data-src') or img.get('data-lazy-src', '')
        if src and not src.startswith('data:') and len(src) > 5:
            bp["components"]["images"].append({
                "src": urljoin(url, src)[:150],
                "alt": img.get('alt', '')[:50] or 'Sin descripción',
                "lazy": bool(img.get('loading') == 'lazy')
            })

    print(f"🖼️  {len(bp['components']['images'])} imágenes")

    # ─── Efectos ────────────────────────────────────────────────────
    bp["effects"]["shadows"] = re.findall(r'(?:box-shadow|drop-shadow)[^;]+', r.text)[:8]
    bp["effects"]["animations"] = re.findall(r'@keyframes\s+(\w+)', r.text)[:10]

    # ─── Tags ───────────────────────────────────────────────────────
    tags_map = ['gradient', 'animation', 'video', 'carousel', 'modal', 'tabs', 'accordion']
    for tag in tags_map:
        if tag in text:
            bp["detection"]["tags"].append(tag)

    # ─── Guardar ────────────────────────────────────────────────────
    with open(f'{project_dir}/blueprint.json', 'w', encoding='utf-8') as f:
        json.dump(bp, f, indent=2, ensure_ascii=False)

    if os.path.exists(f'{project_dir}/blueprint.json'):
        print(f"✅ Blueprint guardado ({os.path.getsize(f'{project_dir}/blueprint.json')} bytes)")
    else:
        print(f"❌ Error: No se pudo guardar blueprint.json")

except Exception as e:
    print(f"❌ Error: {e}")
    import traceback
    traceback.print_exc()
PYEOF

  # ─── Generar paleta ────────────────────────────────────────────────
  echo -e "\n${YELLOW}🎨 Generando paleta de colores...${RESET}"

  python3 - "$PROJECT_DIR" <<'PYEOF'
import sys
import json
import colorsys

project_dir = sys.argv[1]

try:
    with open(f'{project_dir}/blueprint.json') as f:
        bp = json.load(f)

    hex_colors = bp.get('colors', {}).get('hex', [])
    if not hex_colors:
        print("⚠️  Sin colores")
        exit(0)

    palette = []
    for hex_c in hex_colors:
        try:
            if len(hex_c) == 4:
                r = int(hex_c[1] * 2, 16)
                g = int(hex_c[2] * 2, 16)
                b = int(hex_c[3] * 2, 16)
            else:
                r = int(hex_c[1:3], 16)
                g = int(hex_c[3:5], 16)
                b = int(hex_c[5:7], 16)

            h, s, l = colorsys.rgb_to_hls(r/255, g/255, b/255)
            brightness = (0.299 * r + 0.587 * g + 0.114 * b) / 255

            # Clasificar
            if l > 0.95: ctype = "white"
            elif l < 0.05: ctype = "black"
            elif s < 0.1: ctype = "gray"
            elif h < 0.03 or h > 0.97: ctype = "red"
            elif h < 0.08: ctype = "orange"
            elif h < 0.17: ctype = "yellow"
            elif h < 0.36: ctype = "green"
            elif h < 0.52: ctype = "cyan"
            elif h < 0.67: ctype = "blue"
            elif h < 0.82: ctype = "purple"
            else: ctype = "pink"

            if s > 0.25 and 0.15 < l < 0.9:
                palette.append({
                    "hex": hex_c.upper(),
                    "rgb": [r, g, b],
                    "type": ctype,
                    "hsl": [round(h*360), round(s*100), round(l*100)],
                    "brightness": round(brightness, 2)
                })
        except: pass

    # Ordenar por saturación
    palette.sort(key=lambda x: x['hsl'][1], reverse=True)

    result = {
        "palette": palette[:16],
        "total_analyzed": len(hex_colors),
        "dominant": palette[0]['hex'] if palette else None
    }

    with open(f'{project_dir}/palette.json', 'w') as f:
        json.dump(result, f, indent=2)

    if os.path.exists(f'{project_dir}/palette.json'):
        print(f"✅ {len(result['palette'])} colores en paleta")
    else:
        print(f"❌ Error: No se pudo guardar palette.json")
    if result.get('dominant'):
        print(f"🎯 Color dominante: {result['dominant']}")

except Exception as e:
    print(f"❌ Error: {e}")
PYEOF

  # ─── Generar Markdown ──────────────────────────────────────────────
  echo -e "\n${YELLOW}📝 Generando reporte markdown...${RESET}"

  python3 - "$PROJECT_DIR" "$PROJECT_NAME" <<'PYEOF'
import sys
import json
from datetime import datetime

project_dir = sys.argv[1]
project_name = sys.argv[2]

with open(f'{project_dir}/blueprint.json') as f: bp = json.load(f)
with open(f'{project_dir}/palette.json') as f: pal = json.load(f)

cat = bp['detection']['category']
moods = ', '.join(bp['detection']['mood']) or 'general'
tags = bp['detection']['tags']

# Paleta
palette_md = ""
for i, c in enumerate(pal['palette'][:10], 1):
    palette_md += f"| {i} | `{c['hex']}` | {c['type']} | {c['hsl'][1]}% sat | {c['hsl'][2]}% light |\n"

# Nav
nav_md = ""
for nav in bp['structure']['navigation'][:2]:
    for item in nav[:8]:
        nav_md += f"- {item}\n"

# Botones
btns_md = ""
for btn in bp['components']['buttons'][:10]:
    icon = "🔴" if btn.get('primary') else "⚪"
    btns_md += f"{icon} **{btn['text'] or 'Sin texto'}**\n"

# Secciones
secs_md = ""
for sec in bp['structure']['sections'][:10]:
    grid = "📐" if sec.get('has_grid') else ""
    secs_md += f"- **{sec['name']}** {grid} ({sec['elements']} elems)\n"

# Gradientes
grad_md = ""
for g in bp['colors']['gradients'][:5]:
    grad_md += f"```css\n{g[:100]}\n```\n"

# Glass
glass_md = ""
if bp['colors'].get('glassmorphism'):
    glass_md = """
## 🪟 Glassmorphism Detectado

```css
.glass {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 16px;
}
```
"""

# Sombras
shadow_md = ""
for s in bp['effects']['shadows'][:3]:
    shadow_md += f"```css\n{s[:100]}\n```\n"

md = f"""# 🎨 Blueprint: {project_name}

> **URL:** {bp['meta']['url']}
> **Título:** {bp['meta']['title']}
> **Extraído:** {datetime.now().strftime('%Y-%m-%d %H:%M')}

---

## 🏷️ Clasificación

| Atributo | Valor |
|----------|-------|
| **Categoría** | `{cat}` |
| **Mood** | `{moods}` |
| **Tags** | {" ".join([f"`{t}`" for t in tags]) if tags else "`general`"} |

---

## 📊 Estadísticas

| Elemento | Cantidad |
|----------|----------|
| Colores únicos | {pal['total_analyzed']} |
| Colores saturados | {len(pal['palette'])} |
| Secciones | {len(bp['structure']['sections'])} |
| Botones/CTA | {len(bp['components']['buttons'])} |
| Cards | {len(bp['components']['cards'])} |
| Imágenes | {len(bp['components']['images'])} |

---

## 🎨 Paleta de Colores

| # | Hex | Tipo | Saturación | Luminosidad |
|---|-----|------|------------|-------------|
{palette_md}

### Variables CSS
"""
for var in bp['colors']['css_vars'][:8]:
    md += f"- `--{var['name']}`: `{var['value']}`\n"

md += f"""
### Gradientes
{grad_md if grad_md else "_Sin gradientes detectados_"}

---

## 🧭 Navegación
{nav_md if nav_md else "_No detectada_"}

---

## 📐 Secciones ({len(bp['structure']['sections'])})
{secs_md if secs_md else "_No detectadas_"}
"""

# Hero
hero = bp['structure']['hero']
if hero:
    md += f"""
## 🖼️ Hero Section

- **Texto:** {hero.get('text', 'N/A')[:200]}...
- **Background:** {'🖼️ Imagen' if hero.get('has_bg') else '🎨 Color sólido'}
"""

md += f"""
---

## 🔘 Botones/CTA ({len(bp['components']['buttons'])})
{btns_md if btns_md else "_No detectados_"}

---

## 🃏 Cards ({len(bp['components']['cards'])})
"""
for card in bp['components']['cards'][:8]:
    md += f"- {card[:80]}...\n"

md += f"""
---

## 🔤 Tipografía

### Familias
"""
for font in bp['typography']['fonts'][:6]:
    md += f"- `{font}`\n"

md += f"""
### Pesos
{', '.join([f"`{w}`" for w in bp['typography']['weights'][:6]])}

---

## ✨ Efectos

### Sombras
{shadow_md if shadow_md else "_No detectadas_"}
{glass_md}
---

## 🎬 Animaciones
"""
if bp['effects']['animations']:
    for anim in bp['effects']['animations'][:5]:
        md += f"- `@keyframes {anim}`\n"
else:
    md += "_No detectadas_\n"

md += f"""

---

## 📁 Archivos Generados

- `blueprint.json` - Datos completos en JSON
- `palette.json` - Paleta de colores
- `blueprint.md` - Este reporte

---

_Generado por Blueprint Utility 🏗️_
"""

with open(f'{project_dir}/blueprint.md', 'w', encoding='utf-8') as f:
    f.write(md)

print(f"✅ Reporte generado")
PYEOF

  # ─── Resumen final ────────────────────────────────────────────────
  clear
  echo -e "\n${GREEN}${BOLD}╔══════════════════════════════════════════════════════════╗${RESET}"
  echo -e "${GREEN}${BOLD}║        ✅ BLUEPRINT EXTRAÍDO EXITOSAMENTE                ║${RESET}"
  echo -e "${GREEN}${BOLD}╚══════════════════════════════════════════════════════════╝${RESET}\n"

  echo -e "${CYAN}📁 Ubicación:${RESET} ${BOLD}$PROJECT_DIR${RESET}\n"

  echo -e "${DIM}┌─────────────────────────────────────────────┐${RESET}"
  echo -e "${DIM}│ Archivos generados:                         │${RESET}"
  echo -e "${DIM}│  📄 blueprint.json                          │${RESET}"
  echo -e "${DIM}│  🎨 palette.json                           │${RESET}"
  echo -e "${DIM}│  📝 blueprint.md                            │${RESET}"
  echo -e "${DIM}└─────────────────────────────────────────────┘${RESET}\n"

  if [ -t 0 ]; then
    gum confirm "📖 ¿Ver reporte en pantalla?" && cat "$PROJECT_DIR/blueprint.md" | less
  fi
}

# ─── Ver blueprints guardados ─────────────────────────────────────────
view_blueprints() {
  clear
  echo -e "\n${MAGENTA}${BOLD}╔══════════════════════════════════════════════════════════╗${RESET}"
  echo -e "${MAGENTA}${BOLD}║        📋 BLUEPRINTS GUARDADOS                           ║${RESET}"
  echo -e "${MAGENTA}${BOLD}╚══════════════════════════════════════════════════════════╝${RESET}\n"

  local dirs=$(find "$RAW_DIR" -maxdepth 1 -type d 2>/dev/null | grep -v "^$RAW_DIR$" | sort -r)

  if [ -z "$dirs" ]; then
    echo -e "${YELLOW}⚠️  No hay blueprints guardados${RESET}\n"
    return 1
  fi

  local i=1
  local names=()
  for d in $dirs; do
    local name=$(basename "$d")
    local count=$(ls "$d" 2>/dev/null | wc -l)
    echo -e "${CYAN}$i)${RESET} ${BOLD}$name${RESET} ${DIM}($count archivos)${RESET}"
    names+=("$name")
    ((i++))
  done

  echo ""
  printf "Selecciona número: "
  read -r sel

  local idx=$((sel - 1))
  if [ "$sel" -ge 1 ] && [ "$idx" -lt "${#names[@]}" ]; then
    local path="$RAW_DIR/${names[$idx]}"
    if [ -f "$path/blueprint.md" ]; then
      cat "$path/blueprint.md" | less
    elif [ -f "$path/blueprint.json" ]; then
      cat "$path/blueprint.json" | python3 -m json.tool | less
    else
      ls -la "$path"
    fi
  fi
}

# ─── Analizar imágenes (archivo, carpeta o URL) ──────────────────────
analyze_images() {
  clear
  echo -e "\n${BLUE}${BOLD}╔══════════════════════════════════════════════════════════╗${RESET}"
  echo -e "${BLUE}${BOLD}║        🖼️  ANALIZAR IMÁGENES                             ║${RESET}"
  echo -e "${BLUE}${BOLD}╚══════════════════════════════════════════════════════════╝${RESET}\n"

  echo -e "${DIM}Acepta: archivo local, carpeta o URL de imagen${RESET}\n"

  printf "🖼️  Ruta/URL: "
  read -r input_path

  [[ -z "$input_path" ]] && echo -e "${RED}Entrada requerida${RESET}" && return 1

  printf "📁 Nombre proyecto: "
  read -r project_name
  [[ -z "$project_name" ]] && project_name="image-$(date +%Y%m%d-%H%M%S)"

  project_dir="$RAW_DIR/$project_name"
  mkdir -p "$project_dir"

  echo -e "\n${YELLOW}🔄 Analizando...${RESET}\n"

  python3 - "$input_path" "$project_dir" "$project_name" <<'PYEOF'
import os
import sys
import json
import colorsys
import requests
import urllib3
from PIL import Image
from io import BytesIO
from datetime import datetime

urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

input_path = sys.argv[1]
project_dir = sys.argv[2]
project_name = sys.argv[3]

headers = {
    'User-Agent': 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36'
}

images_data = []

def analyze_image(img_source, source_type):
    """Analiza una imagen y retorna sus colores."""
    try:
        img = Image.open(img_source).convert('RGB')
        width, height = img.size
        
        # Muestreo más fino
        img_small = img.resize((100, 100))
        colors = img_small.getcolors(10000)

        palette = []
        backgrounds = []
        
        if colors:
            colors.sort(reverse=True)
            for cnt, (r, g, b) in colors[:64]: # Revisar más colores
                h, s, l = colorsys.rgb_to_hls(r/255, g/255, b/255)
                hex_color = '#%02x%02x%02x' % (r, g, b)
                hex_color = hex_color.upper()
                
                # Clasificación inteligente
                ctype = "gray" if s < 0.15 else "red" if h < 0.08 else "orange" if h < 0.17 else "yellow" if h < 0.36 else "green" if h < 0.52 else "cyan" if h < 0.67 else "blue" if h < 0.82 else "purple" if h < 0.92 else "pink"
                
                color_obj = {
                    "hex": hex_color,
                    "rgb": [r, g, b],
                    "type": ctype,
                    "hsl": [round(h*360), round(s*100), round(l*100)],
                    "count": cnt,
                    "is_vibrant": s > 0.3 and 0.3 < l < 0.8
                }

                # Si es muy frecuente y baja saturación, es fondo/base
                if s < 0.2 or l < 0.15 or l > 0.85:
                    if len(backgrounds) < 5:
                        backgrounds.append(color_obj)
                else:
                    if len(palette) < 12:
                        palette.append(color_obj)

        # Unir y priorizar vibrantes
        final_palette = palette + backgrounds
        
        # Clasificación por colores (Heurística)
        dominant = final_palette[0] if final_palette else None
        is_dark = (dominant['hsl'][2] < 40) if dominant else True
        
        moods = []
        if is_dark: moods.append("dark")
        if any(c['is_vibrant'] for c in final_palette): moods.append("vibrant")
        if len(palette) < 5: moods.append("minimalist")
        
        # Intentar detectar Glassmorphism (Heurística: bordes claros en fondos oscuros)
        has_glass = False
        if is_dark and any(c['hsl'][2] > 80 and c['count'] < 50 for c in backgrounds):
            has_glass = True
            moods.append("glassmorphism")

        return {
            "source": source_type,
            "path": str(img_source) if source_type == "local" else input_path,
            "width": width,
            "height": height,
            "palette": final_palette,
            "dominant": dominant,
            "is_dark": is_dark,
            "moods": moods,
            "has_glass": has_glass,
            "category": "dashboard" if is_dark and len(palette) > 3 else "landing"
        }
    except Exception as e:
        return {"error": str(e), "source": source_type}

try:
    if input_path.startswith('http://') or input_path.startswith('https://'):
        print(f"🌐 Descargando imagen desde URL...")
        r = requests.get(input_path, headers=headers, timeout=30, verify=False)
        r.raise_for_status()
        img_data = analyze_image(BytesIO(r.content), "url")
        images_data.append(img_data)
        print(f"✅ Imagen descargada: {img_data.get('width', '?')}x{img_data.get('height', '?')}")
    elif os.path.isfile(input_path):
        if input_path.lower().endswith(('.png', '.jpg', '.jpeg', '.webp', '.gif', '.bmp')):
            print(f"📁 Analizando archivo local...")
            img_data = analyze_image(input_path, "local")
            images_data.append(img_data)
            print(f"✅ {img_data.get('width', '?')}x{img_data.get('height', '?')}")
        else:
            print(f"⚠️  No es imagen válida")
    elif os.path.isdir(input_path):
        print(f"📂 Buscando imágenes en carpeta...")
        files = []
        for ext in ('*.png', '*.jpg', '*.jpeg', '*.webp', '*.gif'):
            files.extend([f for f in input_path.split('\n')[0].strip() if False])
        files = []
        for root, dirs, filenames in os.walk(input_path):
            for fname in filenames:
                if fname.lower().endswith(('.png', '.jpg', '.jpeg', '.webp', '.gif', '.bmp')):
                    files.append(os.path.join(root, fname))
                    if len(files) >= 20:
                        break
            if len(files) >= 20:
                break
        
        if not files:
            print("⚠️  No se encontraron imágenes")
            sys.exit(1)
        
        print(f"📸 {len(files)} imágenes encontradas\n")
        for f in files:
            img_data = analyze_image(f, "local")
            if "error" not in img_data:
                images_data.append(img_data)
                palette_str = ' '.join([c['hex'] for c in img_data['palette'][:4]])
                print(f"  📷 {os.path.basename(f)[:35]}")
                print(f"     🎨 {palette_str}")
    else:
        print(f"❌ Ruta no encontrada: {input_path}")
        sys.exit(1)

    if images_data:
        total_colors = sum(len(img.get('palette', [])) for img in images_data)
        first_img = images_data[0]
        dominant_data = first_img.get('dominant') if first_img else None
        dominant_color = dominant_data.get('hex', '#000000') if dominant_data else '#000000'
        
        palette_md = ""
        unique_colors = []
        seen_hex = set()
        
        # Primero acentos, luego bases
        all_potential = []
        for img in images_data:
            all_potential.extend(img.get('palette', []))
            
        all_potential.sort(key=lambda x: (x['is_vibrant'], x['count']), reverse=True)
        
        for c in all_potential:
            if c['hex'] not in seen_hex:
                seen_hex.add(c['hex'])
                unique_colors.append(c)
                if len(unique_colors) >= 15: break

        for i, c in enumerate(unique_colors, 1):
            vibrant_tag = "🌟" if c.get('is_vibrant') else "🌑"
            palette_md += f"| {i} | `{c['hex']}` | {vibrant_tag} {c['type']} | {c['hsl'][1]}% | {c['hsl'][2]}% |\n"

        bp = {
            "meta": {
                "source": "image_analysis",
                "input": input_path,
                "extracted_at": datetime.now().isoformat(),
                "project_name": project_name,
                "theme": "dark" if images_data[0].get('is_dark') else "light"
            },
            "colors": {"hex": [c['hex'] for c in unique_colors], "dominant": dominant_color},
            "palette": unique_colors,
            "images": images_data
        }

        with open(f'{project_dir}/blueprint.json', 'w', encoding='utf-8') as f:
            json.dump(bp, f, indent=2, ensure_ascii=False)

        # Heurística de estructura y descripción
        main_img = images_data[0]
        category = main_img.get('category', 'web-design')
        moods_str = ', '.join(main_img.get('moods', []))
        
        md = f"""# 🎨 Blueprint: {project_name}

> **Tipo:** Análisis Visual de Imagen 📸
> **Mood:** `{moods_str}`
> **Estilo Predominante:** {"Dark Mode" if main_img.get('is_dark') else "Light Mode"}
> **Extraído:** {datetime.now().strftime('%Y-%m-%d %H:%M')}

---

## 🏷️ Clasificación Sugerida

| Atributo | Valor |
|----------|-------|
| **Categoría** | `{category}` |
| **UX Pattern** | {"Sidebar + Main Content" if category == "dashboard" else "Hero + Sections"} |
| **Glassmorphism** | {"Activado ✅" if main_img.get('has_glass') else "No detectado"} |

---

## 🎨 Paleta de Colores

| # | Hex | Tipo | Saturación | Luminosidad |
|---|-----|------|------------|-------------|
{palette_md}

---

## 🛠️ Esqueleto Técnico (Sugerido)

### Variables CSS
```css
:root {{
  --bg-primary: {unique_colors[-1]['hex'] if unique_colors else '#000000'};
  --accent-primary: {unique_colors[0]['hex'] if unique_colors else '#3b82f6'};
  --text-main: {unique_colors[-2]['hex'] if len(unique_colors) > 2 else '#ffffff'};
  --radius-main: 16px;
}}
```

### Estilo de Componentes
"""
        if main_img.get('has_glass'):
            md += """
#### 🪟 Efecto Glass (Detectado)
```css
.card-glass {
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-main);
}
```
"""
        if category == "dashboard":
            md += """
#### 📊 Layout Dashboard
- **Sidebar:** Ancho 260px, color base oscuro.
- **Cards:** Bordes suaves (12px-16px), sombras sutiles.
- **Inputs:** Estilo minimalista con bordes focus en color acento.
"""

        md += f"""
---

## 🎬 Animaciones Sugeridas
- `fade-in`: Para la carga de componentes.
- `scale-up`: Para hover en botones y cards.
- `pulse`: Para estados activos en indicadores.

---

## 🖼️ Imágenes Analizadas
"""
        for img in images_data:
            palette_str = ' '.join([c['hex'] for c in img.get('palette', [])[:5]])
            md += f"""
### {img.get('path', 'Unknown').split('/')[-1]}
- **Resolución:** {img.get('width', '?')}x{img.get('height', '?')}
- **Colores Clave:** {palette_str}
"""

        md += """
---
_Generado por Blueprint Utility 🏗️ (Modo Heurístico Visual)_
"""

        with open(f'{project_dir}/blueprint.md', 'w', encoding='utf-8') as f:
            f.write(md)

        print(f"\n✅ Análisis completo")
        print(f"   📁 {project_dir}")
        print(f"   🎨 {len(unique_colors)} colores extraídos")

except Exception as e:
    print(f"❌ Error: {e}")
    import traceback
    traceback.print_exc()
PYEOF
}

# ─── Gestionar blueprints con ncdu ─────────────────────────────────────
manage_blueprints() {
  clear
  echo -e "\n${YELLOW}${BOLD}╔══════════════════════════════════════════════════════════╗${RESET}"
  echo -e "${YELLOW}${BOLD}║        🗂️  GESTIONAR BLUEPRINTS                          ║${RESET}"
  echo -e "${YELLOW}${BOLD}╚══════════════════════════════════════════════════════════╝${RESET}\n"

  if ! command -v ncdu &>/dev/null; then
    echo -e "${RED}❌ ncdu no está instalado${RESET}"
    echo -e "${DIM}Instálalo con: sudo pacman -S ncdu${RESET}\n"
    return 1
  fi

  echo -e "${CYAN}Abriendo ncdu en $RAW_DIR${RESET}"
  echo -e "${DIM}q=salir | d=borrar | R=recargar${RESET}\n"

  ncdu "$RAW_DIR"
}

# ─── Menú principal ───────────────────────────────────────────────────
main_menu() {
  clear
  echo -e "\n${CYAN}${BOLD}╔══════════════════════════════════════════════════════════╗${RESET}"
  echo -e "${CYAN}${BOLD}║        🏗️  BLUEPRINT UTILITY                             ║${RESET}"
  echo -e "${CYAN}${BOLD}║        Extrae y documenta diseño de páginas web          ║${RESET}"
  echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════════════════╝${RESET}\n"

  echo -e "${DIM}─────────────────────────────────────────────────────────${RESET}"
  echo -e "${YELLOW}1)${RESET} 🌐 Extraer por URL      - Analiza una página web completa"
  echo -e "${YELLOW}2)${RESET} 🖼️ Analizar imágenes     - Archivo, carpeta o URL"
  echo -e "${YELLOW}3)${RESET} 📋 Ver blueprints        - Revisa extracciones anteriores"
  echo -e "${YELLOW}4)${RESET} 🗂️ Gestionar blueprints  - Borrar con ncdu"
  echo -e "${RED}0)${RESET} ❌ Salir"
  echo -e "${DIM}─────────────────────────────────────────────────────────${RESET}\n"
}

# ─── MAIN ─────────────────────────────────────────────────────────────
main() {
  check_deps || exit 1

  while true; do
    main_menu
    printf "Selecciona opción: "
    read -r opt
    echo ""

    case "$opt" in
    1) extract_url ;;
    2) analyze_images ;;
    3) view_blueprints ;;
    4) manage_blueprints ;;
    0 | *)
      echo -e "${GREEN}👋 ¡Hasta luego!${RESET}\n"
      exit 0
      ;;
    esac

    echo ""
    printf "Presiona Enter para continuar..."
    read -r
  done
}

main "$@"
