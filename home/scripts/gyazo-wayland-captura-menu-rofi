#!/bin/bash
# === Token de Gyazo ===
# NOTA: Los access tokens de Gyazo NO expiran por tiempo (doc oficial:
# "The expiration date of the access_token is not set"). Dejan de funcionar
# solo si se regeneran/revocan o se borra la app. Un 401 con header
# `WWW-Authenticate: ... error_description="The access token was revoked"`
# indica token revocado → regenerarlo en https://gyazo.com/oauth/applications
# → clic en el nombre de la app (ej. DIZZI) → botón Regenerate.
API_TOKEN="8tpTwzUTedImGHZCFAcatRcjGIzzdBTY-3UZ6Ur_yPM"

# === Ruta temporal para la imagen ===
IMG_PATH="/tmp/gyazo_$(date +%s).png"

# === Pre-validación / fallback de auth de Gyazo ===
gyazo_token_ok() {
  [ -n "$API_TOKEN" ] || return 1
  [ "$(curl -s -o /dev/null -m 5 -w "%{http_code}" \
    https://api.gyazo.com/api/users/me \
    -H "Authorization: Bearer $API_TOKEN" 2>/dev/null)" = "200" ]
}

gyazo_fallback_auth() {
  local desc
  desc=$(curl -s -D - -o /dev/null "https://api.gyazo.com/api/users/me" \
    -H "Authorization: Bearer $API_TOKEN" 2>/dev/null \
    | grep -i "www-authenticate" | grep -o 'error_description="[^"]*"' | cut -d'"' -f2)
  notify-send -i dialog-error "❌ Token Gyazo inválido" "Causa: ${desc:-no autorizado}. Abriendo panel..."
  xdg-open "https://gyazo.com/oauth/applications" &
  wl-copy --type image/png <"$IMG_PATH"
  notify-send -i camera-photo "📸 Captura guardada localmente" "$IMG_PATH"
}

# === Menu: Seleccionar modo con rofi ===
option=$(printf " Captura Ventana con Click\n  Ventana Activa (Auto)\n󰵝   Captura Completa Gyazo󰒊\n󰆟  Seleccionar Área\n󰒊 󰩫 Gyazo Share" | fuzzel --dmenu --prompt="Tipo de Captura:")

pkill -9 rofi
sleep 1

# === Detectar compositor (Hyprland vs niri) ===
comp="niri"
if command -v hyprctl >/dev/null 2>&1 && [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" ]; then
  comp="hypr"
fi

# === Captura de pantalla ===
if [[ "$option" == *"Click"* ]]; then
  if [ "$comp" = "hypr" ]; then
    hyprshot -m window --freeze
    sleep 0.5
    HYPR_IMG=$(ls -t "$HOME/Pictures"/*.png "$HOME/Imágenes/"/*.png 2>/dev/null | head -1)
    mv "$HYPR_IMG" "$IMG_PATH"
  else
    # niri: click sobre la ventana → pick-window da su id → screenshot-window nativo
    # (el compositor captura el buffer exacto, sin calcular coords → multi-monitor OK)
    WINDOW_ID="$(niri msg --json pick-window 2>/dev/null | jq -r '.id')" \
      || { notify-send "❌ Captura cancelada"; exit 1; }
    [ -n "$WINDOW_ID" ] && [ "$WINDOW_ID" != "null" ] \
      || { notify-send "❌ Captura cancelada"; exit 1; }
    niri msg action screenshot-window --id "$WINDOW_ID" \
      --show-pointer false --path "$IMG_PATH" >/dev/null 2>&1 \
      || { notify-send "❌ Captura cancelada"; exit 1; }
  fi

elif [[ "$option" == *"Auto"* ]]; then
  if [ "$comp" = "hypr" ]; then
    hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' | grim -g - "$IMG_PATH"
  else
    # niri: screenshot-window nativo usa la ventana enfocada (sin coord math)
    niri msg action screenshot-window \
      --show-pointer false --path "$IMG_PATH" >/dev/null 2>&1 \
      || { notify-send "❌ No se pudo capturar la ventana enfocada"; exit 1; }
  fi

elif [[ "$option" == *Completa* ]]; then
  grim "$IMG_PATH" || { notify-send "❌ Error al capturar"; exit 1; }

elif [[ "$option" == *Área* ]]; then
  grim -g "$(slurp)" "$IMG_PATH" || { notify-send "❌ Captura cancelada"; exit 1; }
  # Seleccionar Área = SOLO local (clipboard + Desktop), sin subir a Gyazo
  cp "$IMG_PATH" "$HOME/Escritorio/$(basename "$IMG_PATH")"
  wl-copy --type image/png <"$IMG_PATH"
  notify-send -i camera-photo "📸 Área copiada al portapapeles" "$IMG_PATH"
  exit 0

elif [[ "$option" == *Share* ]]; then
  # Gyazo Share delega TODO su flujo al script clip (captura, copia, upload, notify)
  sh -c "$HOME/scripts/gyazo-wayland-captura-clip"
  exit 0
else
  exit 1
fi

# === Guardar copia en Escritorio ===
cp "$IMG_PATH" "$HOME/Escritorio/$(basename "$IMG_PATH")"

# === Subir a Gyazo SOLO si hay red y el token es válido ===
if ping -c 1 -W 1 gyazo.com &>/dev/null; then
  if gyazo_token_ok; then
    # Retry de subida: HTTP 000 = fallo de conexión transitorio
    attempts=0
    http_code="000"
    while [ "$http_code" = "000" ] && [ "$attempts" -lt 3 ]; do
      attempts=$((attempts + 1))
      response=$(curl -s -m 30 -w "\n%{http_code}" -X POST https://upload.gyazo.com/api/upload \
        -H "Authorization: Bearer $API_TOKEN" \
        -F "imagedata=@$IMG_PATH")
      http_code=$(echo "$response" | tail -n1)
      [ "$http_code" = "000" ] && [ "$attempts" -lt 3 ] && sleep 2
    done
    body=$(echo "$response" | sed '$d')

    link=$(echo "$body" | grep -o '"url":"[^"]*' | cut -d'"' -f4)

    if [ -n "$link" ]; then
      wl-copy --type image/png <"$IMG_PATH"
      echo -n "$link" | wl-copy --primary
      xdg-open "$link" &
      notify-send "Screenshot Saved" "$link" --icon="$IMG_PATH"
    elif [ "$http_code" = "401" ]; then
      # Token revocado entre validación y subida
      gyazo_fallback_auth
    elif [ "$http_code" = "000" ]; then
      # Conexión cortada pero Gyazo pudo haber subido: reconciliar vía /api/images
      recent=$(curl -s -m 10 "https://api.gyazo.com/api/images?per_page=5" \
        -H "Authorization: Bearer $API_TOKEN" 2>/dev/null)
      confirmed=$(echo "$recent" | jq -r '
        [.[] | select(((now - (.created_at | sub("\\+0000"; "Z") | fromdateiso8601)) < 180))] |
        .[0].permalink_url // empty' 2>/dev/null)
      if [ -n "$confirmed" ]; then
        echo -n "$confirmed" | wl-copy --primary
        xdg-open "$confirmed" &
      else
        notify-send -i dialog-error "❌ Sin conexión con Gyazo" "Respuesta perdida (HTTP 000) y sin subida confirmada en los últimos 3 min"
        wl-copy --type image/png <"$IMG_PATH"
      fi
    else
      msg=$(echo "$body" | grep -o '"message":"[^"]*' | cut -d'"' -f4)
      notify-send -i dialog-error "❌ Error al subir a Gyazo" "${msg:-HTTP $http_code / Respuesta vacía (tras $attempts intentos)}"
      wl-copy --type image/png <"$IMG_PATH"
    fi
  else
    gyazo_fallback_auth
  fi
else
  # Sin internet: guardar sin subir
  wl-copy --type image/png <"$IMG_PATH"
  notify-send -i camera-photo "📸 Captura guardada" "$IMG_PATH"
fi
