#!/bin/bash
# === Token de Gyazo ===
API_TOKEN="p2aAJsU8VvSUmE_mYAGkNPmEoMxohL6K6UghjrXfMKc"

# === Ruta temporal para la imagen ===
IMG_PATH="/tmp/gyazo_$(date +%s).png"

# === Flag para controlar si se sube a Gyazo ===
SKIP_GYAZO=0 # ← NUEVA VARIABLE

# === Menu: Seleccionar modo con rofi ===
option=$(printf " Captura Ventana con Click\n  Ventana Activa (Auto)\n󰵝   Captura Completa Gyazo󰒊\n󰆟  Seleccionar Área\n󰒊 󰩫 Gyazo Share" | fuzzel --dmenu --prompt="Tipo de Captura:")

pkill -9 rofi
sleep 1

# === Captura de pantalla ===
if [[ "$option" == *"Click"* ]]; then
  hyprshot -m window --freeze
  sleep 0.5
  HYPR_IMG=$(ls -t "$HOME/Pictures"/*.png "$HOME/Imágenes/"/*.png 2>/dev/null | head -1)
  mv "$HYPR_IMG" "$IMG_PATH"

elif [[ "$option" == *"Auto"* ]]; then
  if [ "$comp" = "hypr" ]; then
    hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' | grim -g - "$IMG_PATH"
  else
    # niri: obtener geometría real en pantalla de la ventana enfocada
    WINDOW_JSON="$(niri msg --json focused-window 2>/dev/null)" \
      || { notify-send "❌ No se pudo obtener la ventana enfocada"; exit 1; }

    WORKSPACE_ID="$(echo "$WINDOW_JSON" | jq -r '.workspace_id')"
    IS_FLOATING="$(echo "$WINDOW_JSON" | jq -r '.is_floating')"

    # Obtener output del workspace
    OUTPUT_NAME="$(niri msg --json workspaces 2>/dev/null | jq -r --argjson wid "$WORKSPACE_ID" '.[] | select(.id == $wid) | .output')" \
      || { notify-send "❌ No se pudo encontrar el workspace"; exit 1; }

    # Obtener posición lógica del output
    OUTPUT_POS="$(niri msg --json outputs 2>/dev/null | jq -r --arg oname "$OUTPUT_NAME" '.[$oname].logical | "\(.x) \(.y)"')" \
      || { notify-send "❌ No se pudo obtener posición del output"; exit 1; }
    OUT_X="$(echo "$OUTPUT_POS" | awk '{print $1}')"
    OUT_Y="$(echo "$OUTPUT_POS" | awk '{print $2}')"

    # Calcular geometría según tipo de ventana
    if [ "$IS_FLOATING" = "true" ]; then
      # Floating: tile_pos_in_workspace_view + window_offset_in_tile + output_pos
      GEOM="$(echo "$WINDOW_JSON" | jq -r --argjson ox "$OUT_X" --argjson oy "$OUT_Y" '
        "\(.layout.tile_pos_in_workspace_view[0] + .layout.window_offset_in_tile[0] + $ox),\(.layout.tile_pos_in_workspace_view[1] + .layout.window_offset_in_tile[1] + $oy) \(.layout.window_size[0])x\(.layout.window_size[1])"
      ')"
    else
      # Tiling: pos_in_scrolling_layout + output_pos (aproximación, no hay viewport en IPC)
      GEOM="$(echo "$WINDOW_JSON" | jq -r --argjson ox "$OUT_X" --argjson oy "$OUT_Y" '
        "\(.layout.pos_in_scrolling_layout[0] + $ox),\(.layout.pos_in_scrolling_layout[1] + $oy) \(.layout.window_size[0])x\(.layout.window_size[1])"
      ')"
    fi

    [ -n "$GEOM" ] && [ "$GEOM" != "null,null nullxnull" ] \
      || { notify-send "❌ Geometría inválida"; exit 1; }

    grim -g "$GEOM" "$IMG_PATH"
  fi

# ← AQUÍ ESTÁ EL CAMBIO PARA OPCIÓN 3
elif [[ "$option" == *Completa* ]]; then
  grim "$IMG_PATH"

  # Si no hay token o está vacío, solo guardar localmente
  if [ -z "$API_TOKEN" ] || [ "$API_TOKEN" == "" ]; then
    SKIP_GYAZO=1
    notify-send "📸 Sin token Gyazo" "Captura guardada localmente"
  fi

elif [[ "$option" == *Área* ]]; then
  hyprshot -m region -o "$IMG_PATH"

elif [[ "$option" == *Share* ]]; then
  sh -c "scripts/gyazo-wayland-captura-clip"
else
  exit 1
fi

# === Guardar copia en Escritorio ===
cp "$IMG_PATH" "$HOME/Escritorio/$(basename "$IMG_PATH")"

# === Subir SOLO si SKIP_GYAZO = 0 ===
if [ $SKIP_GYAZO -eq 0 ] && ping -c 1 -W 1 gyazo.com &>/dev/null; then
  response=$(curl -s -X POST https://upload.gyazo.com/api/upload \
    -F "access_token=$API_TOKEN" \
    -F "imagedata=@$IMG_PATH")

  link=$(echo "$response" | grep -o '"url":"[^"]*' | cut -d'"' -f4)

  if [ -n "$link" ]; then
    wl-copy --type image/png <"$IMG_PATH"
    echo -n "$link" | wl-copy --primary
    xdg-open "$link" &
    notify-send "Screenshot Saved" "$link" --icon="$IMG_PATH"
  fi
else
  # Guardar sin subir
  wl-copy --type image/png <"$IMG_PATH"
  notify-send -i camera-photo "📸 Captura guardada" "$IMG_PATH"
fi
