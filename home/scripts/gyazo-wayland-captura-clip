#!/bin/bash
#/007   gyazo-wayland-captura-clip

# === Configuración ===
# === Token de Gyazo ===
# NOTA: el token NO expira por tiempo; un 401 con "The access token was
# revoked" en WWW-Authenticate = revocado → regenerar en
# https://gyazo.com/oauth/applications → clic en app (DIZZI) → Regenerate.
API_TOKEN="8tpTwzUTedImGHZCFAcatRcjGIzzdBTY-3UZ6Ur_yPM"
IMG_PATH="/tmp/gyazo_$(date +%s).png"

# === Asegura entorno Wayland ===
export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-1}

# === Captura de pantalla con grim y slurp ===
grim -g "$(slurp)" "$IMG_PATH" || {
  notify-send "❌ Captura cancelada"
  exit 1
}

# === Guardar copia en Escritorio ===
cp "$IMG_PATH" "$HOME/Escritorio/$(basename "$IMG_PATH")"

# === Copiar imagen como archivo binario al portapapeles ===
wl-copy --type image/png <"$IMG_PATH"

# === Verificar si hay token ===
if [ -z "$API_TOKEN" ]; then
  notify-send "📸 Sin token Gyazo" "Captura guardada localmente" --icon="$IMG_PATH"
  exit 0
fi

# === Verificar conexión a Internet ===
if ! ping -c 1 -W 1 gyazo.com &>/dev/null; then
  notify-send "📸 Sin conexión" "Captura guardada localmente" --icon="$IMG_PATH"
  exit 0
fi

# === Subida a Gyazo (retry: HTTP 000 = fallo de conexión transitorio) ===
attempts=0
http_code="000"
curl_exit=""
while [ "$http_code" = "000" ] && [ "$attempts" -lt 3 ]; do
  attempts=$((attempts + 1))
  response=$(curl -s -m 30 -w "\n%{http_code}" -X POST https://upload.gyazo.com/api/upload \
    -H "Authorization: Bearer $API_TOKEN" \
    -F "imagedata=@$IMG_PATH" 2>/tmp/gyazo_curl_err.txt)
  curl_exit=$?
  http_code=$(echo "$response" | tail -n1)
  [ "$http_code" = "000" ] && [ "$attempts" -lt 3 ] && sleep 2
done
body=$(echo "$response" | sed '$d')

# === Extraer link del JSON ===
link=$(echo "$body" | grep -o '"url":"[^"]*' | cut -d'"' -f4)

# === Acciones finales ===
if [ -n "$link" ]; then
  echo -n "$link" | wl-copy --primary # copia también el link como texto por si acaso
  xdg-open "$link" &
  notify-send "Screenshot Saved" "$link" --icon="$IMG_PATH"
elif [ "$http_code" = "401" ]; then
  notify-send -i dialog-error "❌ Token Gyazo revocado" "Regenerate en gyazo.com/oauth/applications"
elif [ "$http_code" = "000" ]; then
  # Fallo de conexión: la respuesta no volvió, PERO el servidor pudo haber
  # subido la imagen (link confirmado por Gyazo). Reconciliar vía /api/images.
  recent=$(curl -s -m 10 "https://api.gyazo.com/api/images?per_page=5" \
    -H "Authorization: Bearer $API_TOKEN" 2>/dev/null)
  confirmed=$(echo "$recent" | jq -r '
    [.[] | select(((now - (.created_at | sub("\\+0000"; "Z") | fromdateiso8601)) < 180))] |
    .[0].permalink_url // empty' 2>/dev/null)
  if [ -n "$confirmed" ]; then
    echo -n "$confirmed" | wl-copy --primary
    xdg-open "$confirmed" &
  else
    case "$curl_exit" in
      6)  reason="No se pudo resolver upload.gyazo.com (DNS)" ;;
      7)  reason="Conexión rechazada por Gyazo" ;;
      28) reason="Timeout (30s)" ;;
      *)  reason="Fallo de red (curl exit $curl_exit: $(tr -d '\n' </tmp/gyazo_curl_err.txt 2>/dev/null))" ;;
    esac
    notify-send -i dialog-error "❌ Sin conexión con Gyazo" "$reason — La captura quedó en el portapapeles"
  fi
else
  msg=$(echo "$body" | grep -o '"message":"[^"]*' | cut -d'"' -f4)
  notify-send -i dialog-error "❌ Error al subir a Gyazo" "${msg:-HTTP $http_code / Respuesta vacía (tras $attempts intentos)}"
fi
