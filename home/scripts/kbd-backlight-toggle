#!/bin/bash
# Toggle keyboard backlight on/off

KBD_PATH="/sys/class/leds/tpacpi::kbd_backlight/brightness"
MAX_BRIGHTNESS=$(cat /sys/class/leds/tpacpi::kbd_backlight/max_brightness 2>/dev/null || echo 2)

if [[ ! -f "$KBD_PATH" ]]; then
  echo "Error: Keyboard backlight not found at $KBD_PATH"
  exit 1
fi

CURRENT=$(cat "$KBD_PATH")

if [[ "$CURRENT" -gt 0 ]]; then
  echo 0 > "$KBD_PATH"
else
  echo "$MAX_BRIGHTNESS" > "$KBD_PATH"
fi
