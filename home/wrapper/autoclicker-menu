#!/bin/bash
# autoclicker-menu (NixOS Wayland ver)
# ydotool funciona en modo directo (sin daemon) en Wayland

PIDFILE="/tmp/ydotool-autoclicker.pid"

clean_zombie_pids() {
  if [[ -f "$PIDFILE" ]]; then
    local pid=$(cat "$PIDFILE")
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PIDFILE"
      return 1
    fi
    echo "⚠️  AutoClicker corriendo (PID: $pid)"
    read -p "¿Detener y reiniciar? [S/n]: " confirm
    if [[ ! "$confirm" =~ ^[Nn]$ ]]; then
      pkill -P "$pid" 2>/dev/null; kill -TERM "$pid" 2>/dev/null
      sleep 0.2; kill -9 "$pid" 2>/dev/null; rm -f "$PIDFILE"
    else exit 0; fi
  fi
}

clean_zombie_pids
~/.local/bin/autoclicker menu

echo
echo -e "\033[1;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;32m✅ Proceso completado\033[0m"
echo -e "\033[0;36mPresiona Enter para cerrar...\033[0m"
read -r
