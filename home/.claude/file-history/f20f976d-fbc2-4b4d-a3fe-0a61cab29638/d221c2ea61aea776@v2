---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 · Diego Härdi" description="Página no encontrada">
  <section class="min-h-screen flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      <p class="text-8xl font-display font-extrabold mb-4">
        <span style="color: #e94560;">4</span><span style="color: #00d9ff;">0</span><span style="color: #e94560;">4</span>
      </p>
      <p class="text-xl font-semibold mb-2" style="color: var(--text-primary);">Página no encontrada</p>
      <p class="text-sm mb-8" style="color: var(--text-muted);">La ruta que buscas no existe o fue movida.</p>
      <a href="/" class="px-8 py-3 bg-[#e94560] text-white font-semibold rounded-lg hover:bg-[#d91a3a] transition-all inline-block">
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>
