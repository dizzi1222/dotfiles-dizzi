---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SectionExperience from "../components/SectionExperience.astro";
import SectionProyects from "../components/SectionProyects.astro";
import SectionServicios from "../components/SectionServicios.astro";
import SectionSetup from "../components/SectionSetup.astro";
import AboutMe from "../components/AboutMe.astro";
import SectionSkills from "../components/SectionSkills.astro";
import SectionTechStack from "../components/SectionTechStack.astro";
import SectionCertification from "../components/SectionCertification.astro";
import SectionContact from "../components/SectionContact.astro";
---

<Layout>
  <Header />

  <!-- HERO -->
  <section id="hero" class="relative min-h-screen flex items-center justify-center pt-16 px-4 overflow-hidden">
    <div class="bg-slideshow" id="bg-slideshow">
      <div class="bg-slide active" style="background-image: url('https://images.unsplash.com/photo-1530122037265-a5f1f91d3b99?auto=format&fit=crop&w=1920&q=80')"></div>
      <div class="bg-slide" style="background-image: url('https://images.unsplash.com/photo-1540202404-a2f29016b523?auto=format&fit=crop&w=1920&q=80')"></div>
      <div class="bg-slide" style="background-image: url('https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1920&q=80')"></div>
      <div class="bg-slide" style="background-image: url('https://upload.wikimedia.org/wikipedia/commons/9/92/Pico_Duarte.jpg')"></div>
      <div class="bg-slide" style="background-image: url('https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?auto=format&fit=crop&w=1920&q=80')"></div>
      <div class="bg-slide" style="background-image: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1920&q=80')"></div>
      <div class="bg-slide" style="background-image: url('https://images.unsplash.com/photo-1531366936337-7c912a4589a7?auto=format&fit=crop&w=1920&q=80')"></div>
      <div class="bg-slide" style="background-image: url('https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&w=1920&q=80')"></div>
    </div>

    <div id="hero-overlay" class="absolute inset-0 z-[1] transition-all duration-1000" style="background: linear-gradient(135deg, rgba(5,5,25,0.88) 0%, rgba(5,5,5,0.8) 50%, rgba(25,10,5,0.85) 100%);"></div>

    <button onclick="prevSlide()" class="slide-nav prev" aria-label="Previous slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button onclick="nextSlide()" class="slide-nav next" aria-label="Next slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    </button>

    <div class="max-w-6xl mx-auto text-center relative z-10">
      <div id="vibe-indicator" class="mb-6 inline-flex items-center gap-3 px-4 py-2 bg-black/50 backdrop-blur-md rounded-full border border-white/10 text-xs font-semibold tracking-wider uppercase animate-fade-in-up">
        <span id="vibe-icon" class="text-lg">❄️</span>
        <span id="vibe-label" class="text-muted">Swiss Alps</span>
        <span class="text-subtle">·</span>
        <span id="vibe-counter" class="text-subtle">1/8</span>
      </div>

      <div class="animate-float inline-block mb-6">
        <div class="w-36 h-36 sm:w-44 sm:h-44 mx-auto rounded-full border-4 border-[#e94560] overflow-hidden glow">
          <img src="/avatar.png" alt="Diego Härdi" class="w-full h-full object-cover" />
        </div>
      </div>

      <div class="flex justify-center mb-4 animate-fade-in-up">
        <span class="flex items-center gap-2 px-4 py-1.5 bg-emerald-500/10 border border-emerald-500/20 rounded-full text-emerald-400 text-xs font-medium">
          <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse-soft"></span>
          <span data-i18n="hero.available">Disponible</span>
        </span>
      </div>

      <h1 class="font-display text-4xl sm:text-5xl lg:text-7xl font-extrabold mb-3 animate-fade-in-up">
        Diego <span class="gradient-text">Härdi</span>
      </h1>

      <p class="text-lg sm:text-xl text-secondary mb-2 animate-fade-in-up animate-delay-1" data-i18n="hero.title">
        DevOps &amp; Software Engineer
      </p>

      <p class="text-sm sm:text-base text-secondary mb-6 animate-fade-in-up animate-delay-1 font-medium">
        <span class="text-[#00d9ff]" data-i18n="hero.born">🇩🇴 Born in San Pedro de Macorís</span>
        <span class="text-subtle mx-2">·</span>
        <span class="text-[#e94560]" data-i18n="hero.passport">🇨🇭 Swiss passport</span>
        <span class="text-subtle mx-2">·</span>
        <span class="text-[#00d9ff]" data-i18n="hero.lives">🏔️ Lives in Jarabacoa</span>
      </p>
      <p class="text-xs sm:text-sm text-tertiary mb-6 animate-fade-in-up animate-delay-1" data-i18n="hero.tagline">
        Building full-stack · Arch Linux · Neovim
      </p>

      <div class="flex flex-wrap justify-center gap-4 animate-fade-in-up animate-delay-2">
        <a href="#contact" class="px-8 py-3 bg-[#e94560] text-white font-semibold rounded-lg hover:bg-[#d91a3a] transition-all hover-glow" data-i18n="hero.getInTouch">Get in touch</a>
        <button onclick="openCVModal()" class="px-8 py-3 border border-[#e94560] text-[#e94560] font-semibold rounded-lg hover:bg-[#e94560] hover:text-white transition-all cursor-pointer" data-i18n="hero.previewCv">Preview CV</button>
      </div>

      <div class="mt-8 flex justify-center gap-5 animate-fade-in-up animate-delay-3">
        <a href="https://github.com/dizzi1222" target="_blank" class="hover:scale-110 transition-transform" aria-label="GitHub">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="text-muted hover:fill-[#e94560] transition-colors"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.604-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/dizzi-%C5%8Dkami-0b77093a1/" target="_blank" class="hover:scale-110 transition-transform" aria-label="LinkedIn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="text-muted hover:fill-[#e94560] transition-colors"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://x.com/dizzi_ds" target="_blank" class="hover:scale-110 transition-transform" aria-label="X">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="text-muted hover:fill-[#e94560] transition-colors"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://dev.to/dizzi1222" target="_blank" class="hover:scale-110 transition-transform" aria-label="Dev.to">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="text-muted hover:fill-[#e94560] transition-colors"><path d="M7.5 2C4.462 2 2 4.462 2 7.5v9C2 19.538 4.462 22 7.5 22h9c3.038 0 5.5-2.462 5.5-5.5v-9C22 4.538 19.538 2 16.5 2h-9zM6 8h1.5v5.25c0 .713.287 1 .938 1h.562v1.312h-.75c-1.275 0-1.988-.525-1.988-1.688V8h1.738zm5.25 0h1.5v1.5h-1.5V8zm0 2.25h1.5v5.25h-1.5v-5.25zM15 8h1.875c1.313 0 2.063.75 2.063 2.063 0 1.237-.525 1.874-1.5 1.874.975 0 1.5.638 1.5 1.875 0 1.312-.75 2.063-2.063 2.063H15V8zm1.5 1.5v1.125h.375c.338 0 .563-.187.563-.563 0-.337-.225-.562-.563-.562H16.5zm0 2.625v1.5h.563c.337 0 .562-.225.562-.563 0-.337-.225-.562-.563-.562H16.5z"/></svg>
        </a>
        <a href="https://www.instagram.com/diego.sam042/" target="_blank" class="hover:scale-110 transition-transform" aria-label="Instagram">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="text-muted hover:fill-[#e94560] transition-colors"><path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 0 2.5 1.25 1.25 0 0 1 0-2.5M12 7a5 5 0 0 1 0 10 5 5 0 0 1 0-10m0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>
        </a>
      </div>
    </div>

    <div onclick="document.getElementById('experience').scrollIntoView({behavior:'smooth'})" class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-pulse-soft cursor-pointer hover:opacity-70 transition-opacity">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
    </div>
  </section>

  <main>
    <SectionExperience />
    <SectionProyects />
    <SectionServicios />
    <SectionSetup />
    <SectionTechStack />
    <SectionCertification />
    <SectionContact />
  </main>

  <!-- Scroll Progress Dots -->
  <nav id="scroll-dots" class="scroll-dots" aria-label="Section navigation">
    <a href="#hero" class="scroll-dot active" data-section="hero"><span class="scroll-dot-tooltip">Home</span></a>
    <a href="#experience" class="scroll-dot" data-section="experience"><span class="scroll-dot-tooltip" data-i18n="nav.experience">Experiencia</span></a>
    <a href="#projects" class="scroll-dot" data-section="projects"><span class="scroll-dot-tooltip" data-i18n="nav.projects">Proyectos</span></a>
    <a href="#servicios" class="scroll-dot" data-section="servicios"><span class="scroll-dot-tooltip" data-i18n="nav.servicios">Servicios</span></a>
    <a href="#setup" class="scroll-dot" data-section="setup"><span class="scroll-dot-tooltip" data-i18n="nav.setup">Setup</span></a>
    <a href="#stack" class="scroll-dot" data-section="stack"><span class="scroll-dot-tooltip">Tech Stack</span></a>
    <a href="#certifications" class="scroll-dot" data-section="certifications"><span class="scroll-dot-tooltip" data-i18n="nav.certifications">Certificaciones</span></a>
    <a href="#contact" class="scroll-dot" data-section="contact"><span class="scroll-dot-tooltip" data-i18n="nav.contact">Contacto</span></a>
  </nav>

  <!-- Project/CV Modal -->
  <div id="modal" class="modal-overlay">
    <div class="modal-backdrop" onclick="closeModal()"></div>
    <div class="modal-container">
      <div class="modal-header">
        <h3 id="modal-title" class="font-display text-xl font-bold text-primary"></h3>
        <button onclick="closeModal()" class="modal-close">&times;</button>
      </div>
      <div id="modal-image" class="modal-image"></div>
      <p id="modal-description" class="mt-4 text-sm text-muted leading-relaxed"></p>
      <div id="modal-footer" class="modal-footer"></div>
    </div>
  </div>

  <!-- Cert Overlay -->
  <div id="cert-overlay" class="cert-overlay">
    <div class="cert-backdrop" onclick="closeCertModal()"></div>
    <div class="cert-content">
      <div class="cert-header">
        <h3 class="font-display text-xl font-bold text-primary">🎓 <span data-i18n="certs.heading">Certificaciones</span></h3>
        <button onclick="closeCertModal()" class="cert-close">&times;</button>
      </div>
      <div class="cert-body">
        <div class="flex items-center justify-between mb-6">
          <span class="font-mono text-xs text-faint bg-badge px-3 py-1 rounded">cic_cert_download.sh</span>
          <span id="cert-status" class="font-mono text-xs text-[#00d9ff]">loading...</span>
        </div>
        <div class="grid gap-4">
          <div class="cert-card">
            <div class="flex items-center gap-4 mb-3">
              <span class="text-3xl" id="cert-spinner">◴</span>
              <div>
                <p class="font-display font-bold text-[#00d9ff]" data-i18n="certs.item1Title">CIC Associate Developer</p>
                <p class="text-xs text-muted font-mono" data-i18n="certs.item1Desc">Certificación oficial · Bootcamp Cincinnatus</p>
              </div>
            </div>
            <div class="cert-bar-track">
              <div id="cert-bar" class="cert-bar-fill" style="width:42%"></div>
            </div>
            <div class="flex justify-between text-xs text-faint font-mono mt-1">
              <span data-i18n="certs.progressLabel">Progreso</span>
              <span id="cert-text">Cap. Interna ✓ — Esperando fecha de examen oficial</span>
            </div>
          </div>
          <div class="cert-card opacity-70">
            <div class="flex items-center gap-4">
              <span class="text-2xl">🔜</span>
              <div>
                <p class="font-display font-bold text-primary">AWS Cloud Practitioner</p>
                <p class="text-xs text-muted font-mono">En planificación</p>
              </div>
            </div>
          </div>
          <div class="cert-card opacity-50">
            <div class="flex items-center gap-4">
              <span class="text-2xl">🔜</span>
              <div>
                <p class="font-display font-bold text-primary">Google Cloud Associate</p>
                <p class="text-xs text-muted font-mono">En planificación</p>
              </div>
            </div>
          </div>
        </div>
        <div class="mt-6 text-center">
          <p class="text-xs text-faint font-mono">※ placeholder — actualizar al recibir certificación oficial <span style="animation:blink 1s step-end infinite">_</span></p>
        </div>
      </div>
    </div>
  </div>
</Layout>

