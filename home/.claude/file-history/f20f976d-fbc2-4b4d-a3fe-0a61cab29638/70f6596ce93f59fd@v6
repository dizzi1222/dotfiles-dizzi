  function goToSlide(index) {
    slides[current].classList.remove('active', 'kenburns');
    current = (index + totalSlides) % totalSlides;
    slides[current].classList.add('active', 'kenburns');
    updateVibe();
  }

  function nextSlide() { goToSlide(current + 1); }
  function prevSlide() { goToSlide(current - 1); }

  function updateVibe() {
    vibeCounter.textContent = `${current + 1}/${totalSlides}`;
    const isSwiss = current === 0 || current === 2 || current === 4 || current === 6;
    vibeIcon.textContent = isSwiss ? '❄️' : '☀️';
    vibeEl.textContent = getVibeLabels()[current];
    overlay.style.background = isSwiss
      ? 'linear-gradient(135deg, rgba(5,5,30,0.88) 0%, rgba(5,5,20,0.8) 50%, rgba(15,10,25,0.85) 100%)'
      : 'linear-gradient(135deg, rgba(30,10,5,0.85) 0%, rgba(5,5,5,0.8) 50%, rgba(25,15,5,0.85) 100%)';
  }

  function startSlideshow() { clearInterval(interval); interval = setInterval(nextSlide, 6000); }
  function stopSlideshow() { clearInterval(interval); }

  slides[0].classList.add('active', 'kenburns');
  startSlideshow();

  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowLeft') { stopSlideshow(); prevSlide(); startSlideshow(); }
    if (e.key === 'ArrowRight') { stopSlideshow(); nextSlide(); startSlideshow(); }
  });

  // Drag
  let isDragging = false;
  let dragStartX = 0;
  const bgSlideshow = document.getElementById('bg-slideshow');
  bgSlideshow.addEventListener('mousedown', e => { isDragging = true; dragStartX = e.screenX; bgSlideshow.style.cursor = 'grabbing'; });
  document.addEventListener('mousemove', e => {
    if (!isDragging) return;
    const diff = dragStartX - e.screenX;
    if (Math.abs(diff) > 80) {
      stopSlideshow();
      if (diff > 0) nextSlide(); else prevSlide();
      startSlideshow();
      isDragging = false;
      bgSlideshow.style.cursor = 'grab';
    }
  });
  document.addEventListener('mouseup', () => { isDragging = false; bgSlideshow.style.cursor = 'grab'; });

  // Touch swipe
  const hero = document.getElementById('hero');
  let touchStartX = 0;
  hero.addEventListener('touchstart', e => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
  hero.addEventListener('touchend', e => {
    const diff = touchStartX - e.changedTouches[0].screenX;
    if (Math.abs(diff) > 50) {
      stopSlideshow();
      if (diff > 0) nextSlide(); else prevSlide();
      startSlideshow();
    }
  }, { passive: true });

  hero.addEventListener('mouseenter', stopSlideshow);
  hero.addEventListener('mouseleave', startSlideshow);

  // ===== Cert Spinner =====
  const certFrames = ['◴', '◷', '◶', '◵'];
  let certIdx = 0;
  setInterval(() => { const el = document.getElementById('cert-spinner'); if (el) el.textContent = certFrames[certIdx++ % certFrames.length]; }, 400);
  setInterval(() => {
    const el = document.getElementById('cert-bar');
    if (!el) return;
    const w = parseInt(el.style.width) || 42;
    el.style.width = Math.min(99, w + (Math.random() > 0.7 ? 1 : 0)) + '%';
  }, 3000);

  // ===== Scroll reveal =====
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
  document.querySelectorAll('.section-in').forEach(el => revealObserver.observe(el));

  // ===== Scroll spy =====
  const navLinks = document.querySelectorAll('nav a[href^="#"]');
  const spySections = document.querySelectorAll('section[id]');
  const spyObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        navLinks.forEach(link => {
          link.classList.remove('text-primary');
          link.classList.add('text-muted');
          if (link.getAttribute('href') === '#' + id) {
            link.classList.remove('text-muted');
            link.classList.add('text-primary');
          }
        });
      }
    });
  }, { threshold: 0.3, rootMargin: '0px 0px -100px 0px' });
  spySections.forEach(s => spyObserver.observe(s));

  // ===== Tech Stack interaction =====
  const techPopup = document.getElementById('tech-popup');
  const techDesc = document.getElementById('tech-desc');

  var techMeta = {
    'Node.js': { color: '#339933', tags: ['Runtime', 'Backend', 'JavaScript'] },
    'Express': { color: '#000000', tags: ['Framework', 'Backend', 'Node.js'] },
    'React': { color: '#61DAFB', tags: ['Hooks', 'Context', 'SPA', 'Frontend'] },
    'MongoDB': { color: '#47A248', tags: ['Database', 'NoSQL', 'MERN'] },
    'PostgreSQL': { color: '#4169E1', tags: ['Database', 'SQL', 'Relational'] },
    'Git': { color: '#F05032', tags: ['Branching', 'Rebase', 'GitFlow', 'Conventional Commits'] },
    'Arch': { color: '#1793D1', tags: ['Linux', 'Hyprland', 'System'] },
    'Neovim': { color: '#57A143', tags: ['Editor', 'LSP', 'Lua', 'Productivity'] },
    'TypeScript': { color: '#3178C6', tags: ['Language', 'Typed', 'JavaScript'] },
    'Docker': { color: '#2496ED', tags: ['Containers', 'Compose', 'CI/CD', 'Microservices'] },
    'JavaScript': { color: '#F7DF1E', tags: ['ES2024', 'Async/Await', 'DOM', 'Functional'] },
    'Python': { color: '#3776AB', tags: ['Language', 'Automation', 'Scripting'] },
    'Tailwind CSS': { color: '#06B6D4', tags: ['Design System', 'Responsive', 'JIT', 'Frontend'] },
    'Render': { color: '#46E3B7', tags: ['Cloud', 'Hosting', 'Deploy'] },
    'Vercel': { color: '#000000', tags: ['Edge Network', 'Preview Deploy', 'Serverless'] },
    'Google Cloud': { color: '#4285F4', tags: ['Cloud Run', 'App Engine', 'Cloud SQL', 'GCP'] },
    'Material UI': { color: '#007FFF', tags: ['UI', 'React', 'Components', 'Material Design'] },
    'Svelte': { color: '#FF3E00', tags: ['Framework', 'Compiler', 'No Virtual DOM'] },
    'Astro': { color: '#BC52EE', tags: ['Island Architecture', 'SSG', 'SSR', 'Performance'] },
    'HTML': { color: '#E34F26', tags: ['Semántica', 'Accesibilidad', 'SEO', 'Web Standards'] },
    'CSS': { color: '#1572B6', tags: ['Grid', 'Flexbox', 'Animations', 'Custom Properties'] },
    'Figma': { color: '#F24E1E', tags: ['Components', 'Auto Layout', 'Tokens', 'Prototyping'] },
    'Bootstrap': { color: '#7952B3', tags: ['Grid System', 'Responsive', 'Components'] },
    'Railway': { color: '#7E3AF2', tags: ['Cloud', 'PostgreSQL', 'Deploy', 'Backend'] }
  };

  function hexToRgba(hex, a) {
    var r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
    return 'rgba('+r+','+g+','+b+','+a+')';
  }

  document.querySelectorAll('#tech-grid > div').forEach(el => {
    const label = el.querySelector('span:last-child')?.textContent.trim();
    el.addEventListener('click', () => {
      const lang = localStorage.getItem('dhardi-lang') || 'es';
      const techInfo = i18n[lang].tech || {};
      if (!techInfo[label]) return;
      const meta = techMeta[label] || { color: '#888', tags: [] };
      const tagsHtml = meta.tags.map(t =>
        '<span style="display:inline-block;padding:2px 8px;border-radius:9999px;font-size:10px;font-weight:600;background:'+hexToRgba(meta.color,0.12)+';color:'+meta.color+';border:1px solid '+hexToRgba(meta.color,0.25)+';letter-spacing:0.02em;">'+t+'</span>'
      ).join(' ');
      techDesc.textContent = '';
      techPopup.innerHTML = '<div style="margin-bottom:6px"><span class="tp-label" style="color:'+meta.color+'">'+label+'</span></div><div style="margin-bottom:8px;font-size:0.78rem;color:var(--text-tertiary);line-height:1.5;">'+techInfo[label]+'</div><div style="display:flex;flex-wrap:wrap;gap:4px;">'+tagsHtml+'</div>';
      const rect = el.getBoundingClientRect();
      techPopup.style.display = 'block';
      const pw = techPopup.offsetWidth || 300;
      const ph = techPopup.offsetHeight || 100;
      let left = rect.left + rect.width / 2 - pw / 2;
      left = Math.max(16, Math.min(left, window.innerWidth - pw - 16));
      techPopup.style.left = left + 'px';
      if (rect.bottom + ph + 8 > window.innerHeight) {
        techPopup.style.top = Math.max(8, rect.top - ph - 8) + 'px';
      } else {
        techPopup.style.top = rect.bottom + 8 + 'px';
      }
      techPopup.classList.add('show');
      clearTimeout(techPopup._hide);
      techPopup._hide = setTimeout(() => techPopup.classList.remove('show'), 4000);
    });
  });

  // ===== Header scroll → floating nav (smooth crossfade) =====
  const header = document.getElementById('header');
  const floatingNav = document.getElementById('floating-nav');
  var navTransitioning = false;
  window.addEventListener('scroll', () => {
    var y = window.scrollY;
    if (y > 200 && !header.classList.contains('header-hidden')) {
      header.classList.add('header-hidden');
      setTimeout(() => floatingNav.classList.add('visible'), 150);
    } else if (y <= 120 && header.classList.contains('header-hidden')) {
      floatingNav.classList.remove('visible');
      setTimeout(() => header.classList.remove('header-hidden'), 150);
    }
  }, { passive: true });

  // Floating nav active link tracking
  var floatingLinks = document.querySelectorAll('.floating-nav-link');
  var floatingObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        floatingLinks.forEach(l => l.classList.remove('active'));
        var activeLink = document.querySelector('.floating-nav-link[href="#' + entry.target.id + '"]');
        if (activeLink) activeLink.classList.add('active');
      }
    });
  }, { threshold: 0.3, rootMargin: '0px 0px -20% 0px' });
  dotSections.forEach(s => floatingObserver.observe(s));

  // ===== Scroll dots =====
  const scrollDots = document.querySelectorAll('.scroll-dot');
  const dotSections = document.querySelectorAll('section[id]');
  const dotObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        scrollDots.forEach(dot => dot.classList.remove('active'));
        const activeDot = document.querySelector(`.scroll-dot[data-section="${entry.target.id}"]`);
        if (activeDot) activeDot.classList.add('active');
      }
    });
  }, { threshold: 0.3, rootMargin: '0px 0px -20% 0px' });
  dotSections.forEach(s => dotObserver.observe(s));

  // ===== Initialize =====
  (function init() {
    const savedLang = localStorage.getItem('dhardi-lang') || 'es';
    const savedTheme = localStorage.getItem('dhardi-theme') || 'dark';
    switchLanguage(savedLang);
    switchTheme(savedTheme);
  })();
</script>
