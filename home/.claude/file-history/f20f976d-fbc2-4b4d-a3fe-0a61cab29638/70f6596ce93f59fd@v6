      hero: { available: 'Disponible para oportunidades', title: 'DevOps & Software Engineer', born: '🇩🇴 Nacido en San Pedro de Macorís', passport: '🇨🇭 Pasaporte suizo', lives: '🏔️ Vive en Jarabacoa', tagline: 'Full-Stack · Arch Linux · Neovim', getInTouch: 'Contáctame', previewCv: 'Vista previa CV' },
      exp: { heading: 'Experiencia', subtitle: 'Mi trayectoria profesional',
