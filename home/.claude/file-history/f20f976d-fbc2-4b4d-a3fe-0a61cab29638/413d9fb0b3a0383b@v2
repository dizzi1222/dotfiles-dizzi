---
import BlurFadeW from "./ui/BlurFadeW";

const cicCerts = [
  { title: 'Desarrollo de Software v4', status: 'Completado', progress: 100, issuer: 'RadarX', year: '2025' },
  { title: 'Inteligencia Artificial para Todos v1', status: 'Completado', progress: 100, issuer: 'RadarX', year: '2025' },
  { title: 'Fundamentos de Pensamiento Crítico v4', status: 'Completado', progress: 100, issuer: 'RadarX', year: '2025' },
  { title: 'Mi primer empleo en Tech', status: 'Completado', progress: 100, issuer: 'Panel', year: '2025' },
  { title: 'Curso de IA para Todos', status: 'Completado', progress: 100, issuer: 'Panel', year: '2025' },
];

const otherCerts = [
  { title: 'CIC Associate Developer', status: 'En progreso', progress: 44, issuer: 'Cincinnatus Bootcamp', color: 'var(--color-cyan)' },
  { title: 'JSCAMP — Midudev Bootcamp', status: 'En progreso', progress: 20, issuer: 'Midudev', color: 'var(--color-cyan)' },
  { title: 'Mimo Full-Stack Development', status: 'En progreso', progress: 15, issuer: 'Mimo GmbH', color: 'var(--color-cyan)' },
  { title: 'Exercism · TryHackMe', status: 'En progreso', progress: 10, issuer: 'Exercism + TryHackMe', color: 'var(--color-cyan)' },
];

const edu = [
  { title: 'Desarrollo de Software v4', institution: 'Cincinnatus Institute of Craftsmanship — CIC', year: '2025 (Completado)' },
];
---

<section id="certifications" class="mx-auto max-w-5xl px-4 py-20">
  <h2 class="mb-2 text-sm font-semibold tracking-widest uppercase" style="color: var(--color-brand);">// Formación</h2>
  <p class="mb-10 text-sm" style="color: var(--text-muted);">
    Educación y certificaciones.
  </p>

  <BlurFadeW client:load>
    <div class="space-y-6">
      <!-- Education -->
      <div>
        <h3 class="mb-4 text-sm font-semibold" style="color: var(--text-primary);">Educación</h3>
        {edu.map(e => (
          <div class="rounded-xl p-5 transition-all hover:-translate-y-0.5" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
            <p class="text-sm font-semibold" style="color: var(--text-primary);">{e.title}</p>
            <p class="text-xs mt-1" style="color: var(--text-muted);">{e.institution} · {e.year}</p>
          </div>
        ))}
      </div>

      <!-- CIC Associate Developer — Consolidated -->
      <div>
        <h3 class="mb-4 mt-8 text-sm font-semibold" style="color: var(--text-primary);">CIC Associate Developer</h3>
        <div class="rounded-xl p-5 transition-all" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-medium" style="color: var(--color-cyan);">5 cursos completados</span>
            <span class="text-xs font-mono" style="color: var(--text-muted);">Cincinnatus Institute of Craftsmanship</span>
          </div>
          <div class="cert-expand-list">
            {cicCerts.map(c => (
              <div class="flex items-center justify-between py-2 border-b last:border-b-0" style="border-color: var(--border-color);">
                <div class="flex items-center gap-2">
                  <span class="text-xs" style="color: var(--color-green);">✓</span>
                  <span class="text-sm" style="color: var(--text-primary);">{c.title}</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-xs" style="color: var(--text-muted);">{c.issuer}</span>
                  <span class="text-xs font-mono" style="color: var(--text-subtle);">{c.year}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Other Certifications -->
      <div>
        <h3 class="mb-4 mt-8 text-sm font-semibold" style="color: var(--text-primary);">En progreso</h3>
        <div class="grid gap-4 sm:grid-cols-2">
          {otherCerts.map(c => (
            <div class="rounded-xl p-5 transition-all hover:-translate-y-0.5" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-medium" style="color: {c.color};">{c.status}</span>
                <span class="text-xs" style="color: var(--text-muted);">{c.progress}%</span>
              </div>
              <p class="text-sm font-semibold mb-1" style="color: var(--text-primary);">{c.title}</p>
              <p class="text-xs mb-3" style="color: var(--text-muted);">{c.issuer}</p>
              <div class="h-1.5 w-full overflow-hidden rounded-full" style="background: rgba(255,255,255,0.1);">
                <div class="h-full rounded-full transition-all" style="width: {c.progress}%; background: linear-gradient(90deg, var(--color-cyan), var(--color-brand));"></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </BlurFadeW>
</section>
