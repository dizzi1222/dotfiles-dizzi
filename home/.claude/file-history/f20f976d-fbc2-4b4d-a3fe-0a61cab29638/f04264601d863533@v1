---
interface Props {
  href: string;
  class?: string;
}
const { href, class: className = "" } = Astro.props;
---

<a href={href} class={"inline-flex items-center gap-2 rounded-md px-4 py-2 text-sm font-semibold transition-all hover:opacity-85 " + className} style="background: var(--color-brand); color: #fff;">
  <slot />
</a>
