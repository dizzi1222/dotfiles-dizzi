---
import { iconMap } from "./icons/index";
import { hexToRgba, hexToBorder } from "../lib/color.ts";
import { skills } from "../lib/skills.ts";

interface Props {
  name: string;
  color: string;
}

const { name, color } = Astro.props;
const Icon = iconMap[`Icon${name.replace(/[\s.-]/g, "")}`] || iconMap.IconReact;
const skill = skills.find(s => s.name === name);
---

<span
  class="badge-tech"
  style="background: {hexToRgba(color, 0.1)}; color: {color}; border: 1px solid {hexToBorder(color)};"
  data-skill={name}
  data-description={skill?.description || ""}
>
  {Icon && <Icon size={10} />}
  {name}
</span>

<script>
  document.addEventListener("click", (e) => {
    const badge = (e.target as HTMLElement).closest(".badge-tech") as HTMLElement | null;
    if (!badge) return;

    const existing = document.querySelector(".tech-badge-tooltip");
    if (existing && (existing as HTMLElement).dataset.skill === badge.dataset.skill) {
      existing.remove();
      return;
    }
    existing?.remove();

    const desc = badge.dataset.description;
    if (!desc) return;

    const tooltip = document.createElement("div");
    tooltip.className = "tech-badge-tooltip";
    tooltip.dataset.skill = badge.dataset.skill || "";
    tooltip.textContent = desc;
    tooltip.style.cssText = `
      position: fixed; z-index: 9999; bottom: 1.5rem; left: 50%; transform: translateX(-50%);
      background: var(--bg-secondary, #1a1a2e); color: var(--text-primary, #e0e0e0);
      padding: 0.75rem 1.25rem; border-radius: 0.75rem; font-size: 0.8rem;
      max-width: 320px; text-align: center; line-height: 1.4;
      border: 1px solid var(--border-color, #2a2a4a); box-shadow: 0 8px 32px rgba(0,0,0,0.4);
      animation: fadeInUp 0.25s ease-out both;
    `;
    document.body.appendChild(tooltip);

    setTimeout(() => tooltip.remove(), 4000);
  });
</script>
