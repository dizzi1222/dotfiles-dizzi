---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../lib/projects.ts";
import { skills } from "../../lib/skills.ts";
import BreadCrumb from "../../components/BreadCrumb.astro";
import DataProyect from "../../components/DataProyect.astro";
import ButtonPrimary from "../../components/ButtonPrimary.astro";
import ButtonSecondary from "../../components/ButtonSecondary.astro";
import IconArrowLeft from "../../components/icons/IconArrowLeft.astro";
import IconGithub from "../../components/icons/IconGithub.astro";
import IconLink from "../../components/icons/IconLink.astro";

export const prerender = false;

const { id } = Astro.params;
const project = projects.find(p => p.id === Number(id));

if (!project) {
  return Astro.redirect("/");
}

function getSkillColor(name: string): string {
  const found = skills.find(s => s.name === name);
  return found?.color || "#888";
}
---

<Layout title={`${project.title} — Diego Härdi`} description={project.description}>
  <main class="mx-auto max-w-3xl px-4 pt-24 pb-16" transition:name={`project-${project.id}`} transition:animate="slide">
    <a href="/#projects" data-astro-history="replace" class="mb-6 inline-flex items-center gap-2 text-sm transition-all hover:opacity-70" style="color: var(--text-muted);">
      <IconArrowLeft size={16} /> Volver a proyectos
    </a>

    <h1 class="text-3xl font-extrabold mb-2" style="color: var(--text-primary);">{project.title}</h1>

    <DataProyect year={project.year} category={project.category} teamSize={project.teamSize} />

    <!-- Tech badges -->
    <div class="flex flex-wrap gap-2 my-6">
      {project.technologies.map(tech => (
        <BreadCrumb name={tech} color={getSkillColor(tech)} />
      ))}
    </div>

    <!-- Image -->
    {project.image && (
      <div class="mb-8 overflow-hidden rounded-2xl" style="border: 1px solid var(--border-color);">
        <img src={project.image} alt={project.title} class="w-full object-cover" />
      </div>
    )}

    <!-- Description -->
    <div class="prose prose-sm max-w-none space-y-4 mb-8" style="color: var(--text-muted);">
      {project.descriptionLarge.split('\n\n').filter(Boolean).map(p => (
        <p>{p.trim()}</p>
      ))}
    </div>

    <!-- Actions -->
    <div class="flex flex-wrap gap-3">
      <ButtonPrimary href={project.github}>
        <IconGithub size={16} /> Ver código
      </ButtonPrimary>
      {project.live && project.live !== project.github && (
        <ButtonSecondary href={project.live}>
          <IconLink size={16} /> Live Preview
        </ButtonSecondary>
      )}
    </div>
  </main>
</Layout>
