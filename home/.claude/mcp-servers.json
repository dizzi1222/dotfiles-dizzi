{
  "_comment": "MCPs de Claude Code (scope user). Sin secretos: ${VAR} se expande en runtime desde ~/.api-keys.sh; $HOME lo sustituye claude-mcp-sync. Aplicar con: claude-mcp-sync",
  "servers": {
    "engram": {
      "type": "stdio",
      "command": "$HOME/.local/bin/engram",
      "args": [
        "mcp",
        "--tools=agent"
      ]
    },
    "figma": {
      "type": "stdio",
      "command": "$HOME/.npm-global/bin/figma-developer-mcp",
      "args": [
        "--stdio"
      ],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_API_KEY}"
      }
    },
    "swissdevjobs": {
      "type": "stdio",
      "command": "$HOME/.local/bin/swissdevjobs-mcp",
      "env": {
        "SDJ_NAME": "Diego Samuel Hardi Santana",
        "SDJ_EMAIL": "diegosamuel042@gmail.com",
        "SDJ_CV": "$HOME/mi_gdrive/Mi unidad/[Clase]/- Curriculum copium [+Certificados]/cv.pdf"
      }
    },
    "n8n": {
      "type": "stdio",
      "command": "$HOME/.local/bin/n8n-mcp-wrapper"
    },
    "shopify": {
      "type": "stdio",
      "command": "$HOME/.local/bin/shopify-mcp",
      "env": {
        "SHOPIFY_ADMIN_TOKEN": "${SHOPIFY_ADMIN_TOKEN}",
        "SHOPIFY_SHOP": "hermesabogados.myshopify.com"
      }
    },
    "composio-connect": {
      "type": "http",
      "url": "https://connect.composio.dev/mcp",
      "headers": {
        "x-api-key": "${COMPOSIO_API_KEY}"
      }
    },
    "postman": {
      "type": "http",
      "url": "https://mcp.postman.com/minimal",
      "headers": {
        "Authorization": "Bearer ${POSTMAN_API_KEY}"
      }
    },
    "rentahuman": {
      "type": "http",
      "url": "https://rentahuman.ai/api/mcp",
      "headers": {
        "x-api-key": "${RENTAHUMAN_API_KEY}"
      }
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "twilio-docs": {
      "type": "http",
      "url": "https://mcp.twilio.com/docs"
    },
    "todoist": {
      "type": "http",
      "url": "https://ai.todoist.net/mcp"
    },
    "gitlab": {
      "type": "http",
      "url": "https://gitlab.com/api/v4/mcp"
    },
    "prisma-postgres": {
      "type": "http",
      "url": "https://mcp.prisma.io/mcp"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "canva": {
      "type": "http",
      "url": "https://mcp.canva.com/mcp"
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "webshare": {
      "type": "http",
      "url": "https://mcp.webshare.io/"
    }
  }
}
