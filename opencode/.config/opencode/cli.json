{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "theme.switch": "<leader>t",
    "variant.list": "<leader>v"
  },
  "plugins": [
    "opencode-subagent-statusline"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "tabs": {
    "mode": "on"
  }
}
