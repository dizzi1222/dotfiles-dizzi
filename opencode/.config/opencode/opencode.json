{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000
  },
  "experimental": {
    "todo": true
  },
  "mcp": {
    "engram": {
      "command": ["/home/diego/.local/bin/engram", "mcp", "--tools=agent"],
      "enabled": true,
      "type": "local"
    },
    "figma": {
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key={env:FIGMA_API_KEY}",
        "--stdio"
      ],
      "enabled": true,
      "type": "local"
    },
    "composio-connect": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true,
      "headers": {
        "x-api-key": "{env:COMPOSIO_API_KEY}"
      }
    },
    "webshare-uk": {
      "type": "local",
      "command": [
        "node",
        "/home/diego/workspace/dataimpulse-mcp/index.js"
      ],
      "environment": {
        "DI_USER": "{env:WS_USER}",
        "DI_PASS": "{env:WS_PASS}",
        "DI_PROXY_HOST": "31.59.20.176",
        "DI_PROXY_PORT": "6754"
      },
      "enabled": true
    },
    "webshare-us": {
      "type": "local",
