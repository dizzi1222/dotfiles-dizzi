{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "engram": {
      "command": ["/home/diego/.local/bin/engram", "mcp", "--tools=agent"],
      "enabled": true,
      "type": "local"
    },
    "figma": {
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key={env:FIGMA_API_KEY}",
        "--stdio"
      ],
      "enabled": true,
      "type": "local"
    },
    "composio-connect": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true,
      "headers": {
        "x-api-key": "{env:COMPOSIO_API_KEY}"
      }
    }
  },
  "plugin": [
    "opencode-gemini-auth@latest",
    "/home/diego/workspace/opencode-discord-rpc"
  ],
  "small_model": "opencode/deepseek-v4-flash-free",
  "provider": {
