{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma": {
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key={env:FIGMA_API_KEY}",
        "--stdio"
      ],
      "enabled": true,
      "type": "local"
    },
    "composio-connect": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true,
      "headers": {
        "x-api-key": "{env:COMPOSIO_API_KEY}"
      }
    }
  },
  "plugin": [
    "/data/data/com.termux/files/home/workspace/opencode-discord-rpc"
  ],
  "theme": "opencode",
  "model": "anthropic/claude-sonnet-4-20250514",
  // "theme": "gemini",
  // "model": "gemini-3-flash-previewi",
  //  "model": "deepseek-chat",
  //  "model": "claude-opus-4-5",
  //  "model": "claude-haiku-4-5",
  //  "model": "claude-sonnet-4-5",
  "autoupdate": true,
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "cors": ["http://localhost:5170"]
  },
  "instructions": [".opencode/rules.md"]
}
