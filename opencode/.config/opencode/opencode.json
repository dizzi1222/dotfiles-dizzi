{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000
  },
  "mcp": {
    "composio-connect": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true,
      "headers": {
        "x-api-key": "{env:COMPOSIO_API_KEY}"
      }
    },
    "engram": {
      "command": [
        "/data/data/com.termux/files/home/.local/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local"
    },
    "figma": {
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key={env:FIGMA_API_KEY}",
        "--stdio"
      ],
      "enabled": true,
      "type": "local"
    },
    "composio-connect": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true,
      "headers": {
        "x-api-key": "{env:COMPOSIO_API_KEY}"
      }
    },
    "dataimpulse": {
      "type": "local",
      "command": [
        "node",
        "/home/diego/workspace/dataimpulse-mcp/index.js"
      ],
      "environment": {
        "DI_USER": "{env:DI_USER}",
        "DI_PASS": "{env:DI_PASS}"
      },
      "enabled": true
    },
    "webshare-uk": {
      "type": "local",
      "command": [
        "node",
        "/home/diego/workspace/dataimpulse-mcp/index.js"
      ],
      "environment": {
        "DI_USER": "{env:WS_USER}",
        "DI_PASS": "{env:WS_PASS}",
        "DI_PROXY_HOST": "31.59.20.176",
        "DI_PROXY_PORT": "6754"
      },
      "enabled": true
    },
    "webshare-us": {
      "type": "local",
      "command": [
        "node",
        "/home/diego/workspace/dataimpulse-mcp/index.js"
      ],
      "environment": {
        "DI_USER": "{env:WS_USER}",
        "DI_PASS": "{env:WS_PASS}",
        "DI_PROXY_HOST": "198.23.243.226",
        "DI_PROXY_PORT": "6361"
      },
      "enabled": true
    }
  },
  "model": "anthropic/claude-sonnet-4-20250514",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "cors": [
      "http://localhost:5170"
    ]
  },
  "theme": "opencode"
