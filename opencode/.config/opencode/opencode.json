{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    }
  },
  "experimental": {
    "todo": true
  },
  "notes": {
    "engram": {
      "project": "dotfiles-dizzi",
      "master_memory": {
        "topic_key": "profile/diego-consolidated",
        "observation_id": 164,
        "sync_id": "obs-80f5b12cc0401d89",
        "description": "Perfil maestro Diego: hardware, OS, agentes, IAs, Neovim IA, workspace, aprendizaje, reglas, OBSOLETO"
      },
      "index_file": "~/dotfiles-dizzi/ENGRAM_INDEX.md",
      "cli_commands": {
        "search": "engram search \"profile/diego-consolidated\" --project dotfiles-dizzi",
        "get": "engram get 164",
        "context": "engram context --project dotfiles-dizzi"
      },
      "mcp_tools": {
        "search": "mem_search({ query: \"profile diego\", project: \"dotfiles-dizzi\" })",
        "get": "mem_get_observation({ id: 164 })",
        "context": "mem_context({ project: \"dotfiles-dizzi\" })"
      },
      "synced_sources": [
        "~/.hermes/memories/USER.md",
        "~/.hermes/memories/MEMORY.md",
        "~/dotfiles-dizzi/home/memoria_diego.zip"
      ],
      "last_sync": "2026-11-20"
    }
  },
  "mcp": {
    "servers": {
      "composio-connect": {
        "type": "remote",
        "url": "https://connect.composio.dev/mcp",
        "headers": {
          "x-api-key": "{env:COMPOSIO_API_KEY}"
        },
        "disabled": false
      },
      "engram": {
        "command": ["/home/diego/.local/bin/engram", "mcp", "--tools=agent"],
        "type": "local",
        "disabled": false
      },
      "figma": {
        "command": [
          "bash",
          "-c",
          "source ~/.api-keys.sh && exec /home/diego/.npm-global/bin/figma-developer-mcp --stdio"
        ],
        "cwd": "/var/home/diego/workspace",
        "type": "local",
        "disabled": false
      },
      "swissdevjobs": {
        "type": "local",
        "command": ["swissdevjobs-mcp"],
        "environment": {
          "SDJ_NAME": "Diego Samuel Hardi Santana",
          "SDJ_EMAIL": "diegosamuel042@gmail.com",
          "SDJ_CV": "/home/diego/mi_gdrive/Mi unidad/[Clase]/- Curriculum copium [+Certificados]/cv.pdf"
        },
        "disabled": false
      },
      "webshare-es": {
        "_comment": "Referencia dataimpulse-mcp: cambiar WS_HOST_*/WS_PORT_* para otra IP. Gestión via proxy-manager skill + webshare CLI.",
        "type": "local",
        "command": [
          "bash",
          "-c",
          "source ~/.api-keys.sh && export DI_USER=\"$WS_USER\" DI_PASS=\"$WS_PASS\" DI_PROXY_HOST=\"$WS_HOST_ES\" DI_PROXY_PORT=\"$WS_PORT_ES\" && exec node /home/diego/workspace/dataimpulse-mcp/index.js"
        ],
        "environment": {
          "PATH": "/home/diego/.local/bin:/home/linuxbrew/.linuxbrew/bin:/home/diego/.npm-global/bin:/usr/local/bin:/usr/bin:/bin"
        },
        "disabled": true
      },
      "todoist": {
        "type": "remote",
        "url": "https://ai.todoist.net/mcp",
        "headers": {
          "Authorization": "Bearer {env:TODOIST_TOKEN}"
        },
        "disabled": false
      },
      "gitlab": {
        "type": "remote",
        "url": "https://gitlab.com/api/v4/mcp",
        "headers": {
          "Authorization": "Bearer {env:GITLAB_TOKEN}"
        },
        "disabled": false
      },
      "postman": {
        "type": "remote",
        "url": "https://mcp.postman.com/minimal",
        "headers": {
          "Authorization": "Bearer {env:POSTMAN_API_KEY}"
        },
        "disabled": false
      },
      "prisma-postgres": {
        "type": "remote",
        "url": "https://mcp.prisma.io/mcp",
        "headers": {
          "Authorization": "Bearer {env:PRISMA_TOKEN}"
        },
        "disabled": false
      },
      "rentahuman": {
        "type": "remote",
        "url": "https://rentahuman.ai/api/mcp",
        "headers": {
          "x-api-key": "{env:RENTAHUMAN_API_KEY}"
        },
        "disabled": false
      },
      "microsoft-learn": {
        "type": "remote",
        "url": "https://learn.microsoft.com/api/mcp",
        "disabled": false
      },
      "twilio-docs": {
        "type": "remote",
        "url": "https://mcp.twilio.com/docs",
        "disabled": false
      },
      "n8n": {
        "type": "local",
        "command": ["/home/diego/.local/bin/n8n-mcp-wrapper"],
        "disabled": false
      },
      "shopify": {
        "type": "local",
        "command": ["/home/diego/.local/bin/shopify-mcp"],
        "environment": {
          "SHOPIFY_ADMIN_TOKEN": "{env:SHOPIFY_ADMIN_TOKEN}",
          "SHOPIFY_SHOP": "hermesabogados.myshopify.com"
        },
        "disabled": false
      }
    }
  },
  "plugins": [
    "opencode-gemini-auth@latest",
