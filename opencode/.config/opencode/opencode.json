{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": false,
    "prune": false,
    "reserved": 10000
  },
  "mcp": {
    "servers": {
      "composio-connect": {
        "type": "remote",
        "url": "https://connect.composio.dev/mcp",
        "headers": {
          "x-api-key": "{env:COMPOSIO_API_KEY}"
        }
      },
      "engram": {
        "type": "local",
        "command": [
          "/data/data/com.termux/files/home/.local/bin/engram",
          "mcp",
          "--tools=agent"
        ]
      },
      "figma": {
        "type": "local",
        "command": [
          "node",
          "/data/data/com.termux/files/home/.npm-global/lib/node_modules/figma-developer-mcp/dist/bin.js",
          "--figma-api-key={env:FIGMA_API_KEY}",
          "--stdio"
        ]
      },
      "webshare-uk": {
        "type": "local",
        "command": [
          "node",
          "/data/data/com.termux/files/home/workspace/dataimpulse-mcp/index.js"
        ],
        "environment": {
          "DI_USER": "{env:WS_USER}",
          "DI_PASS": "{env:WS_PASS}",
          "DI_PROXY_HOST": "31.59.20.176",
          "DI_PROXY_PORT": "6754"
        }
      },
      "webshare-us": {
        "type": "local",
        "command": [
          "node",
          "/data/data/com.termux/files/home/workspace/dataimpulse-mcp/index.js"
        ],
        "environment": {
          "DI_USER": "{env:WS_USER}",
          "DI_PASS": "{env:WS_PASS}",
          "DI_PROXY_HOST": "198.23.243.226",
          "DI_PROXY_PORT": "6361"
        }
      }
    }
  },
  "model": "anthropic/claude-sonnet-4-20250514",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "cors": [
      "http://localhost:5170"
    ]
  },
  "theme": "opencode"
}
