{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    ".opencode/rules.md"
  ],
  "mcp": {
    "composio-connect": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true,
      "headers": {
        "x-api-key": "{env:COMPOSIO_API_KEY}"
      }
    },
    "engram": {
      "command": [
        "/data/data/com.termux/files/home/.local/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true,
      "type": "local"
    },
    "figma": {
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key={env:FIGMA_API_KEY}",
        "--stdio"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "model": "anthropic/claude-sonnet-4-20250514",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true,
    "cors": [
      "http://localhost:5170"
    ]
  },
  "theme": "opencode"
}