// /002 󰫸  windows.kdl
// ═══════════════════════════════════════════════════════════════════════════
// WINDOW RULES (MIGRADO DESDE windows.conf)
// ═══════════════════════════════════════════════════════════════════════════

// Opacidad de editores
window-rule {
    match app-id=r#"^(code-oss|code)$"#
    opacity 0.90
}

window-rule {
    match app-id=r#"^(cursor|Cursor)$"#
    opacity 0.90
}

window-rule {
    match app-id=r#"^(antigravity|Antigravity)$"#
    opacity 0.90
}

// Multimedia players
window-rule {
    match app-id=r#"^(vlc|mpv|feh|sxiv)$"#
    open-floating true
    default-column-width { fixed 664; }
    default-window-height { fixed 400; }
}

// Picture in Picture
window-rule {
    // match title=r#"^(Picture.?in.?[Pp]icture|[Ii]m[aá]gen en [Ii]m[aá]gen|www.twitch.tv_/)$"#
    match title=r#"^(Picture.?in.?[Pp]icture|[Ii]m[aá]gen en [Ii]m[aá]gen)$"#
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 338; }
    opacity 1.0
}

// Nemo desktop
window-rule {
    match app-id=r#"^(nemo-desktop)$"#
    open-maximized true
    open-on-workspace "magic"
    opacity 0.1
}

// Vesktop
window-rule {
    match app-id=r#"^(vesktop|Vesktop)$"#
    open-on-workspace "magic"
}

// LibreOffice
window-rule {
    match title=r#".*Text Import.*"#
    open-floating true
}

window-rule {
    match app-id=r#"^(soffice)$"#
    open-floating true
}

// Satty
window-rule {
    match app-id=r#"^(com\.gabm\.satty)$"#
    open-floating true
    min-width 730
    min-height 300
}

// XDG Desktop Portal
window-rule {
    match app-id=r#"^(xdg-desktop-portal-gtk)$"#
    open-floating true
    default-column-width { fixed 964; }
    default-window-height { fixed 800; }
}

// Waydroid
window-rule {
    match app-id=r#"^([Ww]aydroid|waydroid.com.*)$"#
    open-floating true
    default-column-width { fixed 926; }
    default-window-height { fixed 809; }
    opacity 0.95
}

// GNOME apps
window-rule {
    match app-id=r#"^(Gnome-calculator|org\.gnome\.[cC]alculator)$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(org\.gnome\.Loupe)$"#
    open-floating true
}

window-rule {
    match title=r#"^(Oklch Color Picker|oklch-color-picker)$"#
    open-floating true
}

// Firefox
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id=r#"firefox$"# title=r#"^(Library|About Mozilla Firefox)$"#
    open-floating true
}

// Floating windows
window-rule {
    match app-id=r#"floating"#
    open-floating true
}

window-rule {
    match app-id=r#"YaziTerminal"#
    open-floating true
    default-column-width { proportion 0.4; }
}

window-rule {
    match app-id=r#"^mpv$"#
    open-floating true
}

window-rule {
    match app-id=r#"^KeePassXC$"#
    block-out-from "screencast"
}

window-rule {
    match app-id=r#"^thunar$"# title=r#"^Rename "#
    open-floating true
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Scripts de control del sistema (lanzados vía wm_spawn desde kitty)
window-rule {
    match title=r#"^(PowerOff|Reboot|Suspend)$"#
    open-floating true
    default-column-width { fixed 500; }
    default-window-height { fixed 200; }
}

window-rule {
    match title=r#"^(CleanBoot)$"#
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

window-rule {
    match title=r#"^(NixRebuild)$"#
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 700; }
}

// ═══════════════════════════════════════════════════════════════════════════
// WORKSPACE: MUSIC
// ═══════════════════════════════════════════════════════════════════════════

// Spotify + variantes GUI
window-rule {
    match app-id=r#"^(spotify|Spotify)$"#
    open-on-workspace "music"
}

window-rule {
    match app-id=r#"^(spotube|Spotube)$"#
    open-on-workspace "music"
}

window-rule {
    match app-id=r#"^(dev\.alextren\.Spot)$"#
    open-on-workspace "music"
}

window-rule {
    match title=r#".*[Ss]pot.*"#
    open-on-workspace "music"
}

// YouTube Music
window-rule {
    match app-id=r#"^(youtube-music|com\.github\.th_ch\.youtube_music)$"#
    open-on-workspace "music"
}

window-rule {
    match title=r#".*YouTube Music.*"#
    open-on-workspace "music"
}

// SoundCloud
window-rule {
    match title=r#".*SoundCloud.*"#
    open-on-workspace "music"
}

// Audacious
window-rule {
    match app-id=r#"^(audacious|Audacious)$"#
    open-on-workspace "music"
}

// Rhythmbox
window-rule {
    match app-id=r#"^(org\.gnome\.Rhythmbox3)$"#
    open-on-workspace "music"
}

// Strawberry
window-rule {
    match app-id=r#"^(strawberry)$"#
    open-on-workspace "music"
}

// Lollypop
window-rule {
    match app-id=r#"^(org\.gnome\.Lollypop)$"#
    open-on-workspace "music"
}

// Reproductores TUI (corren dentro de kitty — timing issue, mejor usar script)
window-rule {
    match title=r#"^kew$"#
    open-on-workspace "music"
}

window-rule {
    match title=r#".*ncspot.*"#
    open-on-workspace "music"
}

window-rule {
    match title=r#".*cmus.*"#
    open-on-workspace "music"
}

window-rule {
    match title=r#".*ncmpcpp.*"#
    open-on-workspace "music"
}

window-rule {
    match title=r#".*musikcube.*"#
    open-on-workspace "music"
}

window-rule {
    match title=r#".*spotify.?player.*"#
    open-on-workspace "music"
}

// Visualizadores
window-rule {
    match app-id=r#"^(GLava)$"#
    open-on-workspace "music"
}

window-rule {
    match title=r#".*cava.*"#
    open-on-workspace "music"
}

window-rule {
    match title=r#"^vis$"#
    open-on-workspace "music"
}

// Rounded corners para todas las ventanas
window-rule {
    geometry-corner-radius 2
    clip-to-geometry true
}

