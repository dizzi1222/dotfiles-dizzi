;; Eww System Menu — grid estático completo. Buscador decorativo (sin filtrado).
;; ESTILOS INLINE (`:css` en el box raíz) — NO dependen de scss/imports/paleta externos.
;; Navegación: Tab/Enter con :focusable. Generado desde system-menu-manifest.tsv.

(defwindow system-menu
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "760px" :anchor "center")
  :stacking "fg"
  :focusable "ondemand"
  :windowtype "normal"
  :wm-ignore true
  (system-grid))

(defwidget system-grid []
  (box :class "sys-menu" :orientation "vertical" :space-evenly "false"
       :style "background-color: #070711; border: 1px solid #5e5ba2; border-radius: 14px; padding: 18px; margin: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.6);"
       :css "  .sys-menu { background-color: #070711; border: 1px solid #5e5ba2;
              border-radius: 14px; padding: 18px; margin: 12px;
              box-shadow: 0 8px 24px rgba(0,0,0,0.6); }
  .sys-search { background-color: #16162a; border-radius: 8px; padding: 8px 12px;
                margin: 0 0 8px 0; color: #c1c1c3; font-size: 13pt;
                font-family: \"Iosevka\"; }
  .sys-cat { color: #a197dd; font-size: 10pt; font-weight: bold;
             letter-spacing: 1px; margin: 6px 0 2px 4px; }
  .sys-row { margin: 2px 0; }
  .sys-btn { background-color: #16162a; border-radius: 10px; padding: 10px 14px; margin: 3px; }
  .sys-btn:focus  { background-color: #5e5ba2; border: 1px solid #c1c1c3; }
  .sys-btn:hover  { background-color: #2b2b52; }
  .sys-btn-box    { spacing: 10px; }
  .sys-btn-icon   { font-family: \"Iosevka Nerd Font\"; font-size: 20pt;
                    color: #c1c1c3; min-width: 28px; margin: 0; }
  .sys-btn-label  { font-family: \"Iosevka\"; font-size: 11pt; color: #c1c1c3; }
  .sys-btn-chev   { font-family: \"Iosevka Nerd Font\"; font-size: 11pt;
                    color: #5e5ba2; margin-left: auto; }"
    (input :class "sys-search" :onchange "true" :placeholder "Buscar…")
    (label :class "sys-cat" :text "Apps")
    (box :class "sys-row" :orientation "horizontal" :space-evenly "true"
      (button :class "sys-btn" :onclick "~/.config/eww/scripts/system-menu-click.sh "
        (box :class "sys-btn-box" :orientation "horizontal" :space-evenly "false" :spacing "10"
          (label :class "sys-btn-icon" :text "")
          (label :class "sys-btn-label" :text "TV/Nix" :hexpand "true" :halign "start")
          (label :class "sys-btn-chev" :text "" :halign "end")))
      (button :class "sys-btn" :onclick "~/.config/eww/scripts/system-menu-click.sh 󰺐"
