    PHONE_ON=1
    echo -e "${GREEN}Celular detectado${RESET}\n"
else
    echo -e "${YELLOW}⚠ Sin celular conectado — solo instalación de mods en PC (sync de saves omitido)${RESET}\n"
fi

# ── Buscar save en el telefono (solo con celular) ─────────────
PHONE_SOURCE=""
if [ "$PHONE_ON" -eq 1 ]; then
  if adb shell "ls -d '$ANDROID_SAVE_SMPI/Diego_339177434'" &>/dev/null; then
    PHONE_SOURCE="$ANDROID_SAVE_SMPI/Diego_339177434"
    echo -e "${GREEN}📁 Save encontrado en: Android SMAPI${RESET}\n"
  elif adb shell "ls -d '$ANDROID_SAVE_VANILLA/Diego_339177434'" &>/dev/null; then
    PHONE_SOURCE="$ANDROID_SAVE_VANILLA/Diego_339177434"
