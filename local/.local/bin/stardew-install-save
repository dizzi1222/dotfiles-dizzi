# ── Modpack opcional rem (POST Fase 3): Sydney Portraits ────────────────
if [ -d "$MODPACK_STAGING/fase3-sydney" ] || [ -f "$HOME/Descargas/Sydney portraits-38486-1-0-0-1760283704.zip" ]; then
  local_sydney_zip="$HOME/Descargas/Sydney portraits-38486-1-0-0-1760283704.zip"
  echo -e "${DIM}── Modpack rem: Sydney Portraits (38486) ─────────${RESET}\n"
  echo -e "  · zip: $([ -f "$local_sydney_zip" ] && echo 'presente (Descargas)' || echo 'requiere descarga manual')"
  if gum confirm "¿Instalar Sydney portraits (38486) y aplicar?"; then
    # registrar en staging opcional
    mkdir -p "$MODPACK_STAGING/fase3-sydney"
    [ -f "$local_sydney_zip" ] && cp -n "$local_sydney_zip" "$MODPACK_STAGING/fase3-sydney/"
    asset_drop_apply "sydney-portraits"
    echo -e "${GREEN}✅ Sydney Portraits instalado (pack rem, opcional)${RESET}"
  fi
  echo ""
fi

# ── Modpack rem (POST Fase 3): Juliet & Jessie (Joja Clerks) + Date mods ──
if [ -d "$MODPACK_STAGING/fase3-julietjessie" ] || [ -d "$MODPACK_STAGING/fase3-date" ]; then
  echo -e "${DIM}── Modpack rem: Juliet & Jessie + Date mods ───────${RESET}\n"
  # Juliet & Jessie (Joja Clerks) — Opción A recomendada (sin pisar FadeHeim)
  if gum confirm "¿Instalar Juliet & Jessie (NPC) con portraits anime SOLO base (Opción A, no pisa FadeHeim)?"; then
    echo -e "${CYAN}ℹ️  NOTA (marriables reales): Juliet, Jessie, Caroline, Robin, Jodi, Qingfeng, Nora, Lannah, Lantana y Rasmodia (Wizard→Rasmodia) son marriables. Requieren HEARTS + EVENTO DE CORTEJO (8-10 corazones) para aparecer en el social. NO marriables: Rosa, Edith, Susan, Josephine, Beatrice, Evelyn y la mayoría de 'viejas' (sin mod de date hoy).${RESET}"
    TMPJJ="$(mktemp -d)"
    # NPC base 6398
    if unzip -o -q "$MODPACK_STAGING/fase3-julietjessie/Juliet and Jessie-6398-1-5-6-1728982422.zip" -d "$TMPJJ/" 2>/dev/null; then
      for d in "$TMPJJ"/*/; do
        [ -d "$d" ] && { b="$(basename "$d")"; rm -rf "$WINE_MODS/$b"; cp -r "$d" "$WINE_MODS/$b"; echo -e "${GREEN}✅ Juliet&Jessie base ← $b${RESET}"; }
      done
    fi
    # req DaisyNiko Tilesheets 4736
    if unzip -o -q "$MODPACK_STAGING/fase3-julietjessie/DaisyNiko's Tilesheets-4736-1-12-1771473826.zip" -d "$TMPJJ/" 2>/dev/null; then
      for d in "$TMPJJ"/*/; do
        [ -d "$d" ] && { b="$(basename "$d")"; rm -rf "$WINE_MODS/$b"; cp -r "$d" "$WINE_MODS/$b"; echo -e "${GREEN}✅ DaisyNiko req ← $b${RESET}"; }
      done
    fi
    # overlay Anime Portraits for Juliet 34022 (opción A: dentro del base)
    if unzip -o -q "$MODPACK_STAGING/fase3-julietjessie/Anime Portraits for Juliet-34022-0-1-1-1757203212.zip" -d "$TMPJJ/" 2>/dev/null; then
      JJSRC="$(find "$TMPJJ" -type d -name "Portraits" | head -1)"
      if [ -n "$JJSRC" ]; then
        cp -r "$JJSRC/." "$WINE_MODS/[CP] Juliet & Jessie (1.6)/assets/Portraits/"
        echo -e "${GREEN}✅ Anime portraits Juliet overlay (Opción A)${RESET}"
      fi
    fi
    rm -rf "$TMPJJ"
    # Opción B (opcional): si el usuario quiere el asset East Scarp 15802 (pisa FadeHeim)
    if gum confirm "¿Aplicar TAMBIÉN el asset East Scarp 15802 (pisará a FadeHeim en Juliet/Jessie)?"; then
      TMPJJ2="$(mktemp -d)"
      unzip -o -q "$MODPACK_STAGING/fase3-julietjessie/Juliet and Jessie portraits mod East Scarp-15802-1-5-1678476957.zip" -d "$TMPJJ2/" 2>/dev/null
      ES_JONES="$(find "$WINE_MODS/East Scarp NPCs" -type d -name "Juliet" 2>/dev/null | head -1)"
      # el asset usa 'Juliet/1/...' — copiar a East Scarp NPCs según su layout si existe destino
      dst_es="$(dirname "$WINE_MODS/East Scarp NPCs/assets/CharacterFiles/Portraits")"
      [ -d "$dst_es" ] && { cp -r "$TMPJJ2"/* "$dst_es/" 2>/dev/null; echo -e "${YELLOW}⚠ 15802 copiado a East Scarp (puede requerir layout: Juliet/1/ = events)${RESET}"; }
      rm -rf "$TMPJJ2"
      echo -e "${RED}⚠ 15802 instalado — pisa a FadeHeim para Juliet/Jessie${RESET}"
    else
      echo -e "${GREEN}→ Opción A confirmada: 15802 NO instalado (FadeHeim intacto)${RESET}"
    fi
  fi
  echo ""
  # Date mods (Rasmodia gana sobre Wizard)
  if gum confirm "¿Instalar Date mods (Looking for Love + reqs + Dateable Caroline/Jodi)? Rasmodia seguirá ganando el Wizard."; then
    TMPDT="$(mktemp -d)"
    # ResponseCore 8284 + HugsKisses 21019 + Looking for Love 21370
    for z in "$MODPACK_STAGING/fase3-date/MissCoriel's Unique Courtship Response CORE 8284"*.zip \
             "$MODPACK_STAGING/fase3-date/Hugs And Kisses Continued-21019"*.zip \
             "$MODPACK_STAGING/fase3-date/looking for love redux-21370"*.zip; do
      [ -f "$z" ] || continue
      unzip -o -q "$z" -d "$TMPDT/" 2>/dev/null
    done
    # Dateable Caroline (rar) con unrar si disponible
    unrar_bin="$(command -v unrar-free || true)"
    if [ -n "$unrar_bin" ]; then
      "$unrar_bin" x -o+ "$MODPACK_STAGING/fase3-date/Dateable Caroline for 1.6.0-15532-1-2-1-1712601878.rar" "$TMPDT/" >/dev/null 2>&1
    else
      z78="$(find /nix/store -maxdepth 4 -name unrar-free -type f 2>/dev/null | head -1)"
      [ -n "$z78" ] && "$z78" x -o+ "$MODPACK_STAGING/fase3-date/Dateable Caroline for 1.6.0-15532-1-2-1-1712601878.rar" "$TMPDT/" >/dev/null 2>&1
    fi
    # Datable Jodi
    unzip -o -q "$MODPACK_STAGING/fase3-date/Dateable Jodi 1.3-7721-1-3-1656081323.zip" -d "$TMPDT/" 2>/dev/null
    # sanitizar JSON de Dateable Caroline (el autor dejó // en manifest + trailing commas) — evita skip por manifest inválido
    CARRAR=5; python3 -c "import json,sys; json.load(open('$TMPDT/[CP] Dateable Caroline/manifest.json'))" 2>/dev/null || python3 - << 'PY'
import json
p="/tmp/opencode/caroline_manifest_patch.json"
d={
  "Name":"Dateable Caroline",
  "Author":"sy_mokarin & MamaNachona",
  "Version":"1.2.1",
  "Description":"A mod that lets you date (and marry) Caroline.",
  "UniqueID":"Nachona.DateableCaroline",
  "UpdateKeys":[],
  "ContentPackFor":{"UniqueID":"Pathoschild.ContentPatcher"}
}
json.dump(d,open(p,"w"),indent=2,ensure_ascii=False)
PY
    # si el manifest no parsea, reemplazarlo
    if ! python3 -c "import json,sys; json.load(open('$TMPDT/[CP] Dateable Caroline/manifest.json'))" 2>/dev/null; then
      cp /tmp/opencode/caroline_manifest_patch.json "$TMPDT/[CP] Dateable Caroline/manifest.json"
      echo -e "${YELLOW}⚠ Manifest Dateable Caroline sanitizado (autor dejó // inválido)${RESET}"
    fi
    # mover todo
    for d in "$TMPDT"/*/; do
      [ -d "$d" ] || continue
      b="$(basename "$d")"
      case "$b" in
        "[CP] Looking for Love"|"[H&K] Looking for Love"|"ResponseCore"|"HugsAndKisses"|"[CP] Dateable Caroline"|"[CP] Datable Jodi")
          rm -rf "$WINE_MODS/$b"; cp -r "$d" "$WINE_MODS/$b"; echo -e "${GREEN}✅ Date ← $b${RESET}"
          ;;
      esac
    done
    rm -rf "$TMPDT"
  fi
  echo ""
fi

# ── Modpack rem (POST): Grupo A (date-night/robin/lantana/nora/qingfeng/aideen/lannah/FS) ──
if [ -d "$MODPACK_STAGING/fase3-rem-mods" ]; then
  echo -e "${DIM}── Modpack rem: extras (DateNight/Robin/Lantana/Nora/Qingfeng/Aideen/Lannah/FS) ──${RESET}\n"
  if gum confirm "¿Instalar los extras de rem-mods (Date Night Redux, Dateable Robin+ES, Lantana, Nora, Qingfeng, Aideen, Lannah, Fashion Closet)?"; then
    TMPR="$(mktemp -d)"; UNRAR_BIN="$(command -v unrar-free || find /nix/store -maxdepth 4 -name unrar-free -type f 2>/dev/null | head -1)"
    # Date Night Redux base
    for z in "$MODPACK_STAGING"/fase3-rem-mods/Date\ Night\ Redux\ 22714*.zip; do
      [ -f "$z" ] && unzip -o -q "$z" -d "$TMPR/" 2>/dev/null
    done
    # merge DateSpanish del 14833
    TMPR2="$(mktemp -d)"
    for z in "$MODPACK_STAGING"/fase3-rem-mods/Date\ Night\ Redux\ \(2.3.4\)*.zip; do
      [ -f "$z" ] && unzip -o -q "$z" -d "$TMPR2/" 2>/dev/null
    done
    # Dateable Robin + ES + Lantana + Nora + Qingfeng + Aideen + Lannah + FS (zip y rar)
    for z in "$MODPACK_STAGING"/fase3-rem-mods/*.zip; do
      [ -f "$z" ] || continue
      case "$(basename "$z")" in
        *22714*|*\(2.3.4\)*) ;;  # ya extraído Date Night
        *) unzip -o -q "$z" -d "$TMPR/" 2>/dev/null ;;
      esac
    done
    for rz in "$MODPACK_STAGING"/fase3-rem-mods/*.rar; do
      [ -f "$rz" ] && [ -n "$UNRAR_BIN" ] && "$UNRAR_BIN" x -o+ "$rz" "$TMPR/" >/dev/null 2>&1
    done
    # mover todas las carpetas top-level a Mods
    move_tmp_to_mods() { for d in "$1"/*/; do [ -d "$d" ] || continue; b="$(basename "$d")"; [ "$b" = __MACOSX ] && continue; rm -rf "$WINE_MODS/$b"; cp -r "$d" "$WINE_MODS/$b"; echo -e "${GREEN}  ✓ $b${RESET}"; done; }
    move_tmp_to_mods "$TMPR"
    # DateSpanish del 14833 → dentro de [CP] Date Night Redux
    [ -d "$TMPR2/DateSpanish" ] && cp -r "$TMPR2/DateSpanish" "$WINE_MODS/[CP] Date Night Redux/" && echo -e "${GREEN}  ✓ DateSpanish anexado${RESET}"
    # es.json de Nora/Qingfeng al i18n del [CP] (aplanar)
    for n in "[NPC] Nora the Herpetologist v.2.9.2 ESR/[CP] The Herpetologist" "Qingfeng/[CP]Qingfeng"; do
      esf="$(find "$WINE_MODS/$n" -maxdepth 1 -iname es.json 2>/dev/null | head -1)"
      if [ -n "$esf" ]; then mkdir -p "$WINE_MODS/$n/i18n"; mv "$esf" "$WINE_MODS/$n/i18n/"; echo -e "${GREEN}  ✓ es.json → $n/i18n/${RESET}"; fi
    done
    rm -rf "$TMPR" "$TMPR2"
    echo -e "${GREEN}✅ Extras rem-mods instalados${RESET}"
  fi
  echo ""
fi

