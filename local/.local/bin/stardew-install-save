#!/bin/bash

PHONE_DOWNLOAD="/sdcard/Download/Diego_339177434"
PHONE_MODS="/sdcard/Download/DIZZI WORLD APES-1.6.15/overrides/mods"
ANDROID_SAVE_SMPI="/sdcard/Android/data/abc.smapi.gameloader/files/Saves"
ANDROID_SAVE_VANILLA="/sdcard/Android/data/com.chucklefish.stardewvalley/files/Saves"
ANDROID_MODS="/sdcard/Android/data/abc.smapi.gameloader/files/mods"
WINE_SAVE="$HOME/.wine/drive_c/users/diego/AppData/Roaming/StardewValley/Saves"
MODPACK_DRIVE="https://drive.google.com/drive/u/0/folders/1hjuhPKr_mV_gZpubSxdz-CMkCbL46wVC"

CYAN='\033[96m'
GREEN='\033[92m'
YELLOW='\033[93m'
RED='\033[91m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

clear
echo -e "\n${CYAN}${BOLD}╔══════════════════════════════════════════════╗${RESET}"
echo -e "${CYAN}${BOLD}║     Stardew Valley Sync PC ↔ Android        ║${RESET}"
echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════╝${RESET}\n"

echo -e "${BOLD}PREREQUISITOS:${RESET}\n"
echo -e "  1. Descarga ${BOLD}DIZZI WORLD APES-1.6.15${RESET} en Drive:"
echo -e "     ${CYAN}$MODPACK_DRIVE${RESET}"
echo -e "     Cópialo a ${BOLD}Downloads${RESET} del telefono\n"
echo -e "  2. Pon tu save en ${BOLD}Downloads${RESET} del telefono"
echo -e "     (carpeta Diego_339177434)\n"
echo -e "${DIM}──────────────────────────────────────────────${RESET}\n"

if ! adb devices | grep -q "device$"; then
    echo -e "${RED}❌ No hay celular conectado${RESET}"
    exit 1
fi

echo -e "${GREEN}Celular detectado${RESET}\n"

# ── Buscar save en el telefono ────────────────────────────────
PHONE_SOURCE=""
if adb shell "ls -d '$PHONE_DOWNLOAD'" &>/dev/null; then
    PHONE_SOURCE="$PHONE_DOWNLOAD"
    echo -e "${GREEN}📁 Save encontrado en: Downloads${RESET}\n"
elif adb shell "ls -d '$ANDROID_SAVE_SMPI/Diego_339177434'" &>/dev/null; then
    PHONE_SOURCE="$ANDROID_SAVE_SMPI/Diego_339177434"
    echo -e "${GREEN}📁 Save encontrado en: Android SMAPI${RESET}\n"
elif adb shell "ls -d '$ANDROID_SAVE_VANILLA/Diego_339177434'" &>/dev/null; then
    PHONE_SOURCE="$ANDROID_SAVE_VANILLA/Diego_339177434"
    echo -e "${GREEN}📁 Save encontrado en: Android Vanilla${RESET}\n"
else
    echo -e "${RED}❌ No se encontro el save en ninguna ubicacion del telefono${RESET}\n"
    exit 1
fi

# ── Phone → Android SMAPI/Vanilla ─────────────────────────────
echo -e "${DIM}── Phone → Android SMAPI ──────────────────────${RESET}\n"

if gum confirm "¿Copiar saves a Android SMAPI?"; then
    adb shell "mkdir -p '$ANDROID_SAVE_SMPI' && cp -r '$PHONE_SOURCE' '$ANDROID_SAVE_SMPI/'"
    echo -e "${GREEN}✅ Saves → Android SMAPI${RESET}\n"
fi

if gum confirm "¿Copiar saves a Android Vanilla?"; then
    adb shell "mkdir -p '$ANDROID_SAVE_VANILLA' && cp -r '$PHONE_SOURCE' '$ANDROID_SAVE_VANILLA/'"
    echo -e "${GREEN}✅ Saves → Android Vanilla${RESET}\n"
fi

if gum confirm "¿Copiar mods a Android SMAPI?"; then
    adb shell "mkdir -p '$ANDROID_MODS' && cp -r '$PHONE_MODS'/* '$ANDROID_MODS/'"
    echo -e "${GREEN}✅ Mods → Android SMAPI${RESET}\n"
fi

# ── Phone → Windows ───────────────────────────────────────────
echo -e "${DIM}── Phone → Windows ──────────────────────────${RESET}\n"

if gum confirm "¿Copiar saves del telefono a Windows? (reemplaza lo actual)"; then
    mkdir -p "$WINE_SAVE"
    rm -rf "$WINE_SAVE/Diego_339177434"
    adb pull "$PHONE_SOURCE" "$WINE_SAVE/" 2>/dev/null
    echo -e "${GREEN}✅ Phone → Windows${RESET}\n"
fi

# ── Windows → Android SMAPI/Vanilla ───────────────────────────
echo -e "${DIM}── Windows → Android SMAPI/Vanilla ────────────${RESET}\n"

if gum confirm "¿Copiar saves de Windows a Android SMAPI?"; then
    adb shell "mkdir -p '$ANDROID_SAVE_SMPI'"
    adb push "$WINE_SAVE/Diego_339177434" "/sdcard/Android/data/abc.smapi.gameloader/files/Saves/" 2>/dev/null
    echo -e "${GREEN}✅ Windows → Android SMAPI${RESET}\n"
fi

if gum confirm "¿Copiar saves de Windows a Android Vanilla?"; then
    adb shell "mkdir -p '$ANDROID_SAVE_VANILLA'"
    adb push "$WINE_SAVE/Diego_339177434" "/sdcard/Android/data/com.chucklefish.stardewvalley/files/Saves/" 2>/dev/null
    echo -e "${GREEN}✅ Windows → Android Vanilla${RESET}\n"
fi

# ── Windows → Phone Downloads ─────────────────────────────────
echo -e "${DIM}── Windows → Phone Downloads ──────────────────${RESET}\n"

if gum confirm "¿Copiar saves de Windows a Downloads del telefono? (reemplaza lo actual)"; then
    adb shell "rm -rf '$PHONE_DOWNLOAD'"
    adb shell "mkdir -p '/sdcard/Download'"
    adb push "$WINE_SAVE/Diego_339177434" "/sdcard/Download/" 2>/dev/null
    echo -e "${GREEN}✅ Windows → Phone Downloads${RESET}\n"
fi

# ── Abrir carpeta Windows ─────────────────────────────────────
echo -e "${DIM}──────────────────────────────────────────────${RESET}\n"

if gum confirm "¿Abrir carpeta de saves de Windows?"; then
    mkdir -p "$WINE_SAVE"
    setsid nemo "$WINE_SAVE" &>/dev/null &
fi

# ── Verificar ─────────────────────────────────────────────────
echo -e "${DIM}──────────────────────────────────────────────${RESET}"
echo -e "${BOLD}Verificación:${RESET}\n"

echo -e "${CYAN}Phone Downloads:${RESET}"
adb shell "ls '$PHONE_DOWNLOAD'" 2>/dev/null | head -5 || echo -e "  ${RED}No existe${RESET}"
echo ""

echo -e "${CYAN}Android SMAPI:${RESET}"
adb shell "ls '$ANDROID_SAVE_SMPI/Diego_339177434/'" 2>/dev/null | head -5
echo ""

echo -e "${CYAN}Android Vanilla:${RESET}"
adb shell "ls '$ANDROID_SAVE_VANILLA/Diego_339177434/'" 2>/dev/null | head -5
echo ""

echo -e "${CYAN}Windows:${RESET}"
if [ -d "$WINE_SAVE/Diego_339177434" ]; then
    ls "$WINE_SAVE/Diego_339177434/" 2>/dev/null | head -5
else
    echo -e "  ${RED}No existe${RESET}"
fi
echo -e "${DIM}──────────────────────────────────────────────${RESET}\n"
