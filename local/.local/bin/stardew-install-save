  elif adb shell "ls -d '$PHONE_DOWNLOAD'" &>/dev/null; then
    PHONE_SOURCE="$PHONE_DOWNLOAD"
    echo -e "${GREEN}📁 Save encontrado en: Downloads${RESET}\n"
  else
    echo -e "${RED}❌ No se encontro el save en ninguna ubicacion del telefono${RESET}\n"
    exit 1
  fi
  log "SOURCE=$PHONE_SOURCE"
else
  echo -e "${DIM}  (sin celular) búsqueda de save omitida${RESET}\n"
fi

