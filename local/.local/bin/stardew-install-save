    if [ -d "$WINE_MODS" ]; then
        # Push por-carpeta con phone_push_dir (resuelve el symlink Assets de SVE, #605).
        adb shell "mkdir -p '$ANDROID_MODS'" || { echo -e "${RED}❌ mkdir Android falló${RESET}"; log "FAIL Mods Android <- $WINE_MODS"; }
        _pfail=0 _ppushed=0
        # shellcheck disable=SC2034
        for _m in "$WINE_MODS"/*; do
          [ -e "$_m" ] || continue
          _pb="$(basename "$_m")"
          if phone_push_dir "$_pb"; then
            _ppushed=$((_ppushed + 1))
          else
            echo -e "${RED}❌ FALLO push Android: $_pb${RESET}"
            _pfail=1
          fi
        done
        if [ "$_pfail" -eq 0 ]; then
            echo -e "${GREEN}✅ Mods PC → Android SMAPI ($_ppushed carpetas)${RESET}\n"
            log "OK Mods Android <- $WINE_MODS"
            # Excepciones Android: el fork SMAPI-Android no soporta/crashea estos mods.
            # Aplicar SIEMPRE tras cada push global (el push los vuelve a copiar).
            android_exclude_all
            echo -e "${DIM}  exclusiones Android aplicadas.${RESET}\n"
        else
            echo -e "${RED}❌ FALLO al copiar mods PC → Android SMAPI (hubo errores)${RESET}\n"
            log "FAIL Mods Android <- $WINE_MODS"
        fi
    else
        echo -e "${RED}❌ No existe carpeta de mods en PC: $WINE_MODS${RESET}\n"
    fi
  fi
else
  echo -e "${DIM}  (sin celular) push de mods a Android omitido — mods instalados solo en PC${RESET}\n"
fi

