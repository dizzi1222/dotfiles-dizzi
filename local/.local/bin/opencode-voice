#!/data/data/com.termux/files/usr/bin/bun
/**
 * opencode-voice — dictado por voz para OpenCode.
 *
 * Graba con PipeWire, PulseAudio o ALSA, segmenta por silencio (VAD por RMS
 * adaptativo) y transcribe cada frase con Gemini (o OpenAI Whisper), emitiendo
 * NDJSON por stdout para que el plugin TUI lo consuma.
 *
 * Uso:
 *   opencode-voice listen              # bucle continuo (NDJSON)
 *   opencode-voice once                # una frase, imprime solo el texto
 *   opencode-voice doctor              # diagnóstico de audio y API
 *   opencode-voice transcribe <wav>    # transcribe un fichero existente
 *
 * Variables de entorno:
 *   VOICE_PROVIDER   gemini | openai        (def. gemini)
 *   VOICE_MODEL      gpt-4o-mini-transcribe | whisper-1 | gemini-2.5-flash
 *   VOICE_LANGUAGE   es | en | ...          (def. es)
 *   VOICE_SILENCE_MS silencio que cierra la frase (def. 700)
 *   VOICE_THRESHOLD  umbral RMS 0..1 forzado (si se omite, adaptativo)
 *   VOICE_DEVICE     dispositivo PipeWire/Pulse (def. @DEFAULT_SOURCE@)
 */
import { spawn, spawnSync } from "node:child_process"
import { accessSync, constants, readFileSync, writeFileSync, existsSync, mkdtempSync, rmSync } from "node:fs"
import { delimiter, dirname, join } from "node:path"

import { tmpdir } from "node:os"
import { fileURLToPath } from "node:url"
const SCRIPT_DIR = dirname(fileURLToPath(import.meta.url))
const RATE = 16000
const CHANNELS = 1
const FRAME_MS = 20
const FRAME_BYTES = (RATE * FRAME_MS) / 1000 * 2 * CHANNELS // 640 bytes
const PREROLL_MS = 300
const MAX_UTTERANCE_MS = 30000
const MIN_UTTERANCE_MS = 350
const START_FRAMES = 5

type Config = {
  provider: "gemini" | "openai" | "faster-whisper"
  model: string
  language: string
  silenceMs: number
  threshold?: number
  device: string
}

const env = process.env
const AUDIO_ENV = { ...env }
delete AUDIO_ENV.LD_LIBRARY_PATH
const config: Config = {
  provider: (env.VOICE_PROVIDER as Config["provider"]) ?? (env.PREFIX?.includes("com.termux") ? "gemini" : "faster-whisper"),
  model:
    env.VOICE_MODEL ??
    (env.VOICE_PROVIDER === "openai" ? "gpt-4o-mini-transcribe" : (env.VOICE_PROVIDER === "gemini" || (!env.VOICE_PROVIDER && env.PREFIX?.includes("com.termux"))) ? "gemini-2.5-flash" : "small"),
  language: env.VOICE_LANGUAGE ?? "es",
  silenceMs: Number(env.VOICE_SILENCE_MS ?? 700),
  threshold: env.VOICE_THRESHOLD ? Number(env.VOICE_THRESHOLD) : undefined,
  device: env.VOICE_DEVICE ?? "@DEFAULT_SOURCE@",
}

function emit(event: Record<string, unknown>) {
  process.stdout.write(JSON.stringify(event) + "\n")
}

function fail(message: string) {
  emit({ type: "error", message })
}

/* ------------------------------- credenciales ------------------------------ */

function apiKey(): string {
  if (config.provider === "openai") {
    const key = env.OPENAI_API_KEY
    if (key) return key
    throw new Error("OPENAI_API_KEY no está definida")
  }
  const key = env.GOOGLE_API_KEY || env.GEMINI_API_KEY
  if (key) return key
  throw new Error("GOOGLE_API_KEY no está definida")
}

function pythonCommand() {
  if (env.OPENCODE_VOICE_PYTHON) return { executable: env.OPENCODE_VOICE_PYTHON, args: [] }
  if (process.platform === "win32") return { executable: "py", args: ["-3.12"] }
  return { executable: "python3", args: [] }
}

let fasterWhisperInstalled
function fasterWhisperReady() {
  if (fasterWhisperInstalled !== undefined) return fasterWhisperInstalled
  const python = pythonCommand()
  const result = spawnSync(python.executable, [...python.args, "-c", "import faster_whisper"], {
    encoding: "utf8",
    windowsHide: true,
    timeout: 10000,
  })
  fasterWhisperInstalled = result.status === 0
  return fasterWhisperInstalled
}

let whisperServer = null
let whisperServerBuffer = ""
let whisperServerReady = null
const whisperPending = []

function rejectWhisperServer(error) {
  whisperServerReady?.reject?.(error)
  whisperServerReady = null
  whisperServer = null
  while (whisperPending.length) whisperPending.shift().reject(error)
}

function ensureWhisperServer() {
  if (whisperServer && whisperServer.exitCode === null) return whisperServerReady.promise
  const helper = join(SCRIPT_DIR, "voice-stt-faster-whisper.py")
  const python = pythonCommand()
  whisperServer = spawn(python.executable, [...python.args, helper, "--server", config.model, config.language], {
    stdio: ["pipe", "pipe", "pipe"],
    windowsHide: true,
    env,
  })
  whisperServerReady = {}
  whisperServerReady.promise = new Promise((resolve, reject) => {
    whisperServerReady.resolve = resolve
    whisperServerReady.reject = reject
  })
  whisperServer.stdout.on("data", (chunk) => {
    whisperServerBuffer += chunk.toString()
    const lines = whisperServerBuffer.split(/\r?\n/)
    whisperServerBuffer = lines.pop() ?? ""
    for (const line of lines) {
      if (!line.trim()) continue
      try {
        const result = JSON.parse(line)
        if (result.ready) {
          whisperServerReady.resolve()
          continue
        }
        const pending = whisperPending.shift()
        if (!pending) continue
        if (result.error) pending.reject(new Error(result.error))
        else pending.resolve(clean(String(result.text ?? "")))
      } catch (error) {
        const pending = whisperPending.shift()
        pending?.reject(error)
      }
    }
  })
  whisperServer.stderr.on("data", (chunk) => {
    if (env.VOICE_DEBUG) emit({ type: "debug", message: chunk.toString().trim() })
  })
  whisperServer.on("error", rejectWhisperServer)
  whisperServer.on("close", (code) => {
    if (code !== 0) rejectWhisperServer(new Error(`faster-whisper terminó con code=${code}`))
  })
  return whisperServerReady.promise
}

function shutdownWhisperServer() {
  if (whisperServer && whisperServer.exitCode === null) whisperServer.kill()
  whisperServer = null
  whisperServerReady = null
  whisperServerBuffer = ""
}


async function transcribeFasterWhisper(wav) {
  if (!fasterWhisperReady()) {
    throw new Error("faster-whisper no está instalado; ejecuta: py -3.12 -m pip install faster-whisper")
  }
  const directory = mkdtempSync(join(tmpdir(), "opencode-voice-whisper-"))
  const path = join(directory, "speech.wav")
  writeFileSync(path, wav)
  try {
    await ensureWhisperServer()
    return await new Promise((resolve, reject) => {
      whisperPending.push({ resolve, reject })
      whisperServer.stdin.write(`${path}\n`)
    })
  } finally {
    // El servidor ya leyó el WAV cuando resuelve la petición; el directorio se
    // elimina después en la cola para no borrar el archivo mientras se procesa.
    setTimeout(() => rmSync(directory, { recursive: true, force: true }), 0).unref?.()
  }
}


/* ---------------------------------- audio --------------------------------- */

/** Envuelve PCM s16le mono en un contenedor WAV. */
function toWav(pcm: Buffer): Buffer {
  const header = Buffer.alloc(44)
  const byteRate = RATE * CHANNELS * 2
  header.write("RIFF", 0)
  header.writeUInt32LE(36 + pcm.length, 4)
  header.write("WAVE", 8)
  header.write("fmt ", 12)
  header.writeUInt32LE(16, 16)
  header.writeUInt16LE(1, 20) // PCM
  header.writeUInt16LE(CHANNELS, 22)
  header.writeUInt32LE(RATE, 24)
  header.writeUInt32LE(byteRate, 28)
  header.writeUInt16LE(CHANNELS * 2, 32)
  header.writeUInt16LE(16, 34)
  header.write("data", 36)
  header.writeUInt32LE(pcm.length, 40)
  return Buffer.concat([header, pcm])
}

function rms(frame: Buffer): number {
  const count = frame.length >> 1
  if (count === 0) return 0
  let sum = 0
  for (let i = 0; i < count; i++) {
    const sample = frame.readInt16LE(i * 2) / 32768
    sum += sample * sample
  }
  return Math.sqrt(sum / count)
}

/* ------------------------------- transcripción ----------------------------- */

async function transcribe(pcm: Buffer, durationMs: number): Promise<string> {
  const wav = toWav(pcm)
  if (config.provider === "faster-whisper") return transcribeFasterWhisper(wav)
  if (config.provider === "openai") {
    const form = new FormData()
    form.append("file", new Blob([wav], { type: "audio/wav" }), "speech.wav")
    form.append("model", config.model)
    form.append("language", config.language)
    form.append("response_format", "json")
    form.append("prompt", "Transcribe literalmente. Puntuación y acentos correctos.")
    const response = await fetch("https://api.openai.com/v1/audio/transcriptions", {
      method: "POST",
      headers: { Authorization: `Bearer ${apiKey()}` },
      body: form,
      signal: AbortSignal.timeout(30000),
    })
    if (!response.ok) throw new Error(`OpenAI ${response.status}: ${(await response.text()).slice(0, 200)}`)
    const data: any = await response.json()
    return String(data.text ?? "").trim()
  }

  const body = {
    contents: [
      {
        parts: [
          {
            text:
              "Transcribe literalmente el audio en " +
              (config.language === "es" ? "español" : config.language) +
              ". Responde SOLO con la transcripción, con puntuación y acentos correctos. " +
              "No añadas comentarios, ni comillas, ni marcas. Si no hay voz inteligible responde exactamente: <silencio>",
          },
          { inline_data: { mime_type: "audio/wav", data: wav.toString("base64") } },
        ],
      },
    ],
    generationConfig: {
      temperature: 0,
      maxOutputTokens: 500,
      thinkingConfig: { thinkingBudget: 0 },
    },
  }
  const response = await fetch(
    `https://generativelanguage.googleapis.com/v1beta/models/${config.model}:generateContent?key=${apiKey()}`,
    {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
      signal: AbortSignal.timeout(30000),
    },
  )
  if (!response.ok) throw new Error(`Gemini ${response.status}: ${(await response.text()).slice(0, 200)}`)
  const data: any = await response.json()
  const text = (data?.candidates?.[0]?.content?.parts ?? [])
    .map((part: any) => part?.text ?? "")
    .join(" ")
    .trim()
  return clean(text)
}

function clean(text: string): string {
  let out = text
    .replace(/<silencio>|<silence>|\[silencio\]|\[silence\]/gi, "")
    .replace(/^```[a-z]*\n?|```$/gi, "")
    .replace(/^["'«“]|["'»”]$/g, "")
    .trim()
  if (/^(silencio|silence|no se detecta voz|ininteligible)\.?$/i.test(out)) out = ""
  return out
}

async function transcribeWithRetry(pcm: Buffer, durationMs: number): Promise<string> {
  let lastError: unknown
  for (let attempt = 1; attempt <= 2; attempt++) {
    try {
      return await transcribe(pcm, durationMs)
    } catch (error) {
      lastError = error
      if (attempt < 2) await new Promise((resolve) => setTimeout(resolve, 250))
    }
  }
  throw lastError
}

/* --------------------------------- captura -------------------------------- */

type Listener = {
  stop: () => Promise<void>
}

interface ICaptureCommand {
  executable: string
  args: string[]
}

/** Resuelve un ejecutable usando PATH sin invocar un shell. */
function findExecutable(command: string): string | null {
  const candidates = command.includes("/")
    ? [command]
    : (process.env.PATH ?? "").split(delimiter).map((directory) => join(directory, command))

  for (const candidate of candidates) {
    try {
      accessSync(candidate, constants.X_OK)
      return candidate
    } catch {}
  }

  return null
}

/** Elige el capturador y los argumentos compatibles con el entorno actual. */
function findCaptureCommand(): ICaptureCommand | null {
  const preferPulse = Boolean(env.WSL_DISTRO_NAME || env.WSL_INTEROP || env.PULSE_SERVER)
  // Termux's pw-record is a compatibility symlink to arecord, not PipeWire.
  const isTermux = env.PREFIX?.includes("com.termux/files/usr") ?? false
  const candidates = isTermux
    ? ["arecord"]
    : preferPulse
      ? ["parec", "pw-record", "arecord"]
      : ["pw-record", "arecord", "parec"]

  for (const command of candidates) {
    const executable = findExecutable(command)
    if (!executable) continue

    if (command === "parec") {
      const args = ["--raw", "--format=s16le", "--rate=16000", "--channels=1"]
      if (env.VOICE_DEVICE && env.VOICE_DEVICE !== "@DEFAULT_SOURCE@") {
        args.push(`--device=${env.VOICE_DEVICE}`)
      }
      return { executable, args }
    }

    if (command === "arecord") {
      return {
        executable,
        args: ["-q", "-f", "S16_LE", "-r", String(RATE), "-c", String(CHANNELS), "-t", "raw", "-"],
      }
    }

    return {
      executable,
      args: ["--rate", String(RATE), "--channels", String(CHANNELS), "--format", "s16", "--latency", "20ms", "-"],
    }
  }

  return null
}

let activeCapture: Listener | null = null
let shuttingDown = false

/** Detiene la captura activa antes de salir del proceso auxiliar. */
async function shutdown(exitCode = 0): Promise<void> {
  if (shuttingDown) return
  shuttingDown = true
  await activeCapture?.stop()
  process.exit(exitCode)
}

/** Inicia un stream PCM y lo separa en frames para el detector de voz. */
function startCapture(
  onFrame: (frame: Buffer) => void,
  onEnd: (reason: string) => void,
): Listener {
  const command = findCaptureCommand()
  if (!command) {
    queueMicrotask(() => onEnd("No encontré parec, pw-record ni arecord"))
    return { stop: () => Promise.resolve() }
  }

  const child = spawn(command.executable, command.args, {
    stdio: ["ignore", "pipe", "pipe"],
    env: { ...process.env, USERMOTDSOURCED: "Y" },
  })
  let pending = Buffer.alloc(0)
  let stopped = false
  let killTimer: ReturnType<typeof setTimeout> | null = null
  let resolveClose: () => void = () => {}
  const closed = new Promise<void>((resolve) => {
    resolveClose = resolve
  })

  child.stdout.on("data", (chunk: Buffer) => {
    pending = pending.length ? Buffer.concat([pending, chunk]) : chunk
    while (pending.length >= FRAME_BYTES) {
      const frame = pending.subarray(0, FRAME_BYTES)
      pending = pending.subarray(FRAME_BYTES)
      onFrame(Buffer.from(frame))
    }
  })
  child.stderr.on("data", (chunk: Buffer) => {
    const message = chunk.toString().trim()
    if (message && process.env.VOICE_DEBUG) emit({ type: "debug", message })
  })
  child.on("error", (error) => onEnd(`spawn: ${error.message}`))
  child.on("exit", (code, signal) => {
    if (!stopped) onEnd(`${command.executable} salió (code=${code} signal=${signal})`)
  })
  child.once("close", () => {
    if (killTimer) clearTimeout(killTimer)
    if (activeCapture === capture) activeCapture = null
    resolveClose()
  })

  const capture: Listener = {
    stop() {
      if (!stopped) {
        stopped = true
        child.kill("SIGINT")
        killTimer = setTimeout(() => child.kill("SIGKILL"), 1000)
      }
      return closed
    },
  }

  activeCapture = capture
  return capture
}

/* ---------------------------------- motor --------------------------------- */

type EngineOptions = { once?: boolean }

function runEngine(options: EngineOptions) {
  let noiseFloor = 0.004
  let noisePeak = 0.01
  let calibrationFrames = 0
  const CALIBRATION_FRAMES = 15  // ~300ms a 50 fps (20ms/frame)
  let speaking = false
  let quietFrames = 0
  let speechFrames = 0
  let buffer: Buffer[] = []
  let preroll: Buffer[] = []
  let utteranceMs = 0
  let busy = false
  let lastLevelAt = 0
  const startedAt = Date.now()

  // Threshold adaptativo: usa config.threshold si se pasa; si no, escala con el ruido medido.
  // En ruido bajo coincide con el umbral sugerido por `doctor` (max(0.01, mediana * 2.5)).
  const thresholdFor = () => {
    if (config.threshold !== undefined) return config.threshold
    if (noiseFloor > 0.3) return noiseFloor + 0.1
    return Math.max(0.01, noiseFloor * 2.5)
  }

  const flush = async (reason: string) => {
    const pcm = Buffer.concat(buffer)
    const durationMs = utteranceMs
    buffer = []
    utteranceMs = 0
    speaking = false
    quietFrames = 0
    speechFrames = 0
    if (durationMs < MIN_UTTERANCE_MS || pcm.length === 0) return
    emit({ type: "utterance_end", durationMs, reason })
    if (busy) {
      emit({ type: "skipped", reason: "busy" })
      return
    }
    busy = true
    emit({ type: "transcribing" })
    try {
      const text = await transcribeWithRetry(pcm, durationMs)
      if (text) emit({ type: "transcript", text, durationMs })
      else emit({ type: "no_speech" })
    } catch (error) {
      fail(error instanceof Error ? error.message : String(error))
    } finally {
      busy = false
      if (options.once) {
        void listener.stop().finally(() => process.exit(0))
      }
    }
  }

  const listener = startCapture(
    (frame) => {
      const level = rms(frame)
      
      // Fase de calibración rápida: calcula noiseFloor inicial en ~300ms
      if (calibrationFrames < CALIBRATION_FRAMES) {
        if (calibrationFrames === 0) {
          noiseFloor = level
        } else {
          noiseFloor = noiseFloor * 0.85 + level * 0.15
        }
        noisePeak = Math.max(noisePeak, level)
        calibrationFrames++
        if (calibrationFrames === CALIBRATION_FRAMES) {
          emit({ type: "calibrated", noiseFloor: Number(noiseFloor.toFixed(4)), threshold: Number(thresholdFor().toFixed(4)) })
        }
        return
      }
      const now = Date.now()
      if (now - lastLevelAt > 100) {
        lastLevelAt = now
        emit({ type: "level", level: Number(level.toFixed(4)), threshold: Number(thresholdFor().toFixed(4)) })
      }

      const loud = level > thresholdFor()
      if (!speaking) {
        preroll.push(frame)
        if (preroll.length > PREROLL_MS / FRAME_MS) preroll.shift()
        if (loud) {
          if (++speechFrames >= START_FRAMES) {
            speaking = true
            quietFrames = 0
            buffer = [...preroll]
            utteranceMs = buffer.length * FRAME_MS
            preroll = []
            emit({ type: "speech_start", at: Date.now() - startedAt })
          }
        } else {
          speechFrames = 0
        }
        return
      }

      buffer.push(frame)
      utteranceMs += FRAME_MS
      if (loud) quietFrames = 0
      else quietFrames++

      if (utteranceMs >= MAX_UTTERANCE_MS) {
        void flush("max_length")
        return
      }
      if (quietFrames * FRAME_MS >= config.silenceMs) void flush("silence")
    },
    (reason) => {
      fail(reason)
      void shutdown(1)
    },
  )

  function calibrating() {
    if (calibrated > 0) return false
    calibrated = 1
    return true
  }

  emit({ type: "ready", provider: config.provider, model: config.model, device: config.device })
  return listener
}

/* --------------------------------- comandos -------------------------------- */

async function transcribeFile(path: string) {
  const raw = readFileSync(path)
  if (raw.subarray(0, 4).toString() === "RIFF") {
    // WAV: se reutiliza tal cual si ya es 16 kHz mono; si no, se convierte.
    const channels = raw.readUInt16LE(22)
    const rate = raw.readUInt32LE(24)
    if (channels === 1 && rate === RATE) {
      const dataStart = raw.indexOf("data") + 8
      const text = await transcribeWithRetry(raw.subarray(dataStart), (raw.length - dataStart) / 2 / RATE * 1000)
      return console.log(text)
    }
    const converted = await convertToPcm(path)
    const text = await transcribeWithRetry(converted, converted.length / 2 / RATE * 1000)
    return console.log(text)
  }
  const text = await transcribeWithRetry(raw, raw.length / 2 / RATE * 1000)
  console.log(text)
}

function convertToPcm(path: string): Promise<Buffer> {
  return new Promise((resolve, reject) => {
    const child = spawn("ffmpeg", ["-v", "error", "-i", path, "-ar", String(RATE), "-ac", "1", "-f", "s16le", "pipe:1"], { env: { ...AUDIO_ENV, USERMOTDSOURCED: "Y" } })
    const chunks: Buffer[] = []
    child.stdout.on("data", (chunk: Buffer) => chunks.push(chunk))
    child.on("error", reject)
    child.on("close", (code) => (code === 0 ? resolve(Buffer.concat(chunks)) : reject(new Error(`ffmpeg salió con ${code}`))))
  })
}

async function doctor() {
  const info: string[] = []
  const push = (line: string) => {
    info.push(line)
    if (process.stdout.isTTY) console.log(line)
  }
  push(`provider=${config.provider} model=${config.model} language=${config.language}`)

  const hasKey = config.provider === "faster-whisper" ? fasterWhisperReady() : config.provider === "openai" ? Boolean(env.OPENAI_API_KEY) : Boolean(env.GOOGLE_API_KEY || env.GEMINI_API_KEY)
  push(`api_key=${hasKey ? "ok" : "MISSING"}`)

  // 4 s de captura para medir el ruido de fondo
  const frames: Buffer[] = []
  await new Promise<void>((resolve) => {
    let capture: Listener
    let stopTimer: ReturnType<typeof setTimeout> | null = null
    const finish = () => {
      if (stopTimer) clearTimeout(stopTimer)
      resolve()
    }
    capture = startCapture(
      (frame) => frames.push(frame),
      (reason) => {
        fail(reason)
        void capture.stop().finally(finish)
      },
    )
    stopTimer = setTimeout(() => {
      void capture.stop().finally(finish)
    }, 4000)
  })
  const levels = frames.map(rms)
  const sorted = [...levels].sort((a, b) => a - b)
  const median = sorted[Math.floor(sorted.length / 2)] ?? 0
  const peak = sorted[sorted.length - 1] ?? 0
  push(`frames=${levels.length} pcm_bytes=${frames.length * FRAME_BYTES}`)
  push(`noise_median=${median.toFixed(4)} peak=${peak.toFixed(4)} sugerido_threshold=${Math.max(0.01, median * 2.5).toFixed(4)}`)

  if (frames.length < 50) {
    push("audio=FAIL (no llegaron muestras; ¿micrófono ocupado o dispositivo incorrecto?)")
    return
  }
  const pcm = Buffer.concat(frames)
  const wav = toWav(pcm)
  const tmpDir = env.TMPDIR || join(env.PREFIX || "/data/data/com.termux/files/usr", "tmp")
  const path = join(tmpDir, "opencode-voice-doctor.wav")
  writeFileSync(path, wav)
  push(`muestra_guardada=${path}`)
  if (!hasKey) return
  const started = Date.now()
  try {
    const text = await transcribe(pcm, (pcm.length / 2 / RATE) * 1000)
    push(`transcripcion_latencia_ms=${Date.now() - started}`)
    push(`transcripcion=${text === "" ? "<vacío>" : text}`)
  } catch (error) {
    push(`transcripcion=ERROR ${error instanceof Error ? error.message : String(error)}`)
  }
}

/* ----------------------------------- main ---------------------------------- */

const [command = "listen", argument] = process.argv.slice(2)

switch (command) {
  case "listen": {
    runEngine({})
    break
  }
  case "once": {
    runEngine({ once: true })
    break
  }
  case "transcribe": {
    if (!argument || !existsSync(argument)) {
      console.error("uso: opencode-voice transcribe <fichero.wav|pcm>")
      process.exit(2)
    }
    try { await transcribeFile(argument) } finally { shutdownWhisperServer() }
    break
  }
  case "doctor": {
    try { await doctor() } finally { shutdownWhisperServer() }
    break
  }
  default: {
    console.error(`comando desconocido: ${command}`)
    console.error("uso: opencode-voice [listen|once|doctor|transcribe <file>]")
    process.exit(2)
  }
}

process.on("SIGTERM", () => {
  void shutdown(0)
})
process.on("SIGINT", () => {
  void shutdown(0)
})

process.on("exit", () => { if (whisperServer) whisperServer.kill() })
