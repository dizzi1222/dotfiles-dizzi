#!/usr/bin/env bash
# clean-boot: limpiador interactivo de /boot — compatible NixOS + Bazzite/Fedora ostree
# Detecta el sistema automáticamente y usa la estrategia correcta.
set -euo pipefail

BOOT="/boot"

# ── Detectar distro ────────────────────────────────────────────────────
if [ -f /etc/os-release ]; then
  . /etc/os-release
  ID="${ID:-}"
  VARIANT_ID="${VARIANT_ID:-}"
else
  ID="unknown"
fi

command -v ncdu >/dev/null || {
  echo "ncdu no está instalado."
  case "$ID" in
    nixos) echo "  nix profile add nixpkgs#ncdu" ;;
    fedora|bazzite|universal-blue) echo "  sudo dnf install ncdu" ;;
    *) echo "  instala ncdu con tu gestor de paquetes" ;;
  esac
  read -r -p "Presiona Enter para cerrar..."
  exit 1
}

echo "=== Estado actual de /boot ==="
df -h "$BOOT"
echo

# ── Kernel actual protegido ───────────────────────────────────────────
echo "=== Kernel ACTUAL (NO SE TOCA) ==="
case "$ID" in
  nixos)
    ENTRIES_DIR="$BOOT/loader/entries"
    CURRENT_INITRD=$(grep -h '^initrd' "$ENTRIES_DIR"/*.conf 2>/dev/null | head -1 | sed 's|.*/||')
    CURRENT_KERNEL=$(grep -h '^linux' "$ENTRIES_DIR"/*.conf 2>/dev/null | head -1 | sed 's|.*/||')
    [ -n "$CURRENT_KERNEL" ] && echo "  initrd: $CURRENT_INITRD"
    [ -n "$CURRENT_KERNEL" ] && echo "  kernel: $CURRENT_KERNEL"
    ;;
  fedora|bazzite|universal-blue)
    # ostree: kernel actual desde /boot/loader/entries (grubby no funciona bien en ostree)
    ls "$BOOT"/loader/entries/*.conf 2>/dev/null | head -5 | xargs -r grep -h '^linux' | sed 's|.*/||' | sort -u | xargs -r -I{} echo "  kernel: {}"
    ls "$BOOT"/loader/entries/*.conf 2>/dev/null | head -5 | xargs -r grep -h '^initrd' | sed 's|.*/||' | sort -u | xargs -r -I{} echo "  initrd: {}"
    ;;
  *)
    grubby --default-kernel 2>/dev/null | sed 's|.*/||' | xargs -r -I{} echo "  kernel: {}" || true
    ;;
esac
echo

# ── Listar kernels viejos según distro ────────────────────────────────
echo "=== Kernels / entradas viejas detectadas ==="
case "$ID" in
  nixos)
    EFI_DIR="$BOOT/EFI/nixos"
    if [ -d "$EFI_DIR" ]; then
      find "$EFI_DIR" -maxdepth 1 -type f \( -name '*.efi' -o -name '*.img' \) ! -name '*.extra-files' -printf '%f\n' 2>/dev/null | sort -V
    fi
    ;;
  fedora|bazzite|universal-blue)
    # ostree deployments
    echo "  Deployments ostree:"
    ls -1 "$BOOT"/ostree/ 2>/dev/null | sed 's/^/    /' || echo "    (ninguno visible)"
    echo "  Bootloader entries:"
    ls -1 "$BOOT"/loader/entries/ 2>/dev/null | sed 's/^/    /' || echo "    (ninguno visible)"
    ;;
  *)
    ls -1 "$BOOT"/ 2>/dev/null | grep -E 'vmlinuz|initramfs|kernel|initrd' | head -20 || true
    ;;
esac
echo

# ── ncdu manual (compatible kitty TERM) ───────────────────────────────
echo "=== ncdu (limpieza manual) ==="
echo "  - Navegá con flechas, 'd' para borrar, 'q' para salir"
echo "  - NO borres nada del kernel actual ni /boot/kernels/ (NixOS) ni /boot/ostree/ (Bazzite)"
read -r -p "ENTER para abrir ncdu..."
sudo TERM=xterm-256color ncdu "$BOOT" 2>/dev/null || sudo ls -la "$BOOT"
echo

# ── Limpieza automática específica por distro ─────────────────────────
case "$ID" in
  nixos)
    echo "=== Generaciones Nix viejas ==="
    if command -v nix-env >/dev/null; then
      nix-env --list-generations -p /nix/var/nix/profiles/system | head -20
      read -r -p "¿Borrar generaciones viejas? (nix-collect-garbage -d) [y/N] " ans
      case "${ans:-N}" in y|Y) sudo nix-collect-garbage -d ;; *) echo "omitido" ;; esac
    fi
    echo "=== Rebuild NixOS ==="
    read -r -p "¿Ejecutar rebuild switch? [y/N] " ans
    case "${ans:-N}" in y|Y)
      [ -d "/home/diego/dotfiles-dizzi/nixconf" ] && cd /home/diego/dotfiles-dizzi/nixconf
      sudo nixos-rebuild switch --flake ".#diego"
      ;;
    esac
    ;;
  fedora|bazzite|universal-blue)
    echo "=== rpm-ostree cleanup ==="
    rpm-ostree status --json 2>/dev/null | python3 -c "
import json,sys
d=json.load(sys.stdin)
for x in d.get('deployments',[]):
    if not x.get('booted') and not x.get('staged'):
        print(x.get('version'))
" | xargs -r -I{} echo "  Rollback disponible: {}"
    read -r -p "¿Eliminar rollback deployment? [y/N] " ans
    case "${ans:-N}" in y|Y) sudo rpm-ostree cleanup -r ;; *) echo "omitido" ;; esac
    echo "=== ujust clean-system ==="
    read -r -p "¿Ejecutar ujust clean-system? [y/N] " ans
    case "${ans:-N}" in y|Y) ujust clean-system ;; *) echo "omitido" ;; esac
    ;;
  *)
    echo "Distro no reconocida para limpieza automática."
    ;;
esac

echo
read -r -p "Presiona Enter para cerrar..."