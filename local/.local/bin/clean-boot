#!/usr/bin/env bash
# clean-boot: limpiador interactivo de /boot para NixOS
# - Protege kernel actual (desde bootloader entries)
# - Detecta y pregunta por kernels viejos en /boot/EFI/nixos/ (excluye .extra-files)
# - ncdu para limpieza manual guiada
# - Borra generaciones Nix viejas (con feedback)
# - Rebuild automático al final
set -euo pipefail

BOOT="/boot"
KERNELS_DIR="$BOOT/kernels"
ENTRIES_DIR="$BOOT/loader/entries"
EFI_DIR="$BOOT/EFI/nixos"
DOTFILES="/home/diego/dotfiles-dizzi/nixconf"
USER="diego"

command -v ncdu >/dev/null || {
  echo "Instalá ncdu: nix profile add nixpkgs#ncdu"
  exit 1
}

echo "=== Estado actual de /boot ==="
df -h "$BOOT"
echo

# Kernel ACTUAL desde bootloader (PROTEGIDO)
CURRENT_INITRD=$(grep -h '^initrd' "$ENTRIES_DIR"/*.conf 2>/dev/null | head -1 | sed 's|.*/||')
CURRENT_KERNEL=$(grep -h '^linux' "$ENTRIES_DIR"/*.conf 2>/dev/null | head -1 | sed 's|.*/||')

echo "=== Kernel ACTUAL (NO SE TOCA) ==="
echo "  initrd: $CURRENT_INITRD"
echo "  kernel: $CURRENT_KERNEL"
echo

# Detectar kernels viejos en EFI (excluyendo .extra-files y kernel actual)
OLD_EFI=()
for f in "$EFI_DIR/"*-linux-*.efi; do
  [ -e "$f" ] || continue
  name=$(basename "$f")
  [[ "$name" == *"$CURRENT_INITRD"* ]] && continue
  [[ "$name" == *"$CURRENT_KERNEL"* ]] && continue
  [[ "$name" == ".extra-files" ]] && continue
  OLD_EFI+=("$name")
done

if [ ${#OLD_EFI[@]} -gt 0 ]; then
  echo "=== Kernels VIEJOS detectados en $EFI_DIR/ ==="
  for f in "${OLD_EFI[@]}"; do
    size=$(du -sh "$EFI_DIR/$f" 2>/dev/null | cut -f1)
    echo "  $size  $f"
  done
  echo
  read -rp "¿Borrar TODOS estos kernels viejos de EFI? [y/N] " -n1
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    for f in "${OLD_EFI[@]}"; do rm -v "$EFI_DIR/$f"; done
  fi
else
  echo "No hay kernels viejos en EFI."
fi
echo

# ncdu guiado
echo "=== ncdu (limpieza manual adicional) ==="
echo "  - Navegá con flechas, 'd' para borrar, 'q' para salir"
echo "  - NO borres nada del kernel actual ni /boot/kernels/"
read -rp "ENTER para abrir ncdu..."
sudo ncdu "$BOOT"
echo

# Generaciones Nix viejas
set +e
CURRENT_GEN=$(readlink -f /nix/var/nix/profiles/system 2>/dev/null | grep -o '[0-9]*$')
OLD_GENS=$(nix-env --list-generations --profile /nix/var/nix/profiles/system 2>/dev/null | awk '{print $1}' | grep -v "^$CURRENT_GEN$")
set -e

if [ -n "$OLD_GENS" ]; then
  echo "=== Generaciones Nix viejas (actual: $CURRENT_GEN) ==="
  echo "$OLD_GENS" | sed 's/^/  /'
  read -rp "¿Borrar generaciones viejas + nix-collect-garbage -d? [y/N] " -n1
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    echo "→ Borrando generaciones viejas..."
    for g in $OLD_GENS; do
      nix-env --delete-generations "$g" --profile /nix/var/nix/profiles/system 2>/dev/null || true
    done
    echo "→ Ejecutando nix-collect-garbage -d (puede tardar)..."
    sudo nix-collect-garbage -d 2>/dev/null || true
    echo "→ Limpieza de store completada."
  fi
else
  echo "No hay generaciones viejas."
fi
echo

# REBUILD AUTOMÁTICO (git como usuario, rebuild como root)
hyprctl dispatch exec "[float; size 1000 700; center] kitty -- sh -c '~/.local/bin/nixconf-rebuild; read -p \"Presiona Enter para cerrar...\"'"

echo
echo "=== Resultado final ==="
df -h "$BOOT"
EOF
chmod +x /home/diego/.local/bin/clean-boot
