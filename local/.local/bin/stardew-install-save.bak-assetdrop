        echo -e "${GREEN}✅ Phone → Windows${RESET}\n"
        log "OK Windows <- $PHONE_SOURCE"
    else
        echo -e "${RED}❌ FALLO Phone → Windows. Restaurando backup...${RESET}\n"
        log "FAIL Windows <- $PHONE_SOURCE"
        restore_save
    fi
fi

# ── Windows → Android SMAPI/Vanilla ───────────────────────────
echo -e "${DIM}── Windows → Android SMAPI/Vanilla ────────────${RESET}\n"

if gum confirm "¿Copiar saves de Windows a Android SMAPI?"; then
    if adb shell "mkdir -p '$ANDROID_SAVE_SMPI'" && adb push "$WINE_SAVE/Diego_339177434" "/sdcard/Android/data/abc.smapi.gameloader/files/Saves/"; then
        echo -e "${GREEN}✅ Windows → Android SMAPI${RESET}\n"
        log "OK Android SMAPI <- Windows"
    else
        echo -e "${RED}❌ FALLO Windows → Android SMAPI${RESET}\n"
        log "FAIL Android SMAPI <- Windows"
    fi
fi

if gum confirm "¿Copiar saves de Windows a Android Vanilla?"; then
    if adb shell "mkdir -p '$ANDROID_SAVE_VANILLA'" && adb push "$WINE_SAVE/Diego_339177434" "/sdcard/Android/data/com.chucklefish.stardewvalley/files/Saves/"; then
        echo -e "${GREEN}✅ Windows → Android Vanilla${RESET}\n"
        log "OK Android Vanilla <- Windows"
    else
        echo -e "${RED}❌ FALLO Windows → Android Vanilla${RESET}\n"
        log "FAIL Android Vanilla <- Windows"
    fi
fi

# ── Windows → Phone Downloads ─────────────────────────────────
echo -e "${DIM}── Windows → Phone Downloads ──────────────────${RESET}\n"

if gum confirm "¿Copiar saves de Windows a Downloads del telefono? (reemplaza lo actual)"; then
    if adb shell "rm -rf '$PHONE_DOWNLOAD'" && adb shell "mkdir -p '/sdcard/Download'" && adb push "$WINE_SAVE/Diego_339177434" "/sdcard/Download/"; then
        echo -e "${GREEN}✅ Windows → Phone Downloads${RESET}\n"
        log "OK Phone Downloads <- Windows"
    else
        echo -e "${RED}❌ FALLO Windows → Phone Downloads${RESET}\n"
        log "FAIL Phone Downloads <- Windows"
    fi
fi

# ── Abrir carpeta Windows ─────────────────────────────────────
echo -e "${DIM}──────────────────────────────────────────────${RESET}\n"

if gum confirm "¿Abrir carpeta de saves de Windows?"; then
    mkdir -p "$WINE_SAVE"
    setsid nemo "$WINE_SAVE" &>/dev/null &
fi


# ── Phone → Android SMAPI/Vanilla ─────────────────────────────
echo -e "${DIM}── Phone → Android SMAPI ──────────────────────${RESET}\n"

if gum confirm "¿Copiar saves a Android SMAPI?"; then
    if adb shell "mkdir -p '$ANDROID_SAVE_SMPI' && cp -r '$PHONE_SOURCE' '$ANDROID_SAVE_SMPI/'"; then
        echo -e "${GREEN}✅ Saves → Android SMAPI${RESET}\n"
        log "OK Android SMAPI <- $PHONE_SOURCE"
    else
        echo -e "${RED}❌ FALLO al copiar a Android SMAPI${RESET}\n"
        log "FAIL Android SMAPI <- $PHONE_SOURCE"
    fi
fi

if gum confirm "¿Copiar saves a Android Vanilla?"; then
    if adb shell "mkdir -p '$ANDROID_SAVE_VANILLA' && cp -r '$PHONE_SOURCE' '$ANDROID_SAVE_VANILLA/'"; then
        echo -e "${GREEN}✅ Saves → Android Vanilla${RESET}\n"
        log "OK Android Vanilla <- $PHONE_SOURCE"
    else
        echo -e "${RED}❌ FALLO al copiar a Android Vanilla${RESET}\n"
        log "FAIL Android Vanilla <- $PHONE_SOURCE"
    fi
fi

if gum confirm "¿Copiar mods del telefono a Android SMAPI?"; then
    if adb shell "mkdir -p '$ANDROID_MODS' && cp -r '$PHONE_MODS'/* '$ANDROID_MODS/'"; then
        echo -e "${GREEN}✅ Mods Phone → Android SMAPI${RESET}\n"
        log "OK Mods Android <- $PHONE_MODS"
    else
        echo -e "${RED}❌ FALLO al copiar mods Phone → Android SMAPI${RESET}\n"
        log "FAIL Mods Android <- $PHONE_MODS"
    fi
fi

if gum confirm "¿Copiar mods de Windows (PC) a Android SMAPI?"; then
    if [ -d "$WINE_MODS" ]; then
        if adb shell "mkdir -p '$ANDROID_MODS'" && adb push -a "$WINE_MODS/." "$ANDROID_MODS/"; then
            echo -e "${GREEN}✅ Mods PC → Android SMAPI${RESET}\n"
            log "OK Mods Android <- $WINE_MODS"
            # Excepciones Android: el fork SMAPI-Android no soporta/crashea estos mods.
            # Aplicar SIEMPRE tras cada push global (el push los vuelve a copiar).
            android_exclude \
                "PolyamorySweetBed" "PolyamorySweetKiss" "PolyamorySweetLove" "PolyamorySweetRooms" \
                "PolyamorySweetWedding" "[CP] Polyamory Sweet" "MEEP" "SpaceCore" "JsonAssets" \
                "[CP] RRRR" "[FS] Magnus Earrings" "[CP] Romanceable Rasmodia - RRRR Patch" \
                "East Scarp: Locations" "East Scarp: NPCs" "East Scarp: C#" "East Scarp: Core" \
                "East Scarp FTM" "ESBarberShop" "ConsoleCommands" "MobilePhone" "SaveBackup" \
                "External-by dizzi~ [CP]Xtardew Portraits&Sprites" "Portraiture" \
                "SpritesInDetail" "FashionSense"
            echo -e "${DIM}  exclusiones Android aplicadas.${RESET}\n"
        else
            echo -e "${RED}❌ FALLO al copiar mods PC → Android SMAPI${RESET}\n"
            log "FAIL Mods Android <- $WINE_MODS"
        fi
    else
        echo -e "${RED}❌ No existe carpeta de mods en PC: $WINE_MODS${RESET}\n"
    fi
fi

# ── Modpacks (Fase 0: base frameworks) ─────────────────────────
echo -e "${DIM}── Modpacks (Fase 0: base) ────────────────────${RESET}\n"
echo -e "${DIM}  Staging: descarga/extrae MODS MANUALES en ${RESET}${CYAN}$MODPACK_STAGING/fase0-base/${RESET}\n"

if [ -d "$MODPACK_STAGING/fase0-base" ]; then
  modpack_report "Fase0-base" "fase0-base" \
    "uid:Esca.FarmTypeManager"                             "Farm Type Manager (FTM)"                                        "https://www.nexusmods.com/stardewvalley/mods/1826" \
    "uid:Parrot.RomRas"                                    "Rasmodia - Female Wizard"                                     "https://www.nexusmods.com/stardewvalley/mods/8265" \
    "uid:Nom0ri.RomRas"                                    "Rasmodia (RRRR patch)"                                        "https://www.nexusmods.com/stardewvalley/mods/18144" \
    "Nexus:28284"                                          "Cross-Mod Compatibility Tokens (CMCT)"                        "https://www.nexusmods.com/stardewvalley/mods/28284" \
    "uid:Mangupix.DialogueDisplayFrameworkContinued"       "Dialogue Display Framework Continued"                         "https://www.nexusmods.com/stardewvalley/mods/22678" \
    "Nexus:44971"                                          "DDFC Scaler"                                                  "https://www.nexusmods.com/stardewvalley/mods/44971" \
    "uid:BleakCodex.SpritesInDetail"                       "Sprites in Detail"                                            "https://www.nexusmods.com/stardewvalley/mods/14487" \
    "Nexus:20599"                                          "PolyamorySweet"                                               "https://www.nexusmods.com/stardewvalley/mods/20599"
fi

if gum confirm "¿Instalar frameworks base y sincronizar? (los ⬇ manual van a $MODPACK_STAGING/fase0-base/)"; then
    modpack_sync "Fase0-base" "fase0-base" \
        "Esca.FarmTypeManager"  "Parrot.RomRas"  "Nom0ri.RomRas" \
        "Nexus:28284"       "Mangupix.DialogueDisplayFrameworkContinued"  "Nexus:44971" \
        "BleakCodex.SpritesInDetail"  "Nexus:20599"
    if [ -d "$MODPACK_STAGING/fase0-base" ]; then
        modpack_push_phone "Fase0-base" "fase0-base"
    fi
fi

# ── Modpacks (Fase 1: SVE / Expanded + Xtardew) ────────────────
echo -e "${DIM}── Modpacks (Fase 1: SVE + Xtardew) ────────────${RESET}\n"

if [ -d "$MODPACK_STAGING/fase1-sve-xtardew" ]; then
  modpack_report "Fase1-SVE-Xtardew" "fase1-sve-xtardew" \
    "uid:FlashShifter.StardewValleyExpandedCP"  "SVE (Expanded) [CP]"            "https://www.nexusmods.com/stardewvalley/mods/3753" \
    "Nexus:30982"                                "Red Panda Bazaar"               "https://www.nexusmods.com/stardewvalley/mods/30982" \
    "Nexus:5787"                                 "East Scarp"                     "https://www.nexusmods.com/stardewvalley/mods/5787" \
    "uid:Pseudodiego.XtardewValley"              "Xtardew Valley (padre)"         "https://www.nexusmods.com/stardewvalley/mods/1839" \
    "Nexus:11867"                                "Xtardew Anime Portrait"         "https://www.nexusmods.com/stardewvalley/mods/11867" \
    "Nexus:7404"                                 "Xtardew Anime Replacers"        "https://www.nexusmods.com/stardewvalley/mods/7404"
fi

if gum confirm "¿Instalar Fase 1 (SVE+Xtardew) y sincronizar?"; then
    modpack_sync "Fase1-SVE-Xtardew" "fase1-sve-xtardew" \
        "uid:FlashShifter.StardewValleyExpandedCP"  "Nexus:30982"  "Nexus:5787" \
        "uid:Pseudodiego.XtardewValley"  "Nexus:11867"  "Nexus:7404"
    if [ -d "$MODPACK_STAGING/fase1-sve-xtardew" ]; then
        modpack_push_phone "Fase1-SVE-Xtardew" "fase1-sve-xtardew"
    fi
fi

# ── Modpacks (Fase 2: Seasonal / Anime base) ────────────────────
echo -e "${DIM}── Modpacks (Fase 2: Seasonal/Anime) ───────────${RESET}\n"

if [ -d "$MODPACK_STAGING/fase2-seasonal-anime" ]; then
  modpack_report "Fase2-Seasonal-Anime" "fase2-seasonal-anime" \
    "Nexus:43012"  "Drawberry's Seasonal Cuter for ESR"         "https://www.nexusmods.com/stardewvalley/mods/43012" \
    "Nexus:16045"  "Seasonal Cute for East Scarp"               "https://www.nexusmods.com/stardewvalley/mods/16045" \
    "Nexus:14158"  "Sydney - Custom NPC"                        "https://www.nexusmods.com/stardewvalley/mods/14158" \
    "Nexus:32228"  "Dacar Rasmodia anime portraits"             "https://www.nexusmods.com/stardewvalley/mods/32228" \
    "Nexus:5969"   "Seasonal Cuter for SVE"                     "https://www.nexusmods.com/stardewvalley/mods/5969" \
    "Nexus:37247"  "FadeHelm East Scarp seasonal portrait"      "https://www.nexusmods.com/stardewvalley/mods/37247" \
    "Nexus:42895"  "FadeHelm Rosa (East Scarp)"                 "https://www.nexusmods.com/stardewvalley/mods/42895" \
    "Nexus:38101"  "FadeHelm Rasmodia portrait"                 "https://www.nexusmods.com/stardewvalley/mods/38101" \
    "Nexus:39518"  "FadeHelm Lavril portrait"                   "https://www.nexusmods.com/stardewvalley/mods/39518" \
    "Nexus:11282"  "Lavril - Spanish"                           "https://www.nexusmods.com/stardewvalley/mods/11282" \
    "Nexus:46956"  "Felicia1L Wizard"                           "https://www.nexusmods.com/stardewvalley/mods/46956" \
    "Nexus:46901"  "Felicia1L Claire"                           "https://www.nexusmods.com/stardewvalley/mods/46901" \
    "Nexus:47618"  "Felicia1L Olivia"                           "https://www.nexusmods.com/stardewvalley/mods/47618" \
    "Nexus:50052"  "Felicia1L Victor"                           "https://www.nexusmods.com/stardewvalley/mods/50052" \
    "Nexus:48156"  "Felicia1L Sophia"                           "https://www.nexusmods.com/stardewvalley/mods/48156" \
    "Nexus:9522"   "SVE High-Res Anime Olivia"                  "https://www.nexusmods.com/stardewvalley/mods/9522" \
    "Nexus:19589"  "Igor's Anime Portraits SDV"                 "https://www.nexusmods.com/stardewvalley/mods/19589" \
    "Nexus:19476"  "Older Jas (Igor)"                           "https://www.nexusmods.com/stardewvalley/mods/19476" \
    "Nexus:19320"  "Igor's female Willy"                        "https://www.nexusmods.com/stardewvalley/mods/19320" \
    "Nexus:19148"  "Igor's Pam"                                 "https://www.nexusmods.com/stardewvalley/mods/19148"
fi

if gum confirm "¿Instalar Fase 2 (Seasonal/Anime) y sincronizar?"; then
    modpack_sync "Fase2-Seasonal-Anime" "fase2-seasonal-anime" \
        "Nexus:43012" "Nexus:16045" "Nexus:14158" "Nexus:32228" "Nexus:5969" \
