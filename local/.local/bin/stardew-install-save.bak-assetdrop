echo -e "${DIM}── Seasonal Cute + Anime Portraits ────────────${RESET}\n"

SEASONAL_CUTE="$WINE_MODS/External-by dizzi~ [CP] Seasonal Cute Characters"
SEASONAL_ANIME="$WINE_MODS/External-by dizzi~ [CP] Seasonal Anime Characters III"

if gum confirm "¿Configurar Seasonal (Cute+Anime) y copiar a Android SMAPI? (Portraits Animes sobre Cute)"; then
    if [ -d "$SEASONAL_CUTE" ] && [ -d "$SEASONAL_ANIME" ]; then
        # Windows/wine: fusionar Portraits del Anime DENTRO del Cute (sobreescribir en orden)
        if cp -r "$SEASONAL_ANIME/assets/Portraits/." "$SEASONAL_CUTE/assets/Portraits/"; then
            echo -e "${GREEN}✅ Windows: Portraits Anime → Cute (sobrescritos)${RESET}\n"
            log "Seasonal Windows: Portraits Anime -> Cute"
        else
            echo -e "${RED}❌ FALLO al fusionar Portraits en Windows${RESET}\n"
            log "FAIL Seasonal Windows: Portraits fusion"
        fi
        # Android SMAPI: push Cute fusionado + push Anime completo, en ese orden
        if adb shell "mkdir -p '$ANDROID_MODS'" \
           && adb push -a "$SEASONAL_CUTE/" "$ANDROID_MODS/External-by dizzi~ [CP] Seasonal Cute Characters/" \
           && adb push -a "$SEASONAL_ANIME/" "$ANDROID_MODS/External-by dizzi~ [CP] Seasonal Anime Characters III/"; then
            echo -e "${GREEN}✅ Seasonal → Android SMAPI (Cute antes, Anime despues)${RESET}\n"
            log "OK Seasonal Android <- Cute+Anime"
        else
            echo -e "${RED}❌ FALLO al copiar Seasonal → Android SMAPI${RESET}\n"
            log "FAIL Seasonal Android <- Cute+Anime"
        fi
    else
        echo -e "${RED}❌ No se encontraron los mods Seasonal en PC${RESET}\n"
    fi
fi

# ── Modpacks (Fase 3: Packs de Portraits, UNO A LA VEZ) ────────
echo -e "${DIM}── Modpacks (Fase 3: Portraits) ────────────────${RESET}\n"
echo -e "${YELLOW}⚠️  Los packs de Portraits se pisan entre si. Instala UNO a la vez.${RESET}\n"

pack_group() {
  # Fase 3: activa UN pack a la vez. Al activar un pack, desactiva el anterior
  # (borra sus carpetas de Mods y Android) antes de copiar el nuevo.
  # $1 = display, $2 = staging subcarpeta, $3+ = triplas "Nexus:id|nombre|url"
  local name="$1" sub="$2"; shift 2
  [ -d "$MODPACK_STAGING/$sub" ] || return 0
  modpack_report "$name" "$sub" "$@"
  if gum confirm "¿ACTIVAR $name (aisla el resto de packs de Portraits) y sincronizar?"; then
    # 1) desactivar pack de Fase 3 activo anterior (si hay otro)
    local prev=""
    [ -f "$MODPACK_STAGING/.fase3-activo" ] && prev="$(cat "$MODPACK_STAGING/.fase3-activo")"
    if [ -n "$prev" ] && [ "$prev" != "$sub" ] && [ -d "$MODPACK_STAGING/$prev" ]; then
      echo -e "${YELLOW}⏏️  Desactivando pack previo: $prev${RESET}"
      for item in "$MODPACK_STAGING/$prev"/*; do
        [ -e "$item" ] || continue
        local b; b="$(basename "$item")"
        chmod -Rf u+rwx "$WINE_MODS/$b" 2>/dev/null
        rm -rf "$WINE_MODS/$b"
        adb shell "rm -rf '$ANDROID_MODS/$b'" 2>/dev/null
      done
    fi
    # 2) instalar el pack elegido (wine + android)
    local keys=()
    while [ $# -gt 0 ]; do
      keys+=("$1"); shift 3
    done
    modpack_sync "$name" "$sub" "${keys[@]}"
    modpack_push_phone "$name" "$sub"
    # 3) marcar activo
    echo "$sub" > "$MODPACK_STAGING/.fase3-activo"
    log "ACTIVO packs portraits: $sub"
  fi
  echo ""
}

