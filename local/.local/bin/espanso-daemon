#!/bin/sh
# Wrapper para espanso en systemd: inicia el daemon y se queda en foreground
# para que systemd no lo reinicie en bucle.
export XDG_SESSION_TYPE=x11
/home/diego/.local/bin/espanso service start --unmanaged
# Mantener el proceso vivo para que systemd no lo considere terminado
while true; do
  sleep 3600
done
