#!/usr/bin/env bash
# //Steam Sync Shortcut
# Sincroniza SIEMPRE la última versión de Steam de shortcuts.vdf al repo.
# Dirección: Steam es la fuente de verdad → dotfiles es el espejo versionado.
# NO recrea symlinks: Steam reescribe el archivo con rename y deja un archivo
# real; este script lo copia al repo cuando cambia (vivo, o .backup si no hay
# vivo). Si el vivo no existe, lo siembra desde el repo la primera vez.
# Corrido por un systemd user timer (features/services.nix).

set -euo pipefail

CFG="$HOME/.local/share/Steam/userdata/1187856367/config"
LIVE="$CFG/shortcuts.vdf"
BACKUP="$CFG/shortcuts.vdf.backup"
REPO="$HOME/dotfiles-dizzi/local/.local/share/Steam/userdata/1187856367/config/shortcuts.vdf"

# 1) Sembrar el vivo desde el repo si falta (primer arranque / HM lo deslinkeó)
if [ ! -e "$LIVE" ] && [ -f "$REPO" ]; then
  mkdir -p "$CFG"
  cp "$REPO" "$LIVE"
  echo "Seeded shortcuts.vdf from repo -> $LIVE"
fi

# 2) Fuente de la última versión: el vivo real de Steam; si no hay, .backup.
SRC=""
if [ -f "$LIVE" ] && [ ! -L "$LIVE" ]; then
  SRC="$LIVE"
elif [ -f "$BACKUP" ]; then
  SRC="$BACKUP"
fi

[ -z "$SRC" ] && { echo "No hay shortcuts.vdf de Steam (ni vivo ni backup). Nada que sincronizar."; exit 0; }

# 3) Copiar al repo solo si cambió (nunca tocar el archivo de Steam)
if ! cmp -s "$SRC" "$REPO"; then
  cp "$SRC" "$REPO"
  echo "OK: shortcuts.vdf sincronizado de Steam -> repo ($(basename "$SRC"))"
else
  echo "OK: shortcuts.vdf al día (repo == $SRC)"
fi