#!/usr/bin/env bash
# nixconf-rebuild: Rebuild NixOS config + home-manager
set -euo pipefail

DOTFILES="/home/diego/dotfiles-dizzi/nixconf"
USER="diego"

echo "=== NixOS Rebuild ==="
echo "Equivalente a:"
echo "  cd ~/dotfiles-dizzi/nixconf && sudo nix flake update"
echo "  sudo nixos-rebuild switch --flake ~/dotfiles-dizzi/nixconf#thinkpad-x1e2"
echo "  home-manager switch -b backup --flake ~/dotfiles-dizzi/nixconf#diego@thinkpad-x1e2"
echo ""

cd "$DOTFILES"

# Fix git ownership
git config --global --add safe.directory "$DOTFILES" 2>/dev/null || true

# Flake update as user
echo "→ Actualizando flake..."
sudo -u "$USER" git -C "$DOTFILES" fetch --all
sudo -u "$USER" nix flake update "$DOTFILES"

# System rebuild as root
echo "→ Rebuilding system..."
sudo nixos-rebuild switch --flake .#thinkpad-x1e2

# Home-manager as user
echo "→ Switching home-manager..."
home-manager switch -b backup --flake .#diego@thinkpad-x1e2

echo "✅ Rebuild completado"