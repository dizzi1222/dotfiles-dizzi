#!/usr/bin/env bash
# nixconf-rebuild: rebuild NixOS + home-manager (NO actualiza inputs).
# Para actualizar inputs usar el alias `nixup` antes de este script.
set -euo pipefail

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RST=$'\033[0m' C_DIM=$'\033[2m' C_B=$'\033[1m' C_RED=$'\033[31m'
  C_GRN=$'\033[32m' C_YEL=$'\033[33m' C_CYN=$'\033[36m'
else
  C_RST="" C_DIM="" C_B="" C_RED="" C_GRN="" C_YEL="" C_CYN=""
fi

rule() { printf '%s%s%s\n' "$C_DIM" "$(printf '─%.0s' $(seq 1 "${1:-66}"))" "$C_RST"; }

REPO="/home/diego/dotfiles-dizzi"
FLAKE="$REPO/nixconf"
TARGET_USER="diego"
HOST="thinkpad-x1e2"

MIN_FREE_GB="${MIN_FREE_GB:-10}"
MIN_RAM_GB="${MIN_RAM_GB:-8}"
NIXRB_TMP="${NIXRB_TMP:-auto}"
RAM_DIR="/dev/shm/nixrb-build"
HM_REF="${HM_REF:-github:nix-community/home-manager}"

# home-manager debe correr como el usuario dueño del perfil; como root
# instalaría en el perfil de root y dejaría el tuyo desincronizado.
if [ "$(id -u)" -eq 0 ] || [ "$(id -un)" != "$TARGET_USER" ]; then
  echo "Ejecutá este script como '$TARGET_USER' (no root)." >&2
  exit 1
fi

echo "=== NixOS + Home Manager Rebuild ==="
echo "  sudo ${SYS_ENV[*]:-} nixos-rebuild switch --flake $FLAKE#$HOST ${NIX_OPTS[*]:-} $*"
echo ""
detect_hm
echo "  ${HM_CMD[*]} switch -b backup --flake $FLAKE#$TARGET_USER@$HOST ${NIX_OPTS[*]:-} $*"
if [ "$HM_EXISTS" -eq 0 ]; then
  echo "  (home-manager no está en el PATH: se arranca con nix run $HM_REF)"
fi

echo
rule
echo "${C_B}Referencia${C_RST} ${C_DIM}(copiar/pegar si hace falta)${C_RST}"

echo
echo "${C_B}▸ Forzar RAM manualmente${C_RST}"
echo "   ${C_DIM}TMPDIR=/dev/shm nix run --option max-jobs 1${C_RST}"
echo "   ${C_DIM}  github:nix-community/home-manager --${C_RST}"
echo "   ${C_DIM}  switch --flake .#${TARGET_USER}@${HOST}${C_RST}"

echo
echo "${C_B}▸ Sistema activo sin espacio${C_RST} ${C_DIM}(store /mnt/nix corrupto)${C_RST}"
echo "   ${C_DIM}ls -ld /mnt/nix${C_RST}"

echo
echo "${C_YEL}▸ Último recurso${C_RST} ${C_DIM}— borra el store fantasma.${C_RST}"
echo "   ${C_RED}La base de datos vive en /nix/var/nix/db/${C_RST}"
echo "   ${C_RED}sudo rm -rf /mnt/nix${C_RST}"
echo "   ${C_RED}df -h /${C_RST}"
echo "   ${C_DIM}Libera 12-30GB de una store vieja. Solo si todo lo demás falló.${C_RST}"
echo

# safe.directory debe ser el TOPLEVEL del repo (dotfiles-dizzi), no nixconf.
# --replace-all evita acumular duplicados en cada corrida.
git config --global --replace-all safe.directory "$REPO"

echo "${C_GRN}▸${C_RST} Reconstruyendo el sistema..."
echo
sudo env "${SYS_ENV[@]}" nixos-rebuild switch --flake "$FLAKE#$HOST" "${NIX_OPTS[@]}" "$@"

echo "→ Switching home-manager..."
home-manager switch -b backup --flake "$FLAKE#$TARGET_USER@$HOST"

echo "✅ Rebuild completado"
