#!/usr/bin/env bash
# nixconf-rebuild: rebuild NixOS + home-manager (NO actualiza inputs).
# Para actualizar inputs usar el alias `nixup` antes de este script.
#
# Uso: ./nixrb.sh [args extra para nix, p.ej. --option max-jobs 1]
#
#   NIXRB_TMP=auto|ram|disk|/ruta   dónde van los directorios temporales de build
#     auto (default): normal; pasa a RAM solo si hay poco disco Y bastante RAM libre
#     ram   : /dev/shm/nixrb-build (RAM; cuidado con builds grandes)
#     disk  : no cambia nada
#     /ruta : directorio propio (ideal: otro disco con espacio)
#   MIN_FREE_GB=10   umbral de disco libre en /
#   MIN_RAM_GB=8     RAM disponible mínima para permitir el modo ram
#                    (con ~10G de MemAvailable reales, 10G truncaba a 9 → no
#                    activaba /dev/shm; 8G lo activa. La RAM justa ya no pide
#                    confirmación: avisa y sigue en disco).
#   HM_REF=github:nix-community/home-manager   se usa con `nix run` si falta el
#                    binario home-manager en el PATH (primera vez / perfil roto)
set -euo pipefail

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RST=$'\033[0m' C_DIM=$'\033[2m' C_B=$'\033[1m' C_RED=$'\033[31m'
  C_GRN=$'\033[32m' C_YEL=$'\033[33m' C_CYN=$'\033[36m'
else
  C_RST="" C_DIM="" C_B="" C_RED="" C_GRN="" C_YEL="" C_CYN=""
fi

rule() { printf '%s%s%s\n' "$C_DIM" "$(printf '─%.0s' $(seq 1 "${1:-66}"))" "$C_RST"; }

REPO="/home/diego/dotfiles-dizzi"
FLAKE="$REPO/nixconf"
TARGET_USER="diego"
HOST="thinkpad-x1e2"

MIN_FREE_GB="${MIN_FREE_GB:-10}"
MIN_RAM_GB="${MIN_RAM_GB:-8}"
NIXRB_TMP="${NIXRB_TMP:-auto}"
RAM_DIR="/dev/shm/nixrb-build"
HM_REF="${HM_REF:-github:nix-community/home-manager}"

# home-manager debe correr como el usuario dueño del perfil; como root
# instalaría en el perfil de root y dejaría el tuyo desincronizado.
if [ "$(id -u)" -eq 0 ] || [ "$(id -un)" != "$TARGET_USER" ]; then
  echo "Ejecutá este script como '$TARGET_USER' (no root)." >&2
  exit 1
fi

# ── ¿Existe home-manager? ────────────────────────────────────────
# HM_EXISTS=1 -> binario en PATH. HM_EXISTS=0 -> se arranca con `nix run $HM_REF`
# (pasa la primera vez o si el perfil de home-manager se rompió).
# Con --flake el CLI solo llama a tu activationPackage, así que la versión del
# CLI de HM_REF no cambia qué módulos se aplican (eso lo fija tu flake.lock).
detect_hm() {
  if command -v home-manager >/dev/null 2>&1; then
    HM_EXISTS=1
    HM_CMD=(home-manager)
  else
    HM_EXISTS=0
    HM_CMD=(nix run "$HM_REF" --)
  fi
}

# ── Lógica de TMP ────────────────────────────────────────────────
free_gb=$(df -BG --output=avail / | sed -n '2p' | tr -dc '0-9')
ram_gb=$(awk '/MemAvailable/ {printf "%d", $2/1048576}' /proc/meminfo)
free_gb="${free_gb:-0}"
ram_gb="${ram_gb:-0}"

BUILD_TMP=""
case "$NIXRB_TMP" in
disk) ;;
ram) BUILD_TMP="$RAM_DIR" ;;
auto)
  if [ "$free_gb" -lt "$MIN_FREE_GB" ]; then
    if [ "$ram_gb" -ge "$MIN_RAM_GB" ]; then
      echo "${C_YEL}⚠  Poco espacio en /: ${free_gb}G libres${C_RST}"
      echo "${C_DIM}   Hay ${ram_gb}G de RAM → los builds irán a /dev/shm${C_RST}"
      BUILD_TMP="$RAM_DIR"
    else
      echo "${C_DIM}   RAM justa (${ram_gb}G) → builds van al disco igual (sin RAM).${C_RST}"
    fi
  fi
  ;;
/*) BUILD_TMP="$NIXRB_TMP" ;;
*)
  echo "NIXRB_TMP inválido: '$NIXRB_TMP' (auto|ram|disk|/ruta)" >&2
  exit 1
  ;;
esac

if [ "$BUILD_TMP" = "$RAM_DIR" ] && [ "$ram_gb" -lt "$MIN_RAM_GB" ]; then
  echo "✗ Modo ram pedido pero solo hay ${ram_gb}G de RAM disponible (mínimo ${MIN_RAM_GB}G)." >&2
  echo "  Fuerza con MIN_RAM_GB=0 si sabes lo que haces." >&2
  exit 1
fi

SYS_ENV=()
NIX_OPTS=()
if [ -n "$BUILD_TMP" ]; then
  # build-dir NO puede ser world-writable (ni /dev/shm a secas): subdirectorio
  # propio de root con 0755. NO se usa sandbox-build-dir: ese es el path
  # virtual DENTRO del sandbox (/build) y cambiarlo rompe el build.
  sudo install -d -m 0755 -o root -g root "$BUILD_TMP"
  SYS_ENV=(TMPDIR="$BUILD_TMP")
  NIX_OPTS=(--option build-dir "$BUILD_TMP")
  echo ""
  echo "${C_CYN}→${C_RST} Temporales de build: ${C_B}${BUILD_TMP}${C_RST}"
fi

# Limpia el dir en RAM al terminar (solo ese path fijo, nunca uno del usuario)
cleanup_ram() { sudo rm -rf /dev/shm/nixrb-build 2>/dev/null || true; }
[ "$BUILD_TMP" = "$RAM_DIR" ] && trap cleanup_ram EXIT

echo ""
echo "=== NixOS + Home Manager Rebuild ==="
echo "  sudo ${SYS_ENV[*]:-} nixos-rebuild switch --flake $FLAKE#$HOST ${NIX_OPTS[*]:-} $*"
echo ""
detect_hm
echo "  ${HM_CMD[*]} switch -b backup --flake $FLAKE#$TARGET_USER@$HOST ${NIX_OPTS[*]:-} $*"
if [ "$HM_EXISTS" -eq 0 ]; then
  echo "  (home-manager no está en el PATH: se arranca con nix run $HM_REF)"
fi

echo
rule
echo "${C_B}Referencia${C_RST} ${C_DIM}(copiar/pegar si hace falta)${C_RST}"

echo
echo "${C_B}▸ Forzar RAM manualmente${C_RST}"
echo "   ${C_DIM}TMPDIR=/dev/shm nix run --option max-jobs 1${C_RST}"
echo "   ${C_DIM}  github:nix-community/home-manager --${C_RST}"
echo "   ${C_DIM}  switch --flake .#${TARGET_USER}@${HOST}${C_RST}"

echo
echo "${C_B}▸ Sistema activo sin espacio${C_RST} ${C_DIM}(store /mnt/nix corrupto)${C_RST}"
echo "   ${C_DIM}ls -ld /mnt/nix${C_RST}"

echo
echo "${C_YEL}▸ Último recurso${C_RST} ${C_DIM}— borra el store fantasma.${C_RST}"
echo "   ${C_RED}La base de datos vive en /nix/var/nix/db/${C_RST}"
echo "   ${C_RED}sudo rm -rf /mnt/nix${C_RST}"
echo "   ${C_RED}df -h /${C_RST}"
echo "   ${C_DIM}Libera 12-30GB de una store vieja. Solo si todo lo demás falló.${C_RST}"
echo

# safe.directory debe ser el TOPLEVEL del repo (dotfiles-dizzi), no nixconf.
# --replace-all evita acumular duplicados en cada corrida.
git config --global --replace-all safe.directory "$REPO"

echo "${C_GRN}▸${C_RST} Reconstruyendo el sistema..."
echo
sudo env "${SYS_ENV[@]}" nixos-rebuild switch --flake "$FLAKE#$HOST" "${NIX_OPTS[@]}" "$@"

echo "→ Switching home-manager..."
detect_hm # re-chequea: el rebuild del sistema pudo haberlo instalado
if [ "$HM_EXISTS" -eq 0 ]; then
  echo "  home-manager no encontrado -> bootstrap con nix run $HM_REF"
fi
"${HM_CMD[@]}" switch -b backup --flake "$FLAKE#$TARGET_USER@$HOST" "${NIX_OPTS[@]}" "$@"

echo "✅ Rebuild completado"
