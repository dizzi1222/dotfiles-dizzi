#!/usr/bin/env python3
import sys
import os
import time
import signal
import json

PIDFILE = "/tmp/autoclicker-wayland.pid"

def get_input_device():
    for dev in os.listdir("/dev/input"):
        path = f"/dev/input/{dev}"
        if dev.startswith("event") and os.access(path, os.W_OK):
            try:
                with open(f"/sys/class/input/{dev}/device/name") as f:
                    name = f.read().strip().lower()
                if "mouse" in name or "touchpad" in name:
                    return path
            except: pass
    return "/dev/input/event0"

def click_loop(interval_ms):
    evdev = __import__("evdev")
    from evdev import UInput, ecodes as e

    ui = UInput({"EV_KEY": [e.BTN_LEFT], "EV_REL": [e.REL_X, e.REL_Y]},
                name="autoclicker-wayland", bustype=0x03)
    pid = os.getpid()
    with open(PIDFILE, "w") as f:
        f.write(str(pid))

    def cleanup(s, f):
        try:
            ui.close()
            os.unlink(PIDFILE)
        except: pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)

    while True:
        ui.write(e.EV_KEY, e.BTN_LEFT, 1)
        ui.write(e.EV_SYN, 0, 0)
        ui.write(e.EV_KEY, e.BTN_LEFT, 0)
        ui.write(e.EV_SYN, 0, 0)
        time.sleep(interval_ms / 1000)

def stop():
    if os.path.exists(PIDFILE):
        with open(PIDFILE) as f:
            pid = int(f.read().strip())
        os.kill(pid, signal.SIGTERM)
        time.sleep(0.2)
        try: os.unlink(PIDFILE)
        except: pass
        print("✅ AutoClicker detenido")
    else:
        print("⚠️  AutoClicker no está corriendo")

def status():
    if os.path.exists(PIDFILE):
        with open(PIDFILE) as f:
            pid = f.read().strip()
        try:
            os.kill(int(pid), 0)
            print(f"✅ AutoClicker corriendo (PID: {pid})")
        except:
            print("⚠️  AutoClicker detenido (PID zombie)")
            os.unlink(PIDFILE)
    else:
        print("⚠️  AutoClicker detenido")

def menu():
    import shutil
    gum = shutil.which("gum")
    if not gum:
        print("❌ gum no instalado")
        sys.exit(1)

    status()
    print()
    choices = ["🚀 Iniciar", "⏹️  Detener", "❌ Salir"]
    choice = os.popen(f'{gum} choose "{choices[0]}" "{choices[1]}" "{choices[2]}"').read().strip()

    if "Iniciar" in choice:
        speeds = {"⚡ Turbo (1ms)": 1, "🚀 Rápido (20ms)": 20,
                  "⏩ Moderado (50ms)": 50, "▶️ Normal (100ms)": 100,
                  "🐌 Lento (200ms)": 200}
        speed = os.popen(f'{gum} choose {" ".join(f'"{k}"' for k in speeds)}').read().strip()
        interval = speeds.get(speed, 100)
        click_loop(interval)
    elif "Detener" in choice:
        stop()

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "menu"
    {"start": lambda: click_loop(int(sys.argv[2]) if len(sys.argv) > 2 else 100),
     "stop": stop, "status": status, "menu": menu}[cmd]()
