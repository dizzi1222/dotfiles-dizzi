#!/usr/bin/env bash
# display-setup — Toggle Mirror ↔ Extend (multi-WM)
# Soporta: Hyprland, Niri, X11 (xrandr), wlroots (wlr-randr)
# Uso: display-setup           → alterna automáticamente
#      display-setup extend    → fuerza modo paralelo
#      display-setup mirror    → fuerza modo espejo

INTERNAL="eDP-1"
EXTERNAL="HDMI-A-1"
STATE_FILE="/tmp/display-setup-mode"

# ── Detección de WM/Compositor ─────────────────────────────────────────────
detect_wm() {
  if [[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]]; then
    echo "hyprland"
  elif [[ -n "$NIRI_SOCKET" ]]; then
    echo "niri"
  elif command -v wlr-randr &>/dev/null && [[ -n "$WAYLAND_DISPLAY" ]]; then
    echo "wlr"
  elif [[ -n "$DISPLAY" ]] && command -v xrandr &>/dev/null; then
    echo "x11"
  else
    echo "unknown"
  fi
}

# ── Estado actual → próximo modo (toggle) ──────────────────────────────────
next_mode() {
  local current
  current=$(cat "$STATE_FILE" 2>/dev/null || echo "extend")
  [[ "$current" == "extend" ]] && echo "mirror" || echo "extend"
}

WM="$(detect_wm)"
MODE="${1:-$(next_mode)}"

# ── Hyprland ───────────────────────────────────────────────────────────────
apply_hyprland() {
  case "$MODE" in
    extend)
      # Restaurar config original: HDMI portrait (transform 1) izq, eDP-1 derecha
      hyprctl keyword monitor "$EXTERNAL,1920x1080@60,0x0,1,transform,1"
      hyprctl keyword monitor "$INTERNAL,1920x1080@60,1080x0,1"
      ;;
    mirror)
      hyprctl keyword monitor "$INTERNAL,1920x1080@60,0x0,1"
      hyprctl keyword monitor "$EXTERNAL,1920x1080@60,0x0,1,mirror,$INTERNAL"
      ;;
  esac
}

# ── Niri ───────────────────────────────────────────────────────────────────
apply_niri() {
  case "$MODE" in
    extend)
      niri msg output "$INTERNAL" on
      niri msg output "$EXTERNAL" on
      niri msg output "$INTERNAL" position 0 0
      niri msg output "$EXTERNAL" position 1920 0
      ;;
    mirror)
      niri msg output "$INTERNAL" on
      niri msg output "$EXTERNAL" mirror "$INTERNAL"
      ;;
  esac
}

# ── wlr-randr (genérico wlroots) ───────────────────────────────────────────
apply_wlr() {
  case "$MODE" in
    extend)
      wlr-randr \
        --output "$INTERNAL" --on --mode 1920x1080 --pos 0,0 --transform normal \
        --output "$EXTERNAL" --on --mode 1920x1080 --pos 1920,0 --transform normal
      ;;
    mirror)
      wlr-randr \
        --output "$INTERNAL" --on --mode 1920x1080 --pos 0,0 --transform normal \
        --output "$EXTERNAL" --on --mode 1920x1080 --pos 0,0 --transform normal
      ;;
  esac
}

# ── X11 / xrandr ───────────────────────────────────────────────────────────
apply_x11() {
  case "$MODE" in
    extend)
      xrandr \
        --output "$INTERNAL" --mode 1920x1080 --pos 0x0 --rotate normal \
        --output "$EXTERNAL" --mode 1920x1080 --pos 1920x0 --rotate normal
      ;;
    mirror)
      xrandr \
        --output "$INTERNAL" --mode 1920x1080 --pos 0x0 --rotate normal \
        --output "$EXTERNAL" --same-as "$INTERNAL" --mode 1920x1080 --rotate normal
      ;;
  esac
}

# ── Dispatch ───────────────────────────────────────────────────────────────
case "$WM" in
  hyprland) apply_hyprland ;;
  niri)     apply_niri     ;;
  wlr)      apply_wlr      ;;
  x11)      apply_x11      ;;
  *)
    notify-send -u critical "display-setup" "Compositor no soportado: $WM" 2>/dev/null
    exit 1
    ;;
esac

echo "$MODE" > "$STATE_FILE"

ICON="🖥️"
[[ "$MODE" == "mirror" ]] && LABEL="Mirror (espejo)" || LABEL="Normal (HDMI portrait + eDP-1)"
notify-send "Display Setup" "$ICON $LABEL" 2>/dev/null