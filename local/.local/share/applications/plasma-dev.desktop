[Desktop Entry]
Version=1.0
Name=KDE Plasma (Dev Nested)
Comment=Lanza KWin/Plasma anidado en la sesión Wayland actual con logs en kitty
Exec=kitty --hold --title "Plasma [nested]" -e bash -c "dbus-run-session kwin_wayland --xwayland --width 1280 --height 720 2>&1 | tee /tmp/plasma-nested.log"
Icon=start-here-kde
Terminal=false
Type=Application
Categories=System;
Actions=Full;Logs;

[Desktop Action Full]
Name=Plasma Completo (dbus-session)
Exec=kitty --hold --title "Plasma Full [nested]" -e bash -c "dbus-run-session startplasma-wayland 2>&1 | tee /tmp/plasma-full.log"

[Desktop Action Logs]
Name=Ver Logs
Exec=kitty --hold -e bash -c "tail -f /tmp/plasma-nested.log"
