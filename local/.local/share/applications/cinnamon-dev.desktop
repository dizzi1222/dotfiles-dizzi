[Desktop Entry]
Version=1.0
Name=Cinnamon (Dev Nested)
Comment=Lanza Cinnamon anidado via Xephyr con logs en kitty
Exec=kitty --hold --title "Cinnamon [nested]" -e bash -c "Xephyr :5 -screen 1280x720 -ac & sleep 1 && DISPLAY=:5 dbus-launch --exit-with-session cinnamon-session 2>&1 | tee /tmp/cinnamon-nested.log"
Icon=cinnamon
Terminal=false
Type=Application
Categories=System;
Actions=WM-Only;Logs;

[Desktop Action WM-Only]
Name=Solo WM (sin sesión completa)
Exec=kitty --hold --title "Cinnamon WM [nested]" -e bash -c "Xephyr :5 -screen 1280x720 -ac & sleep 1 && DISPLAY=:5 cinnamon --replace 2>&1 | tee /tmp/cinnamon-wm.log"

[Desktop Action Logs]
Name=Ver Logs
Exec=kitty --hold -e bash -c "tail -f /tmp/cinnamon-nested.log"
