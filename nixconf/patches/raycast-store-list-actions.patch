+          auto registry = ctx->services->extensionRegistry();
+
+          toast->dynamic(QCoreApplication::translate("RaycastStoreSection", "Downloading extension..."));
+
+          QObject::connect(watcher, &Watcher::finished, [registry, toast, ext, watcher]() {
+            auto result = watcher->result();
+            watcher->deleteLater();
