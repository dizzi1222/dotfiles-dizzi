[Nemo Action]
Name=PeaZip: extraer aquí
Comment=Extraer los archivos seleccionados en su propia carpeta
Icon=archive-insert
Exec=peazip -ext2here %F
Selection=Any
Extensions=zip;7z;rar;rar5;r00;tar;gz;gzip;tgz;bz2;bz;bzip2;tbz;tbz2;xz;txz;zst;zstd;lz;lzma;lzo;lz4;br;cab;arj;lha;lzh;zoo;z;rpm;deb;cpio;iso;img;msi;exe;dmg;war;ear;apk;xapk;tar.gz;tar.bz2;tar.xz;tar.zst;tar.lz4;tar.br;
