[Unit]
Description=n8n workflow automation (node@22 + Hermes Abogados)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=-%h/.n8n/config
ExecStart=%h/.local/bin/n8n start
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=n8n

[Install]
WantedBy=default.target
