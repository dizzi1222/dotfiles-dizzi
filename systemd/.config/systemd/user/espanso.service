[Unit]
Description=espanso text expander (Wayland nativo)
Documentation=https://espanso.org/docs/
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/espanso daemon
ExecStop=%h/.local/bin/espanso cmd kill
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
