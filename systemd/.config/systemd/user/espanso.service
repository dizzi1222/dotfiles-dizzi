[Unit]
Description=espanso text expander (Wayland via distrobox)

[Service]
ExecStart=/usr/bin/distrobox enter espanso-box -- /usr/bin/espanso service start --unmanaged
ExecStop=/usr/bin/distrobox enter espanso-box -- /usr/bin/espanso service stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
