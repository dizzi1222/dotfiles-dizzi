# NVIM GITIGNORE - API KEYS Y ARCHIVOS SENSIBLES
# ═══════════════════════════════════════════════════════════

# API Keys (MUY IMPORTANTE - NO SUBIR)
api-keys.sh
api-keys.ps1
.env
*.key

# Logs y cachés de plugins
lazy-lock.json
plugin/
spell/
.luarc.json

# Archivos de sesión
Session.vim
.netrwhist

# Archivos temporales
*.swp
*.swo
*~
.DS_Store

# Avante history (opcional, puede tener info sensible)
.avante_chat_history

# Copilot chat history
copilot-chat-history/
home/.opencommit

# ═══════════════════════════════════════════════════════════
# WINE - ASSETS GENERADOS AUTOMÁTICAMENTE
# Los .desktop de wine-extension y wine/Programs los genera wine
# al configurar el prefix (rutas absolutas a ~/.wine, no portables).
# mimeinfo.cache es caché regenerable.
# ═══════════════════════════════════════════════════════════
local/.local/share/applications/wine-extension-*.desktop
local/.local/share/applications/wine/
local/.local/share/applications/mimeinfo.cache

# Replit (app .desktop + icono descargados)
# local/.local/share/applications/Replit*
# local/.local/share/icons/Replit*

# ═══════════════════════════════════════════════════════════
# HOME SCRIPTS - lib/ ES codigo versionable (NO ignorar)
# La regla Python "lib/" de arriba matchea en cualquier nivel
# y se traga home/scripts/lib/platform.sh. Re-incluimos:
# ═══════════════════════════════════════════════════════════
!/home/scripts/lib/
!/home/scripts/lib/**

# ═══════════════════════════════════════════════════════════
# STEAM - Carátulas personalizadas (paquete modular steam/)
# Re-permitir SOLO la rama userdata/*/config/grid tras la
# regla "**/.local/share/Steam/" (git no re-incluye archivos
# si un directorio padre está excluido: hay que re-permitir
# cada nivel de la cadena).
# ═══════════════════════════════════════════════════════════
!**/.local/share/Steam/
!**/.local/share/Steam/userdata/
!**/.local/share/Steam/userdata/*/
!**/.local/share/Steam/userdata/*/config/
!**/.local/share/Steam/userdata/*/config/grid/
!**/.local/share/Steam/userdata/*/config/grid/**

# STEAM - Bloquear TODOS los .vdf del config EXCEPTO shortcuts.vdf
# (localconfig/registry/compat son binarios volátiles que Steam reescribe)
**/.local/share/Steam/userdata/*/config/*.vdf
!**/.local/share/Steam/userdata/*/config/shortcuts.vdf
!**/.local/share/Steam/userdata/*/config/shortcuts.vdf

# tmux nosek
/tmux/.config/tmux/plugins/tpm
/tmux/.config/tmux/plugins/tpm
/tmux/.config/tmux/plugins/tpm?

# Cache de shaders de juegos (volátil, cientos de MB)
local/.local/bin/juegos/GLCache/

# opencode password xd
opencode/.config/opencode/service.json

# Hermes: credenciales y estado privado; versionar solo los ajustes y el pack.
/hermes/**/.env*
/hermes/**/auth.json*
/hermes/**/.hermes_history*
/hermes/**/sessions/
# /hermes/**/memories/  # Descomentado: USER.md y MEMORY.md sí se versionan para portabilidad
/hermes/**/*.pre-dotfiles-*
# Para que no joda Termux:
local/.local/bin/lazygit-shell
