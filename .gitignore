# Añadir esto a tu .gitignore actual
# cat >> .gitignore << 'EOF'

home/clawd/.git/

# ═══════════════════════════════════════════════════════════
# CLAUDE CODE - Datos efímeros y sensibles
# ═══════════════════════════════════════════════════════════
home/.claude/.credentials.json
home/.claude/backups/
home/.claude/history.jsonl
home/.claude/ide/
home/.claude/mcp-needs-auth-cache.json
home/.claude/paste-cache/
home/.claude/projects/
home/.claude/sessions/
home/.claude/shell-snapshots/
home/.claude/file-history/
home/.claude/settings.local.json
# Estado efímero del directorio de plugins
home/.claude/plugins/.last_inuse_sweep
home/.claude/plugins/plugin-directory-cache-*.json
# Sunshine: logs, estado y credenciales del equipo (no portables)
sunshine/.config/sunshine/sunshine.log*
sunshine/.config/sunshine/sunshine_state.json
sunshine/.config/sunshine/credentials/
sunshine/.config/sunshine/portal_token
# estado de sincronizacion remota (marcador de tiempo, no configuracion)
home/.claude/remote-settings.json
home/.claude/remote-settings.json.*
# policy-limits: limites de politica firmados (JWS) + identity/stamp del equipo.
# Datos personales del dispositivo, no configuracion portable.
home/.claude/policy-limits.json
home/.claude/policy-limits.json.*
# estado de sincronizacion remota (marcador de tiempo, no configuracion)
home/.claude/remote-settings.json
home/.claude/remote-settings.json.*

# Antigravity - ignorar todo EXCEPTO settings y keybindings
Antigravity/.config/Antigravity/*
!Antigravity/.config/Antigravity/User/
Antigravity/.config/Antigravity/User/*
!Antigravity/.config/Antigravity/User/settings.json
!Antigravity/.config/Antigravity/User/keybindings.json
Antigravity/.config/Antigravity IDE/*
!Antigravity/.config/Antigravity IDE/User/
Antigravity/.config/Antigravity IDE/User/*
!Antigravity/.config/Antigravity IDE/User/settings.json
!Antigravity/.config/Antigravity IDE/User/keybindings.json

# ═══════════════════════════════════════════════════════════
# GEMINI / ANTIGRAVITY CLI - Datos efímeros, runtime y sesiones
# ═══════════════════════════════════════════════════════════
home/.gemini/*
!home/.gemini/GEMINI.md
!home/.gemini/settings.json
home/.gemini/antigravity/
home/.gemini/antigravity-*/
# antigravity-cli: solo se versiona settings.json y keybindings.json
# (tokens, historial, sesiones y cache quedan fuera del repo)
!home/.gemini/antigravity-cli/
home/.gemini/antigravity-cli/*
!home/.gemini/antigravity-cli/settings.json
!home/.gemini/antigravity-cli/keybindings.json
home/.gemini/config/
home/.gemini/history/
home/.gemini/google_accounts.json
home/.gemini/projects.json
home/.gemini/state.json
home/.gemini/trustedFolders.json
home/.gemini/installation_id
*.db-shm
*.db-wal
*.db-journal

# ═══════════════════════════════════════════════════════════
# CREDENCIALES LOCALES - NUNCA al repo
# ═══════════════════════════════════════════════════════════
