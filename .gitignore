# ============================================
# .gitignore para dotfiles
# ============================================

# Archivos comprimidos
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip
*.rar
*.7z

# Runtime y binarios
*.so
*.so.*
*.dll
*.exe
*.AppImage

# Aplicaciones completas
home/musicpresence/
**/musicpresence/

# ═══════════════════════════════════════════════════════════
# LUTRIS - Mantener estructura, ignorar runtime pesado
# ═══════════════════════════════════════════════════════════
**/local/.local/share/lutris/runtime/
**/local/.local/share/lutris/runners/
**/local/.local/share/fonts/**/.uuid
**/local/.local/share/icons/hicolor/.icon-theme.cache

# ═══════════════════════════════════════════════════════════
# FIREFOX - SOLO mantener perfiles con CSS importantes
# ═══════════════════════════════════════════════════════════
# Ignorar TODO de .mozilla EXCEPTO 2 perfiles específicos
firefox/.mozilla/**

# Permitir SOLO estos 2 perfiles (con CSS importantes)
!firefox/.mozilla/firefox/1lz1qhvp.default-release/
!firefox/.mozilla/firefox/1lz1qhvp.default-release/**
!firefox/.mozilla/firefox/tes3ta6p.default-release/
!firefox/.mozilla/firefox/tes3ta6p.default-release/**

# Dentro de esos perfiles, ignorar caches y temporales
firefox/.mozilla/firefox/*/cache*/
firefox/.mozilla/firefox/*/Cache*/
firefox/.mozilla/firefox/*/storage/
firefox/.mozilla/firefox/*/startupCache/
firefox/.mozilla/firefox/*/thumbnails/
firefox/.mozilla/firefox/*/*.sqlite*
firefox/.mozilla/firefox/*/*.json-*
firefox/.mozilla/firefox/*/sessionstore*
firefox/.mozilla/firefox/*/crashes/

# ═══════════════════════════════════════════════════════════
# NAVEGADORES - SECRETOS Y DATOS SENSIBLES
# ═══════════════════════════════════════════════════════════
**/chrome/
**/chromium/
**/.config/google-chrome/
**/.config/BraveSoftware/

# ═══════════════════════════════════════════════════════════
# EXTENSIONES DE EDITORES (muy pesadas)
# ═══════════════════════════════════════════════════════════
**/.cursor/extensions/
**/.vscode/extensions/
**/cursor/.cursor/extensions/
**/vscode/.vscode/extensions/

# Estado local de Cursor/VSCode (binarios efímeros de sesión)
**/cursor/.config/Cursor/User/globalStorage/
**/cursor/.config/Cursor/User/workspaceStorage/

# Cursor: conservar solo la configuración de usuario; ignorar cachés,
# sesiones, historial y datos locales en cursor/.config/Cursor/.
/cursor/.config/Cursor/*
!/cursor/.config/Cursor/User/
/cursor/.config/Cursor/User/*
!/cursor/.config/Cursor/User/settings.json
!/cursor/.config/Cursor/User/keybindings.json

# ═══════════════════════════════════════════════════════════
# CACHES Y TEMPORALES
# ═══════════════════════════════════════════════════════════
**/.cache/
**/cache/
**/__pycache__/
*.pyc
*.tmp
*.bak
*.swp
*.swo
*~
.DS_Store

# ═══════════════════════════════════════════════════════════
# DATOS DE APPS (pesados)
# ═══════════════════════════════════════════════════════════
**/.local/share/Steam/
**/.wine/
**/.steam/

